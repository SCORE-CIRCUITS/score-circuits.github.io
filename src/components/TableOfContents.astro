---
// TableOfContents.astro
// Sticky Table of Contents (TOC) with ScrollSpy, Reading Progress Bar & Back to Top
---

<!-- Reading Progress Bar (Pinned at top) -->
<div id="score-reading-progress" class="score-reading-bar" aria-hidden="true"></div>

<!-- Floating Action Controls (Bottom Right) -->
<aside class="score-floating-hub" aria-label="Page Navigation and Table of Contents">
  <!-- TOC Slide-out Panel / Drawer -->
  <div id="score-toc-panel" class="score-toc-panel" aria-hidden="true" role="dialog" aria-label="Table of Contents">
    <div class="score-toc-header">
      <div class="score-toc-header-title">
        <span class="toc-icon">&#128221;</span>
        <span class="toc-title-text">TABLE OF CONTENTS</span>
      </div>
      <div class="score-toc-header-actions">
        <button id="score-toc-pin" class="score-toc-icon-btn" title="Pin / Unpin TOC panel" aria-label="Pin Table of Contents">
          <span class="pin-icon">&#128204;</span>
        </button>
        <button id="score-toc-close" class="score-toc-icon-btn" title="Close TOC panel" aria-label="Close Table of Contents">
          &times;
        </button>
      </div>
    </div>

    <!-- Mini Progress inside TOC -->
    <div class="score-toc-meter">
      <div class="score-toc-meter-track">
        <div id="score-toc-meter-fill" class="score-toc-meter-fill"></div>
      </div>
      <div class="score-toc-meter-label">
        <span>Document Progress</span>
        <strong id="score-toc-percent">0%</strong>
      </div>
    </div>

    <!-- Scrollable Section Links -->
    <nav class="score-toc-nav" aria-label="Table of contents links">
      <ul id="score-toc-list" class="score-toc-list">
        <!-- Dynamically populated by client-side script -->
      </ul>
    </nav>

    <!-- TOC Footer -->
    <div class="score-toc-footer">
      <div class="toc-shortcuts">
        <kbd>T</kbd> Toggle &middot; <kbd>Esc</kbd> Close
      </div>
      <button id="score-toc-jump-top" class="toc-jump-top-btn">
        &uarr; Top
      </button>
    </div>
  </div>

  <!-- Floating Buttons Stack -->
  <div class="score-floating-btns">
    <!-- TOC Trigger Button (Shows Active Section Pill) -->
    <button
      id="score-toc-trigger"
      class="score-toc-trigger-btn"
      aria-expanded="false"
      aria-controls="score-toc-panel"
      title="Toggle Table of Contents (Keyboard: T)"
    >
      <span class="toc-trigger-icon">&#128221;</span>
      <span class="toc-trigger-text" id="score-toc-active-label">Contents</span>
      <span class="toc-trigger-badge" id="score-toc-active-pct">0%</span>
      <span class="toc-trigger-arrow" id="score-toc-trigger-arrow">&blacktriangledown;</span>
    </button>

    <!-- Back to Top Button -->
    <button
      id="score-back-to-top"
      class="score-back-to-top-btn"
      aria-label="Back to top of page"
      title="Back to top"
    >
      <svg viewBox="0 0 24 24" class="btt-icon" fill="currentColor">
        <path d="M7.41 15.41L12 10.83l4.59 4.58L18 14l-6-6-6 6z"/>
      </svg>
      <span class="btt-text">TOP</span>
    </button>
  </div>
</aside>

<style>
  /* ══════════════════════════════════════════════════════════ */
  /* READING PROGRESS BAR                                      */
  /* ══════════════════════════════════════════════════════════ */
  .score-reading-bar {
    position: fixed;
    top: 0;
    left: 0;
    height: 3.5px;
    width: 0%;
    background: var(--yellow, #ffc83e);
    border-bottom: 1.5px solid var(--ink, #151b20);
    z-index: 9999;
    pointer-events: none;
    transition: width 0.08s ease-out;
  }

  /* Target element offset for sticky header */
  :global(section[id]) {
    scroll-margin-top: 5.5rem;
  }
  :global(.dossier-card[id]),
  :global(article[id^="core-"]) {
    scroll-margin-top: 5.5rem;
  }

  /* ══════════════════════════════════════════════════════════ */
  /* FLOATING HUB (BOTTOM-RIGHT)                                */
  /* ══════════════════════════════════════════════════════════ */
  .score-floating-hub {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 1050;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.65rem;
    pointer-events: none;
  }

  .score-floating-btns {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    pointer-events: auto;
  }

  /* ══════════════════════════════════════════════════════════ */
  /* BACK TO TOP BUTTON                                         */
  /* ══════════════════════════════════════════════════════════ */
  .score-back-to-top-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: var(--cream, #fffaf0);
    color: var(--ink, #151b20);
    border: 2px solid var(--ink, #151b20);
    border-radius: 999px;
    padding: 0.42rem 0.85rem;
    font-size: 0.82rem;
    font-weight: 800;
    font-family: var(--md-code-font, 'JetBrains Mono', monospace);
    cursor: pointer;
    box-shadow: 2.5px 2.5px 0px var(--ink, #151b20);
    opacity: 0;
    transform: translateY(12px) scale(0.95);
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease, background-color 0.15s ease, box-shadow 0.15s ease;
    user-select: none;
  }

  .score-back-to-top-btn.visible {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  .score-back-to-top-btn:hover {
    background: var(--yellow, #ffc83e);
    transform: translate(-1px, -1px);
    box-shadow: 3.5px 3.5px 0px var(--ink, #151b20);
  }

  .score-back-to-top-btn:active {
    transform: translate(1px, 1px);
    box-shadow: 1.5px 1.5px 0px var(--ink, #151b20);
  }

  .btt-icon {
    width: 17px;
    height: 17px;
  }

  .btt-text {
    letter-spacing: 0.05em;
  }

  /* ══════════════════════════════════════════════════════════ */
  /* TOC TRIGGER PILL                                           */
  /* ══════════════════════════════════════════════════════════ */
  .score-toc-trigger-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: var(--yellow, #ffc83e);
    color: var(--ink, #151b20);
    border: 2px solid var(--ink, #151b20);
    border-radius: 999px;
    padding: 0.42rem 0.9rem;
    font-size: 0.82rem;
    font-weight: 800;
    font-family: var(--md-text-font, 'Inter', sans-serif);
    cursor: pointer;
    box-shadow: 2.5px 2.5px 0px var(--ink, #151b20);
    transition: transform 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease;
    user-select: none;
    max-width: 290px;
  }

  .score-toc-trigger-btn:hover {
    background: #ffe066;
    transform: translate(-1px, -1px);
    box-shadow: 3.5px 3.5px 0px var(--ink, #151b20);
  }

  .score-toc-trigger-btn:active,
  .score-toc-trigger-btn[aria-expanded="true"] {
    transform: translate(1px, 1px);
    box-shadow: 1.5px 1.5px 0px var(--ink, #151b20);
  }

  .toc-trigger-icon {
    font-size: 0.95rem;
    line-height: 1;
  }

  .toc-trigger-text {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 145px;
    font-weight: 800;
  }

  .toc-trigger-badge {
    background: var(--cream, #fffaf0);
    color: var(--ink, #151b20);
    border: 1.5px solid var(--ink, #151b20);
    border-radius: 999px;
    padding: 0.05rem 0.4rem;
    font-size: 0.72rem;
    font-weight: 800;
    font-family: var(--md-code-font, 'JetBrains Mono', monospace);
    line-height: 1.2;
  }

  .toc-trigger-arrow {
    font-size: 0.65rem;
    transition: transform 0.2s ease;
  }

  .score-toc-trigger-btn[aria-expanded="true"] .toc-trigger-arrow {
    transform: rotate(180deg);
  }

  /* ══════════════════════════════════════════════════════════ */
  /* TOC PANEL DRAWER                                           */
  /* ══════════════════════════════════════════════════════════ */
  .score-toc-panel {
    width: 350px;
    max-width: calc(100vw - 2.5rem);
    max-height: min(560px, 78vh);
    background: var(--cream, #fffaf0);
    border: 2.5px solid var(--ink, #151b20);
    border-radius: 12px;
    box-shadow: 5px 5px 0px var(--ink, #151b20);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    pointer-events: auto;
    opacity: 0;
    transform: translateY(16px) scale(0.97);
    transition: opacity 0.22s cubic-bezier(0.16, 1, 0.3, 1), transform 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    visibility: hidden;
  }

  .score-toc-panel.open {
    opacity: 1;
    transform: translateY(0) scale(1);
    visibility: visible;
  }

  /* Header */
  .score-toc-header {
    background: var(--paper-deep, #eee4c8);
    border-bottom: 2px solid var(--ink, #151b20);
    padding: 0.65rem 0.9rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .score-toc-header-title {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 900;
    font-size: 0.85rem;
    font-family: var(--md-code-font, 'JetBrains Mono', monospace);
    letter-spacing: 0.05em;
    color: var(--ink, #151b20);
  }

  .score-toc-header-actions {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .score-toc-icon-btn {
    background: transparent;
    border: 1.5px solid transparent;
    border-radius: 6px;
    cursor: pointer;
    color: var(--ink, #151b20);
    font-size: 1rem;
    line-height: 1;
    padding: 0.2rem 0.35rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all 0.12s ease;
  }

  .score-toc-icon-btn:hover {
    background: rgba(21, 27, 32, 0.1);
    border-color: var(--ink, #151b20);
  }

  .score-toc-icon-btn.pinned {
    background: var(--yellow, #ffc83e);
    border-color: var(--ink, #151b20);
  }

  /* Progress Meter */
  .score-toc-meter {
    padding: 0.5rem 0.9rem 0.4rem 0.9rem;
    background: rgba(246, 240, 220, 0.5);
    border-bottom: 1px solid rgba(21, 27, 32, 0.15);
  }

  .score-toc-meter-track {
    height: 6px;
    background: rgba(21, 27, 32, 0.1);
    border: 1px solid var(--ink, #151b20);
    border-radius: 999px;
    overflow: hidden;
    margin-bottom: 0.35rem;
  }

  .score-toc-meter-fill {
    height: 100%;
    width: 0%;
    background: var(--yellow, #ffc83e);
    transition: width 0.1s linear;
  }

  .score-toc-meter-label {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.72rem;
    color: var(--ink-light, #333);
    font-family: var(--md-code-font, 'JetBrains Mono', monospace);
    font-weight: 600;
  }

  /* Nav Links List */
  .score-toc-nav {
    flex: 1 1 auto;
    overflow-y: auto;
    padding: 0.5rem 0.6rem;
    scroll-behavior: smooth;
  }

  .score-toc-nav::-webkit-scrollbar {
    width: 6px;
  }
  .score-toc-nav::-webkit-scrollbar-track {
    background: rgba(21, 27, 32, 0.05);
  }
  .score-toc-nav::-webkit-scrollbar-thumb {
    background: rgba(21, 27, 32, 0.25);
    border-radius: 999px;
  }

  .score-toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  /* Items */
  :global(.score-toc-item) {
    margin: 0;
    padding: 0;
  }

  :global(.score-toc-link) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.38rem 0.55rem;
    border-radius: 6px;
    text-decoration: none !important;
    color: rgba(21, 27, 32, 0.85);
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1.3;
    border: 1.5px solid transparent;
    transition: all 0.12s ease;
  }

  :global(.score-toc-link:hover) {
    background: rgba(21, 27, 32, 0.06);
    color: var(--ink, #151b20);
    border-color: rgba(21, 27, 32, 0.15);
  }

  :global(.score-toc-link.active) {
    background: var(--yellow, #ffc83e) !important;
    color: var(--ink, #151b20) !important;
    border: 1.5px solid var(--ink, #151b20) !important;
    box-shadow: 2px 2px 0px var(--ink, #151b20) !important;
    font-weight: 800 !important;
  }

  :global(.score-toc-badge) {
    background: rgba(21, 27, 32, 0.08);
    color: var(--ink, #151b20);
    border: 1px solid rgba(21, 27, 32, 0.3);
    border-radius: 4px;
    padding: 0.05rem 0.35rem;
    font-size: 0.72rem;
    font-family: var(--md-code-font, 'JetBrains Mono', monospace);
    font-weight: 800;
    flex-shrink: 0;
  }

  :global(.score-toc-link.active .score-toc-badge) {
    background: var(--cream, #fffaf0);
    border-color: var(--ink, #151b20);
  }

  :global(.score-toc-name) {
    flex: 1 1 auto;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Sub-list for dossiers */
  :global(.score-toc-sublist) {
    list-style: none;
    margin: 0.2rem 0 0.3rem 1.6rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  :global(.score-toc-sublink) {
    display: inline-block;
    padding: 0.15rem 0.45rem;
    background: var(--cream, #fffaf0);
    color: var(--ink, #151b20);
    border: 1px solid var(--ink, #151b20);
    border-radius: 4px;
    font-size: 0.72rem;
    font-weight: 700;
    font-family: var(--md-code-font, 'JetBrains Mono', monospace);
    text-decoration: none !important;
    transition: all 0.1s ease;
  }

  :global(.score-toc-sublink:hover) {
    background: var(--yellow, #ffc83e);
    box-shadow: 1.5px 1.5px 0px var(--ink, #151b20);
    transform: translate(-0.5px, -0.5px);
  }

  :global(.score-toc-sublink.active) {
    background: var(--yellow, #ffc83e);
    box-shadow: 1.5px 1.5px 0px var(--ink, #151b20);
  }

  /* Footer */
  .score-toc-footer {
    background: var(--paper-deep, #eee4c8);
    border-top: 1.5px solid var(--ink, #151b20);
    padding: 0.45rem 0.9rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.72rem;
    font-family: var(--md-code-font, 'JetBrains Mono', monospace);
    color: var(--ink-light, #444);
  }

  .toc-shortcuts kbd {
    background: var(--cream, #fffaf0);
    border: 1px solid var(--ink, #151b20);
    border-radius: 3px;
    padding: 0.05rem 0.25rem;
    font-weight: 700;
  }

  .toc-jump-top-btn {
    background: transparent;
    border: 1px solid transparent;
    cursor: pointer;
    font-family: inherit;
    font-size: inherit;
    font-weight: 800;
    color: var(--ink, #151b20);
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
  }

  .toc-jump-top-btn:hover {
    background: var(--yellow, #ffc83e);
    border-color: var(--ink, #151b20);
  }

  /* ══════════════════════════════════════════════════════════ */
  /* PINNED DESKTOP RAIL MODE (Screens >= 1480px)                */
  /* ══════════════════════════════════════════════════════════ */
  @media (min-width: 1540px) {
    .score-toc-panel.pinned {
      position: fixed;
      top: 6.5rem;
      right: 2rem;
      bottom: auto;
      max-height: calc(82vh - 6rem);
      width: 320px;
      opacity: 1;
      visibility: visible;
      transform: none;
      box-shadow: 4px 4px 0px var(--ink, #151b20);
    }
  }

  /* Mobile Tweaks */
  @media (max-width: 600px) {
    .score-floating-hub {
      bottom: 1rem;
      right: 1rem;
    }
    .score-toc-panel {
      width: calc(100vw - 2rem);
      max-height: 70vh;
      bottom: 4.2rem;
      right: 1rem;
    }
    .toc-trigger-text {
      max-width: 100px;
    }
  }
</style>

<script is:inline>
  // Self-executing TOC & ScrollSpy Controller
  (function initScoreTOC() {
    function setup() {
      const readingBar = document.getElementById('score-reading-progress');
      const bttBtn = document.getElementById('score-back-to-top');
      const tocTrigger = document.getElementById('score-toc-trigger');
      const tocPanel = document.getElementById('score-toc-panel');
      const tocClose = document.getElementById('score-toc-close');
      const tocPin = document.getElementById('score-toc-pin');
      const tocList = document.getElementById('score-toc-list');
      const tocMeterFill = document.getElementById('score-toc-meter-fill');
      const tocPercent = document.getElementById('score-toc-percent');
      const activeLabel = document.getElementById('score-toc-active-label');
      const activePct = document.getElementById('score-toc-active-pct');
      const jumpTopBtn = document.getElementById('score-toc-jump-top');

      if (!tocList || !tocTrigger || !tocPanel) return;

      // 1. Identify all target sections in document
      // Target semantic section tags with an ID
      const rawSections = Array.from(document.querySelectorAll('main section[id], article section[id]'));
      if (rawSections.length < 2) {
        // Less than 2 sections: page is short (e.g. index), hide TOC trigger
        tocTrigger.style.display = 'none';
        // But keep Back-to-Top functional if scrolled
      }

      // Parse metadata for each section
      const sections = rawSections.map((sec, idx) => {
        const id = sec.id;
        // Badge or Section number
        const badgeEl = sec.querySelector('.badge, .step-tag, .section-title-wrap .badge');
        let badgeText = badgeEl ? badgeEl.textContent.trim() : '';
        let secNum = '';
        if (badgeText) {
          const m = badgeText.match(/(§\s*\d+|Level\s*\d+\b|\b0[1-9]\b)/i);
          if (m) {
            secNum = m[0].replace(/\s+/, ' ');
          }
        }
        if (!secNum) {
          secNum = '§ ' + (idx + 1);
        }

        // Heading title
        const headingEl = sec.querySelector('h2, .section-heading, .block-title, h3');
        let title = headingEl ? headingEl.textContent.trim() : id.replace(/[-_]/g, ' ');
        // Clean up common prefixes
        title = title.replace(/^[\d\.\s§&;]+/, '').replace(/^All \d+ Detailed Native /i, '').trim();

        // Check for child dossiers from jump bar pills first, then fallback to card IDs
        let dossiers = [];
        const jumpPills = Array.from(sec.querySelectorAll('.dossier-jump-bar a, .dossier-jump-pill'));
        if (jumpPills.length > 0) {
          dossiers = jumpPills.map(p => {
            const rawHref = p.getAttribute('href') || '';
            const targetId = rawHref.replace(/^#/, '');
            const name = p.textContent.trim();
            return { id: targetId, name };
          }).filter(d => d.id && d.name);
        } else {
          const dossierCards = Array.from(sec.querySelectorAll('.dossier-card[id], article[id^="core-"]'));
          dossiers = dossierCards.map(d => {
            const nameEl = d.querySelector('.dossier-core-name, h3');
            const name = nameEl ? nameEl.textContent.trim().split(' ')[0] : d.id.replace('core-', '');
            return { id: d.id, name };
          });
        }

        return {
          id,
          secNum,
          title,
          el: sec,
          dossiers
        };
      });

      // 2. Build TOC List DOM
      tocList.innerHTML = '';
      sections.forEach((sec, idx) => {
        const li = document.createElement('li');
        li.className = 'score-toc-item';

        const link = document.createElement('a');
        link.href = '#' + sec.id;
        link.className = 'score-toc-link';
        link.setAttribute('data-target-id', sec.id);

        const badge = document.createElement('span');
        badge.className = 'score-toc-badge';
        badge.textContent = sec.secNum;

        const name = document.createElement('span');
        name.className = 'score-toc-name';
        name.textContent = sec.title;
        name.title = sec.title;

        link.appendChild(badge);
        link.appendChild(name);
        li.appendChild(link);

        // If this section has child dossiers (e.g. § 7), add an expandable sublist
        if (sec.dossiers && sec.dossiers.length > 0) {
          const sublist = document.createElement('div');
          sublist.className = 'score-toc-sublist';
          sec.dossiers.forEach(d => {
            const sublink = document.createElement('a');
            sublink.href = '#' + d.id;
            sublink.className = 'score-toc-sublink';
            sublink.textContent = d.name;
            sublink.setAttribute('data-target-id', d.id);
            sublink.addEventListener('click', (e) => {
              e.preventDefault();
              const target = document.getElementById(d.id);
              if (target) {
                target.scrollIntoView({ behavior: 'smooth' });
                if (history.pushState) history.pushState(null, '', '#' + d.id);
                if (!isPinned && window.innerWidth < 1540) {
                  closeTOC();
                }
              }
            });
            sublist.appendChild(sublink);
          });
          li.appendChild(sublist);
        }

        // Section link click handler
        link.addEventListener('click', (e) => {
          e.preventDefault();
          const target = document.getElementById(sec.id);
          if (target) {
            target.scrollIntoView({ behavior: 'smooth' });
            if (history.pushState) history.pushState(null, '', '#' + sec.id);
            if (!isPinned && window.innerWidth < 1540) {
              closeTOC();
            }
          }
        });

        tocList.appendChild(li);
      });

      // 3. Panel State Management (Open, Close, Pin)
      let isOpen = false;
      let isPinned = localStorage.getItem('score_toc_pinned') === 'true';

      function openTOC() {
        isOpen = true;
        tocPanel.classList.add('open');
        tocPanel.setAttribute('aria-hidden', 'false');
        tocTrigger.setAttribute('aria-expanded', 'true');
      }

      function closeTOC() {
        isOpen = false;
        tocPanel.classList.remove('open');
        tocPanel.setAttribute('aria-hidden', 'true');
        tocTrigger.setAttribute('aria-expanded', 'false');
      }

      function toggleTOC() {
        if (isOpen) closeTOC();
        else openTOC();
      }

      tocTrigger.addEventListener('click', toggleTOC);
      if (tocClose) tocClose.addEventListener('click', closeTOC);

      // Pin toggle
      if (tocPin) {
        if (isPinned) {
          tocPin.classList.add('pinned');
          if (window.innerWidth >= 1540) {
            tocPanel.classList.add('pinned');
            openTOC();
          }
        }

        tocPin.addEventListener('click', () => {
          isPinned = !isPinned;
          localStorage.setItem('score_toc_pinned', isPinned ? 'true' : 'false');
          tocPin.classList.toggle('pinned', isPinned);
          if (window.innerWidth >= 1540) {
            tocPanel.classList.toggle('pinned', isPinned);
            if (isPinned) openTOC();
          }
        });
      }

      // Close on outside click
      document.addEventListener('click', (e) => {
        if (!isOpen || isPinned && window.innerWidth >= 1540) return;
        if (!tocPanel.contains(e.target) && !tocTrigger.contains(e.target)) {
          closeTOC();
        }
      });

      // Keyboard shortcuts: 'T' toggles, 'Esc' closes
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && isOpen) {
          closeTOC();
        } else if ((e.key === 't' || e.key === 'T') && !['INPUT', 'TEXTAREA'].includes(document.activeElement.tagName)) {
          toggleTOC();
        }
      });

      // 4. Back to Top Smooth Scroll
      function scrollToTop() {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
      if (bttBtn) bttBtn.addEventListener('click', scrollToTop);
      if (jumpTopBtn) jumpTopBtn.addEventListener('click', scrollToTop);

      // 5. ScrollSpy & Progress Update
      let activeSectionId = '';
      function onScroll() {
        const scrollY = window.scrollY;
        const totalHeight = Math.max(document.body.scrollHeight, document.documentElement.scrollHeight);
        const docHeight = totalHeight - window.innerHeight;
        const progressRatio = docHeight > 0 ? Math.min(1, Math.max(0, scrollY / docHeight)) : 0;
        const pctString = Math.round(progressRatio * 100) + '%';

        // Update Reading Bars
        if (readingBar) readingBar.style.width = pctString;
        if (tocMeterFill) tocMeterFill.style.width = pctString;
        if (tocPercent) tocPercent.textContent = pctString;
        if (activePct) activePct.textContent = pctString;

        // Toggle Back-To-Top Button visibility
        if (bttBtn) {
          if (scrollY > 320) {
            bttBtn.classList.add('visible');
          } else {
            bttBtn.classList.remove('visible');
          }
        }

        // Determine active section (ScrollSpy)
        // Find the section that occupies the upper reading zone
        const scrollOffset = scrollY + 160; // 160px buffer below header
        let currentSec = sections[0];
        for (let i = 0; i < sections.length; i++) {
          const rect = sections[i].el.getBoundingClientRect();
          const top = rect.top + scrollY;
          if (top <= scrollOffset) {
            currentSec = sections[i];
          } else {
            break;
          }
        }

        if (currentSec && currentSec.id !== activeSectionId) {
          activeSectionId = currentSec.id;

          // Update trigger label
          if (activeLabel) {
            activeLabel.textContent = currentSec.secNum + ' ' + currentSec.title;
          }

          // Update TOC link active class
          const allLinks = tocList.querySelectorAll('.score-toc-link');
          allLinks.forEach(link => {
            if (link.getAttribute('data-target-id') === activeSectionId) {
              link.classList.add('active');
            } else {
              link.classList.remove('active');
            }
          });
        }
      }

      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll(); // initial trigger
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setup);
    } else {
      setup();
    }
  })();
</script>
