---
// CoreComparisonModal.astro
// Interactive Side-by-Side Architectural Specification Comparison Tool
import db from "../data/score_db.json";

const base = import.meta.env.BASE_URL;

// Filter processor cores and platforms (Categories 1 to 4)
const comparisonCores = db.tools
  .filter((t) => t.categoryNumber >= 1 && t.categoryNumber <= 4)
  .map((t) => {
    let pageUrl = "";
    switch (t.categoryNumber) {
      case 1: pageUrl = `${base}mcu-scalar/#core-${t.slug}`; break;
      case 2: pageUrl = `${base}app-cores/#core-${t.slug}`; break;
      case 3: pageUrl = `${base}vector-coprocessors/#core-${t.slug}`; break;
      case 4: pageUrl = `${base}soc-multicore/#core-${t.slug}`; break;
      default: pageUrl = `${base}mcu-scalar/#core-${t.slug}`; break;
    }

    return {
      slug: t.slug,
      name: t.name,
      subtitle: t.subtitle || "",
      categoryNumber: t.categoryNumber,
      categoryName: t.categoryName,
      categoryBadge: t.categoryBadge,
      isa: t.isa || "N/A",
      bus: t.bus || "N/A",
      language: t.language || "N/A",
      license: t.license || "N/A",
      organization: t.organization || "N/A",
      siliconEvidence: t.siliconEvidence || "Simulation / FPGA only",
      verificationEvidence: t.verificationEvidence || "RTL Simulation",
      notableStrengths: t.notableStrengths || "",
      notableLimitations: t.notableLimitations || "",
      benchmarks: t.benchmarks || [],
      pageUrl
    };
  });
---

<!-- Comparison Modal Overlay -->
<div id="score-compare-modal" class="score-compare-overlay" aria-hidden="true" role="dialog" aria-label="Core Comparison Matrix">
  <div class="score-compare-dialog">
    <!-- Modal Header -->
    <div class="score-compare-header">
      <div class="sch-title-group">
        <span class="sch-badge">&#9878; ARCHITECTURAL COMPARISON MATRIX</span>
        <h3 class="sch-title">Side-by-Side Microarchitectural &amp; Silicon Specification Matrix</h3>
        <p class="sch-sub">Compare evaluated open-source processor architectures, verification evidence, and empirical benchmark results.</p>
      </div>
      <div class="sch-actions">
        <button id="score-compare-share" class="btn-sch-tool" title="Copy shareable link with current comparison">
          <span class="tool-icon">&#128279;</span>
          <span class="tool-text">Share Link</span>
        </button>
        <button id="score-compare-clear" class="btn-sch-tool" title="Clear all selected cores">
          <span class="tool-icon">&#128465;</span>
          <span class="tool-text">Clear</span>
        </button>
        <button id="score-compare-close" class="btn-sch-close" aria-label="Close comparison modal" title="Close (Esc)">
          &times;
        </button>
      </div>
    </div>

    <!-- Presets Bar -->
    <div class="score-compare-presets-bar">
      <span class="presets-label">&#128302; Quick Presets:</span>
      <div class="presets-pills">
        <button class="preset-btn" data-preset="ibex,cv32e40p,hazard3">
          Embedded MCUs (Ibex &bull; CV32E40P &bull; Hazard3)
        </button>
        <button class="preset-btn" data-preset="cva6,boom,xiangshan">
          64-Bit App Cores (CVA6 &bull; BOOM &bull; XiangShan)
        </button>
        <button class="preset-btn" data-preset="ara,gemmini,spatz">
          Vector &amp; Coprocessors (Ara &bull; Gemmini &bull; Spatz)
        </button>
        <button class="preset-btn" data-preset="cheshire,mempool,occamy">
          SoC &amp; Manycore (Cheshire &bull; MemPool &bull; Occamy)
        </button>
      </div>
      <div class="diff-toggle-wrap">
        <label class="diff-label">
          <input type="checkbox" id="score-diff-toggle" />
          <span>Highlight Differences</span>
        </label>
      </div>
    </div>

    <!-- Modal Content: Scrollable Matrix -->
    <div class="score-compare-body">
      <!-- Selector Dropdowns Slot Header -->
      <div class="compare-selectors-grid">
        <div class="selector-slot" id="slot-0">
          <div class="slot-label">Core 1:</div>
          <select class="core-select" data-slot="0">
            <option value="">-- Choose a Core --</option>
            {comparisonCores.map((c) => (
              <option value={c.slug}>[L{c.categoryNumber}] {c.name}</option>
            ))}
          </select>
        </div>

        <div class="selector-slot" id="slot-1">
          <div class="slot-label">Core 2:</div>
          <select class="core-select" data-slot="1">
            <option value="">-- Choose a Core --</option>
            {comparisonCores.map((c) => (
              <option value={c.slug}>[L{c.categoryNumber}] {c.name}</option>
            ))}
          </select>
        </div>

        <div class="selector-slot" id="slot-2">
          <div class="slot-label">Core 3:</div>
          <select class="core-select" data-slot="2">
            <option value="">-- Choose a Core --</option>
            {comparisonCores.map((c) => (
              <option value={c.slug}>[L{c.categoryNumber}] {c.name}</option>
            ))}
          </select>
        </div>
      </div>

      <!-- Main Comparison Table Matrix -->
      <div class="table-responsive-matrix">
        <table class="compare-matrix-table" id="compareMatrixTable">
          <thead id="compareTableHead">
            <!-- Dynamically populated core header columns -->
          </thead>
          <tbody id="compareTableBody">
            <!-- Dynamically populated row groups -->
          </tbody>
        </table>
      </div>

      <!-- Empty State Notice (When 0 cores selected) -->
      <div id="compareEmptyState" class="compare-empty-state" style="display: none;">
        <span class="empty-icon">&#9878;</span>
        <h4>No Cores Selected for Comparison</h4>
        <p>Select up to 3 processor architectures from the dropdowns above, choose one of the quick presets, or click <strong>"+ Compare"</strong> next to any core in the leaderboards.</p>
      </div>
    </div>

    <!-- Modal Footer -->
    <div class="score-compare-footer">
      <div class="scf-info">
        <span>Displaying metrics from SCORE unified hardware database &bull; CC BY 4.0</span>
      </div>
      <div class="scf-shortcuts">
        <kbd>Esc</kbd> Close &middot; <kbd>C</kbd> Toggle Compare
      </div>
    </div>
  </div>
</div>

<style>
  /* ══════════════════════════════════════════════════════════ */
  /* MODAL OVERLAY & BACKDROP                                   */
  /* ══════════════════════════════════════════════════════════ */
  .score-compare-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(21, 27, 32, 0.65);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 2000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.22s ease, visibility 0.22s ease;
  }

  .score-compare-overlay.open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  /* Dialog Window */
  .score-compare-dialog {
    width: 1220px;
    max-width: 95vw;
    height: 90vh;
    max-height: 880px;
    background: var(--cream, #fffaf0);
    border: 2.5px solid var(--ink, #151b20);
    border-radius: 14px;
    box-shadow: 8px 8px 0px var(--ink, #151b20);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transform: translateY(20px) scale(0.98);
    transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .score-compare-overlay.open .score-compare-dialog {
    transform: translateY(0) scale(1);
  }

  /* Header */
  .score-compare-header {
    background: var(--paper-deep, #eee4c8);
    border-bottom: 2px solid var(--ink, #151b20);
    padding: 1rem 1.25rem;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .sch-badge {
    display: inline-block;
    background: var(--yellow, #ffc83e);
    color: var(--ink, #151b20);
    border: 1.5px solid var(--ink, #151b20);
    border-radius: 4px;
    padding: 0.1rem 0.45rem;
    font-size: 0.72rem;
    font-weight: 900;
    font-family: var(--md-code-font, monospace);
    letter-spacing: 0.05em;
    margin-bottom: 0.35rem;
  }

  .sch-title {
    font-size: 1.15rem;
    font-weight: 900;
    margin: 0 0 0.25rem 0;
    color: var(--ink, #151b20);
    letter-spacing: -0.01em;
  }

  .sch-sub {
    font-size: 0.82rem;
    color: var(--ink-light, #333);
    margin: 0;
  }

  .sch-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
