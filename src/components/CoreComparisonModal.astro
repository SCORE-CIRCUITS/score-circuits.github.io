  /* Empty State */
  .compare-empty-state {
    padding: 3rem 1.5rem;
    text-align: center;
    background: var(--paper, #f6f0dc);
    border: 2px dashed var(--ink, #151b20);
    border-radius: 10px;
    margin: 1rem 0;
  }

  .empty-icon {
    font-size: 2.5rem;
    display: block;
    margin-bottom: 0.5rem;
  }

  .compare-empty-state h4 {
    margin: 0 0 0.5rem 0;
    font-size: 1.1rem;
    font-weight: 900;
  }

  .compare-empty-state p {
    max-width: 500px;
    margin: 0 auto;
    font-size: 0.85rem;
    line-height: 1.5;
  }

  /* Footer */
  .score-compare-footer {
    background: var(--paper-deep, #eee4c8);
    border-top: 1.5px solid var(--ink, #151b20);
    padding: 0.6rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.75rem;
    font-family: var(--md-code-font, monospace);
    color: var(--ink-light, #333);
  }

  .scf-shortcuts kbd {
    background: var(--cream, #fffaf0);
    border: 1px solid var(--ink, #151b20);
    border-radius: 3px;
    padding: 0.05rem 0.3rem;
    font-weight: 700;
  }

  /* Header Trigger Button */
  :global(.score-compare-nav-btn) {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: var(--cream, #fffaf0);
    color: var(--ink, #151b20);
    border: 2px solid var(--ink, #151b20);
    border-radius: 999px;
    padding: 0.3rem 0.8rem;
    font-size: 0.82rem;
    font-weight: 800;
    font-family: var(--md-text-font, 'Inter', sans-serif);
    cursor: pointer;
    box-shadow: 2.5px 2.5px 0px var(--ink, #151b20);
    transition: transform 0.12s ease, box-shadow 0.12s ease, background-color 0.12s ease;
    user-select: none;
  }

  :global(.score-compare-nav-btn:hover) {
    background: var(--yellow, #ffc83e);
    transform: translate(-1px, -1px);
    box-shadow: 3.5px 3.5px 0px var(--ink, #151b20);
  }

  :global(.score-compare-nav-btn:active) {
    transform: translate(1px, 1px);
    box-shadow: 1.5px 1.5px 0px var(--ink, #151b20);
  }

  :global(.compare-count-badge) {
    background: var(--yellow, #ffc83e);
    color: var(--ink, #151b20);
    border: 1.5px solid var(--ink, #151b20);
    border-radius: 999px;
    padding: 0.05rem 0.45rem;
    font-size: 0.75rem;
    font-weight: 800;
    font-family: var(--md-code-font, monospace);
    min-width: 18px;
    text-align: center;
  }

  @media (max-width: 768px) {
    .compare-selectors-grid {
      grid-template-columns: 1fr;
    }
    .score-compare-dialog {
      height: 95vh;
      max-width: 98vw;
    }
    .score-compare-presets-bar {
      padding: 0.5rem 0.75rem;
    }
    .preset-btn {
      font-size: 0.7rem;
      padding: 0.2rem 0.5rem;
    }
  }
</style>

<script is:inline define:vars={{ comparisonCores, base }}>
  (function initCoreComparison() {
    const coresData = comparisonCores;
    const coresBySlug = Object.fromEntries(coresData.map(c => [c.slug, c]));

    // Elements
    const modal = document.getElementById("score-compare-modal");
    const closeBtn = document.getElementById("score-compare-close");
    const shareBtn = document.getElementById("score-compare-share");
    const clearBtn = document.getElementById("score-compare-clear");
    const diffToggle = document.getElementById("score-diff-toggle");
    const presetsBtns = document.querySelectorAll(".preset-btn");
    const selectElements = document.querySelectorAll(".core-select");
    const tableHead = document.getElementById("compareTableHead");
    const tableBody = document.getElementById("compareTableBody");
    const emptyState = document.getElementById("compareEmptyState");
    const matrixTable = document.getElementById("compareMatrixTable");

    // Selected cores array (up to 3)
    let selectedSlugs = ["cva6", "boom", "xiangshan"];

    // 1. Load initial state from URL params or localStorage
    try {
      const urlParams = new URLSearchParams(window.location.search);
      const urlCompare = urlParams.get("compare");
      if (urlCompare) {
        selectedSlugs = urlCompare.split(",").filter(s => coresBySlug[s]);
      } else {
        const saved = localStorage.getItem("score_compare_cores");
        if (saved) {
          const parsed = JSON.parse(saved);
          if (Array.isArray(parsed) && parsed.length > 0) {
            selectedSlugs = parsed.filter(s => coresBySlug[s]);
          }
        }
      }
    } catch (e) {}

    // Ensure array length up to 3
    selectedSlugs = selectedSlugs.slice(0, 3);

    function saveState() {
      try {
        localStorage.setItem("score_compare_cores", JSON.stringify(selectedSlugs));
      } catch (e) {}
      updateNavBadges();
    }

    function updateNavBadges() {
      const count = selectedSlugs.length;
      const badges = document.querySelectorAll("#score-compare-nav-count");
      badges.forEach(b => {
        b.textContent = String(count);
      });
    }

    function openModal() {
      if (!modal) return;
      modal.classList.add("open");
      modal.setAttribute("aria-hidden", "false");
      renderMatrix();
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.remove("open");
      modal.setAttribute("aria-hidden", "true");
    }

    // Attach open buttons
    document.addEventListener("click", (e) => {
      const trigger = e.target.closest("#score-open-compare-btn, .open-compare-modal-btn");
      if (trigger) {
        e.preventDefault();
        openModal();
      }

      // Add to compare button from dossiers or tables
      const addBtn = e.target.closest(".add-to-compare-btn, [data-compare-slug]");
      if (addBtn) {
        e.preventDefault();
        const slug = addBtn.getAttribute("data-compare-slug");
        if (slug && coresBySlug[slug]) {
          if (!selectedSlugs.includes(slug)) {
            if (selectedSlugs.length >= 3) {
              selectedSlugs.shift(); // remove oldest
            }
            selectedSlugs.push(slug);
            saveState();
            renderMatrix();
          }
          openModal();
        }
      }
    });

    if (closeBtn) closeBtn.addEventListener("click", closeModal);

    // Close on backdrop click
    if (modal) {
      modal.addEventListener("click", (e) => {
        if (e.target === modal) closeModal();
      });
    }

    // Keyboard shortcuts
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && modal && modal.classList.contains("open")) {
        closeModal();
      } else if ((e.key === "c" || e.key === "C") && !["INPUT", "TEXTAREA", "SELECT"].includes(document.activeElement.tagName)) {
        if (modal.classList.contains("open")) closeModal();
        else openModal();
      }
    });

    // Preset button handlers
    presetsBtns.forEach(btn => {
      btn.addEventListener("click", () => {
        const presetStr = btn.getAttribute("data-preset");
        if (presetStr) {
          selectedSlugs = presetStr.split(",").filter(s => coresBySlug[s]);
          saveState();
          renderMatrix();
        }
      });
    });

    // Clear all
    if (clearBtn) {
      clearBtn.addEventListener("click", () => {
        selectedSlugs = [];
        saveState();
        renderMatrix();
      });
    }

    // Share link
    if (shareBtn) {
      shareBtn.addEventListener("click", () => {
        const url = new URL(window.location.href);
        if (selectedSlugs.length > 0) {
          url.searchParams.set("compare", selectedSlugs.join(","));
        } else {
          url.searchParams.delete("compare");
        }
        navigator.clipboard.writeText(url.toString()).then(() => {
          const originalText = shareBtn.querySelector(".tool-text").textContent;
          shareBtn.querySelector(".tool-text").textContent = "Copied!";
          setTimeout(() => {
            shareBtn.querySelector(".tool-text").textContent = originalText;
          }, 1800);
        });
      });
    }

    // Diff toggle
    if (diffToggle) {
      diffToggle.addEventListener("change", () => {
        renderMatrix();
      });
    }

    // Select dropdown changes
    selectElements.forEach(sel => {
      sel.addEventListener("change", () => {
        const slotIdx = parseInt(sel.getAttribute("data-slot"), 10);
        const val = sel.value;
        if (val) {
          selectedSlugs[slotIdx] = val;
        } else {
          selectedSlugs.splice(slotIdx, 1);
        }
        // filter unique and defined
        selectedSlugs = selectedSlugs.filter((s, idx, self) => s && self.indexOf(s) === idx);
        saveState();
        renderMatrix();
      });
    });

    // 2. Render Matrix Table
    function renderMatrix() {
      // Update dropdown selections
      selectElements.forEach(sel => {
        const slotIdx = parseInt(sel.getAttribute("data-slot"), 10);
        sel.value = selectedSlugs[slotIdx] || "";
      });

      if (selectedSlugs.length === 0) {
        if (emptyState) emptyState.style.display = "block";
        if (matrixTable) matrixTable.style.display = "none";
        return;
      }

      if (emptyState) emptyState.style.display = "none";
      if (matrixTable) matrixTable.style.display = "table";

      const activeCores = selectedSlugs.map(s => coresBySlug[s]).filter(Boolean);
      const isDiffOnly = diffToggle ? diffToggle.checked : false;

      // Render thead
      let headHtml = `<tr><th>Architectural Metric</th>`;
      activeCores.forEach((c, idx) => {
        const badgeClass = c.categoryNumber === 1 ? "badge-yellow" : c.categoryNumber === 2 ? "badge-cyan" : c.categoryNumber === 3 ? "badge-coral" : "badge-lime";
        headHtml += `
          <th class="compare-col-header">
            <button class="cch-remove-btn" data-remove-slot="${idx}" title="Remove ${c.name}">&times;</button>
            <span class="cch-badge ${badgeClass}">Tier 0${c.categoryNumber}</span>
            <span class="cch-name">${c.name}</span>
            <small style="font-weight: 500; font-family: var(--md-code-font, monospace); display: block;">${c.organization}</small>
          </th>
        `;
      });
      headHtml += `</tr>`;
      tableHead.innerHTML = headHtml;

      // Attach column remove handlers
      const removeBtns = tableHead.querySelectorAll(".cch-remove-btn");
      removeBtns.forEach(btn => {
        btn.addEventListener("click", () => {
          const slot = parseInt(btn.getAttribute("data-remove-slot"), 10);
          selectedSlugs.splice(slot, 1);
          saveState();
          renderMatrix();
        });
      });

      // Definition of matrix rows
      const sections = [
        {
          title: "1. CORE IDENTITY & GOVERNANCE",
          rows: [
            { label: "Architecture Name", getter: c => `<strong>${c.name}</strong>` },
            { label: "Category / Evaluation Tier", getter: c => `<span class="score-badge">${c.categoryName}</span>` },
            { label: "Sponsoring Organization", getter: c => c.organization },
            { label: "HDL Language", getter: c => `<code>${c.language}</code>` },
            { label: "Hardware License", getter: c => `<code>${c.license}</code>` }
          ]
        },
        {
          title: "2. MICROARCHITECTURE & INTERCONNECT",
          rows: [
            { label: "Instruction Set (ISA)", getter: c => `<code>${c.isa}</code>` },
            { label: "Primary Bus / Interconnect", getter: c => `<code>${c.bus}</code>` },
            { label: "Architectural Focus", getter: c => c.subtitle }
          ]
        },
        {
          title: "3. SILICON PROVENANCE & VERIFICATION RIGOR",
          rows: [
            { label: "Silicon Tapeout Evidence", getter: c => `<span class="score-badge">${c.siliconEvidence}</span>` },
            { label: "Verification Tooling", getter: c => c.verificationEvidence }
          ]
        },
        {
          title: "4. ARCHITECTURAL TRADE-OFFS",
          rows: [
            { label: "Notable Strengths", getter: c => c.notableStrengths },
            { label: "Notable Limitations", getter: c => c.notableLimitations }
          ]
        },
        {
          title: "5. VERIFIED BENCHMARKS & DOSSIER LINK",
          rows: [
            {
              label: "Empirical Workloads",
              getter: c => {
                if (!c.benchmarks || c.benchmarks.length === 0) return "<em>Simulation verified</em>";
                return c.benchmarks.slice(0, 3).map(b => {
                  const m = b.metrics || {};
                  let detail = "";
                  if (m.coremark_per_mhz) detail = ` &bull; <strong>${m.coremark_per_mhz} CoreMark/MHz</strong>`;
                  else if (m.ipc) detail = ` &bull; <strong>IPC: ${m.ipc}</strong>`;
                  else if (m.performance_ops_per_cycle) detail = ` &bull; <strong>${m.performance_ops_per_cycle.toFixed(2)} Ops/Cycle</strong>`;
                  else if (m.total_simulation_cycles) detail = ` &bull; ${m.total_simulation_cycles.toLocaleString()} cycles`;
                  return `<div style="margin-bottom: 0.35rem;"><code>${b.workload}</code>${detail}</div>`;
                }).join("");
              }
            },
            {
              label: "Native Dossier Permapage",
              getter: c => `<a href="${c.pageUrl}" class="matrix-dossier-btn" target="_blank" rel="noopener">Inspect Full Dossier &rarr;</a>`
            }
          ]
        }
      ];

      // Build tbody
      let bodyHtml = "";
      sections.forEach(sec => {
        bodyHtml += `<tr><td colspan="${activeCores.length + 1}" class="matrix-section-divider">${sec.title}</td></tr>`;
        sec.rows.forEach(r => {
          const values = activeCores.map(c => r.getter(c));
          // Check difference across active cores
          const cleanVals = values.map(v => String(v).replace(/<[^>]+>/g, "").trim());
          const hasDiff = cleanVals.length > 1 && new Set(cleanVals).size > 1;

          const rowClass = hasDiff ? "has-diff" : "";
          bodyHtml += `<tr class="${rowClass}">`;
          bodyHtml += `<td><strong>${r.label}</strong></td>`;
          values.forEach(v => {
            bodyHtml += `<td>${v}</td>`;
          });
          bodyHtml += `</tr>`;
        });
      });

      tableBody.innerHTML = bodyHtml;
    }

    // Initial setup on DOM ready
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", () => {
        saveState();
        updateNavBadges();
      });
    } else {
      saveState();
      updateNavBadges();
    }
  })();
</script>
