  .selector-slot {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .slot-label {
    font-size: 0.78rem;
    font-weight: 800;
    font-family: var(--md-code-font, monospace);
    color: var(--ink, #151b20);
  }

  .core-select {
    width: 100%;
    padding: 0.45rem 0.65rem;
    font-size: 0.82rem;
    font-weight: 700;
    font-family: var(--md-code-font, monospace);
    background: var(--cream, #fffaf0);
    border: 1.5px solid var(--ink, #151b20);
    border-radius: 6px;
    color: var(--ink, #151b20);
    outline: none;
    cursor: pointer;
  }

  .core-select:focus {
    border-color: #000;
    box-shadow: 0 0 0 2px var(--yellow, #ffc83e);
  }

  /* Matrix Table */
  .table-responsive-matrix {
    overflow-x: auto;
    border: 2px solid var(--ink, #151b20);
    border-radius: 10px;
    background: var(--cream, #fffaf0);
  }

  .compare-matrix-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.82rem;
    table-layout: fixed;
  }

  .compare-matrix-table th,
  .compare-matrix-table td {
    padding: 0.65rem 0.85rem;
    border: 1px solid rgba(21, 27, 32, 0.2);
    vertical-align: top;
    line-height: 1.45;
  }

  /* Sticky first column */
  .compare-matrix-table th:first-child,
  .compare-matrix-table td:first-child {
    width: 220px;
    min-width: 200px;
    background: var(--paper, #f6f0dc);
    font-weight: 800;
    color: var(--ink, #151b20);
    border-right: 2px solid var(--ink, #151b20);
  }

  /* Sticky Header */
  .compare-matrix-table thead th {
    position: sticky;
    top: 0;
    background: var(--paper-deep, #eee4c8);
    border-bottom: 2px solid var(--ink, #151b20);
    z-index: 10;
    font-weight: 900;
  }

  /* Row Category Divider */
  :global(.matrix-section-divider) {
    background: var(--paper-deep, #eee4c8) !important;
    font-size: 0.78rem;
    font-weight: 900;
    font-family: var(--md-code-font, monospace);
    letter-spacing: 0.05em;
    color: var(--ink, #151b20);
    padding: 0.45rem 0.85rem !important;
    border-top: 2px solid var(--ink, #151b20) !important;
    border-bottom: 2px solid var(--ink, #151b20) !important;
  }

  /* Diff Highlighting */
  :global(.compare-matrix-table tr.has-diff td:not(:first-child)) {
    background-color: rgba(255, 200, 62, 0.2) !important;
  }

  :global(.compare-col-header) {
    text-align: left;
  }

  :global(.cch-name) {
    font-size: 1rem;
    font-weight: 900;
    display: block;
    margin-bottom: 0.25rem;
  }

  :global(.cch-badge) {
    display: inline-block;
    padding: 0.05rem 0.4rem;
    font-size: 0.68rem;
    font-weight: 800;
    border: 1px solid var(--ink, #151b20);
    border-radius: 4px;
    font-family: var(--md-code-font, monospace);
    margin-right: 0.35rem;
  }

  :global(.cch-remove-btn) {
    float: right;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    font-size: 1rem;
    line-height: 1;
    padding: 0.1rem 0.35rem;
    cursor: pointer;
    color: var(--ink, #151b20);
  }

  :global(.cch-remove-btn:hover) {
    background: rgba(21, 27, 32, 0.1);
    border-color: var(--ink, #151b20);
  }

  :global(.matrix-dossier-btn) {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: var(--yellow, #ffc83e);
    color: var(--ink, #151b20) !important;
    border: 1.5px solid var(--ink, #151b20);
    border-radius: 6px;
    padding: 0.35rem 0.65rem;
    font-size: 0.75rem;
    font-weight: 800;
    font-family: var(--md-code-font, monospace);
    text-decoration: none !important;
    box-shadow: 1.5px 1.5px 0px var(--ink, #151b20);
    transition: all 0.12s ease;
  }

  :global(.matrix-dossier-btn:hover) {
    background: #ffe066;
    transform: translate(-0.5px, -0.5px);
    box-shadow: 2px 2px 0px var(--ink, #151b20);
