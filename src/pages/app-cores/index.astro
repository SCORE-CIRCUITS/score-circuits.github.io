            <!-- Architectural Assessment (Strengths & Trade-offs) -->
            <div class="dossier-assessment-grid">
              <div class="assess-item strength">
                <strong>&#10003; Architectural Strengths:</strong> {core.strengths}
              </div>
              <div class="assess-item limitation">
                <strong>&#9888; Engineering Trade-offs:</strong> {core.tradeoffs}
              </div>
            </div>

            <!-- Reproduction & Verification Commands -->
            <div class="dossier-repro-box">
              <span class="repro-title">Reproduction &amp; Verification Commands:</span>
              <div class="repro-cmd-row">
                {core.scripts.generate && (
                  <div class="cmd-item">
                    <span class="cmd-tag">Generate RTL:</span>
                    <code>./{core.scripts.generate}</code>
