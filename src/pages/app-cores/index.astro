                )}
                {core.scripts.run && (
                  <div class="cmd-item">
                    <span class="cmd-tag">Run Simulation:</span>
                    <code>./{core.scripts.run}</code>
                  </div>
                )}
                {core.scripts.install && (
                  <div class="cmd-item">
                    <span class="cmd-tag">Install Setup:</span>
