  <section id="core-dossiers" class="dossiers-container">
    <div class="section-title-wrap">
      <div class="badge badge-primary">&sect; 7. DETAILED ARCHITECTURAL DOSSIERS</div>
      <h2 class="section-heading">Detailed Native Core Dossiers</h2>
      <p class="section-sub">
        Comprehensive native microarchitectural breakdowns, memory bus specifications, silicon and FPGA deployment evidence, verified empirical benchmark metrics, and engineering trade-offs.
      </p>

      <!-- Quick Dossier Jump Bar -->
      <div class="dossier-jump-bar">
