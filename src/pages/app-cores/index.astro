    width: fit-content;
    margin-bottom: 0.25rem;
  }

  .diff-spec-head h4 {
    font-size: 1.15rem;
    font-weight: 900;
    color: var(--ink, #151b20);
    margin: 0;
  }

  .diff-lead {
    font-size: 0.92rem;
    color: var(--ink-light, #242c33);
    line-height: 1.55;
    margin: 0;
  }

  .diff-points-stack {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    margin-top: 0.25rem;
  }

  .diff-point-row {
    display: grid;
