<script>
  // Base RV64GC ISA Table Filter & Search
  const isaCatBtns = document.querySelectorAll(".isa-cat-btn");
  const isaRows = document.querySelectorAll("#isaFullSpecTable tbody tr");
  const isaSearch = document.getElementById("isaSearchInput") as HTMLInputElement;

  function filterIsaTable() {
    const activeCat = document.querySelector(".isa-cat-btn.active")?.getAttribute("data-isa-cat") || "all";
    const query = isaSearch ? isaSearch.value.trim().toLowerCase() : "";

    isaRows.forEach((row) => {
      const rowCat = row.getAttribute("data-cat");
      const text = row.textContent?.toLowerCase() || "";
      const matchesCat = activeCat === "all" || rowCat === activeCat;
      const matchesQuery = query === "" || text.includes(query);

      if (matchesCat && matchesQuery) {
        (row as HTMLElement).style.display = "";
      } else {
        (row as HTMLElement).style.display = "none";
      }
    });
  }

  isaCatBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      isaCatBtns.forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      filterIsaTable();
    });
  });

  if (isaSearch) {
    isaSearch.addEventListener("input", filterIsaTable);
  }

  // Copy LaTeX
  document.querySelectorAll(".copy-latex-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const targetId = btn.getAttribute("data-target");
      const box = document.getElementById(targetId || "");
      if (box) {
        const isShown = box.style.display === "block";
        box.style.display = isShown ? "none" : "block";
        if (!isShown) {
          const code = box.querySelector("code")?.textContent || "";
          navigator.clipboard.writeText(code).then(() => {
            const orig = btn.textContent;
            btn.textContent = "Copied to Clipboard!";
            setTimeout(() => { btn.textContent = orig; }, 2000);
          });
        }
      }
    });
  });

  document.querySelectorAll(".close-latex-btn").forEach((btn) => {
    btn.addEventListener("click", (e) => {
      const parent = (e.target as HTMLElement).closest(".latex-export-box") as HTMLElement;
      if (parent) parent.style.display = "none";
    });
  });

  // Interactive Application Core Memory Workbench
  const awData: Record<string, { latency: string; blocks: string; impact: string; desc: string; tradeoff: string }> = {
    tlb_hit: {
      latency: "1 Clock Cycle (~0.7 ns)",
      blocks: "PC Reg \u2192 DTLB CAM \u2192 L1 Cache Tag Compare",
      impact: "Zero Stall Bubbles (Instantaneous CPI = 1.0)",
      desc: "<strong>TLB Hit Mechanics:</strong> The 64-bit effective address Virtual Page Number (<code>VPN[2:0]</code>) matches an active translation entry in the fully associative 32-entry DTLB. The Physical Page Number (<code>PPN</code>) is concatenated with the 12-bit page offset within 1 clock cycle. The L1 Data Cache verifies tags simultaneously using Virtual-Index Physical-Tag (VIPT) mapping with zero pipeline stalls.",
      tradeoff: "<strong>Silicon Trade-off:</strong> Dedicated 32-entry Content-Addressable Memory (CAM) structures consume significant dynamic power on every memory access but guarantee that 99%+ of memory operations proceed without stall cycles."
    },
    tlb_miss: {
      latency: "30 \u2013 120 Clock Cycles (~25 \u2013 90 ns)",
      blocks: "DTLB Miss Trap \u2192 Hardware PTW FSM \u2192 L2 / DRAM Radix Walk \u2192 satp.PPN Refill",
      impact: "Pipeline Frozen or Thread Suspended (CPI degraded to 15.0+)",
      desc: "<strong>TLB Miss & 3-Level Radix Tree Walk:</strong> The requested VPN is not present in the TLB. The Hardware Page Table Walker (PTW) takes control of the memory bus, accessing Root Level-2 PTE (via <code>satp.PPN</code>), Middle Level-1 PTE, and Leaf Level-0 PTE sequentially in DRAM. Each walk step incurs cache miss penalties before writing the newly translated PTE back into the TLB.",
      tradeoff: "<strong>Silicon Trade-off:</strong> A hardware PTW adds ~12\u201318 kGE of autonomous control FSM and bus arbitration logic. Without it, the core would have to trap to software M-mode / S-mode, turning a 50-cycle hardware walk into an catastrophic 800+ cycle OS trap handler."
    },
    mshr_miss: {
      latency: "40 \u2013 80 Clock Cycles (Overlapped Concurrency)",
      blocks: "L1 Cache Miss \u2192 MSHR Queue Allocation \u2192 TileLink / AXI4 Coherent Bus \u2192 DRAM Burst",
      impact: "Non-blocking execution for non-dependent instructions (Hits-Under-Miss sustained)",
      desc: "<strong>Non-blocking Cache & MSHR Concurrency:</strong> An L1 Data Cache miss occurs, but rather than stalling the core pipeline, the transaction address, sub-word offset, and target destination register are enqueued into one of 4 to 8 Miss Status Holding Registers (MSHRs). While the bus fetches the 64-byte cache line from DRAM, subsequent independent loads and stores continue to hit in L1-D.",
      tradeoff: "<strong>Silicon Trade-off:</strong> Non-blocking caches require complex tag-matching CAMs on MSHR entries and out-of-order write-back arbitration into the L1 data SRAM, costing ~15\u201325 kGE over a simple blocking cache, but preventing memory-latency serialization."
    },
    ooo_rob: {
      latency: "Dynamic Latency Hiding (0-cycle visible stall for long loads)",
      blocks: "Instruction Rename \u2192 Reservation Stations \u2192 Distributed Execution Units \u2192 Reorder Buffer (RoB)",
      impact: "Sustained IPC > 1.2 even in the presence of DRAM cache misses",
      desc: "<strong>Out-of-Order Execution & In-Order Retirement (RoB):</strong> In an Out-of-Order core (e.g. BOOM), instructions that are stalled waiting for high-latency DRAM data are bypassed by subsequent ready instructions in the Reservation Stations. Instructions execute speculatively out-of-order and write results to the Reorder Buffer (RoB). The RoB commits instructions strictly in program order to ensure precise architectural exception handling.",
      tradeoff: "<strong>Silicon Trade-off:</strong> Implementing an Out-of-Order microarchitecture requires huge physical register files (PRF), associative issue queues, and branch checkpoint recovery tables, escalating core area from ~135 kGE (Rocket) to ~420 kGE (BOOM)\u2014a 3.1\u00d7 silicon area penalty for ~2\u00d7 IPC throughput."
    }
  };

  const awButtons = document.querySelectorAll(".aw-btn");
  const elLatency = document.getElementById("awLatency");
  const elBlocks = document.getElementById("awBlocks");
  const elImpact = document.getElementById("awImpact");
  const elDesc = document.getElementById("awDesc");
  const elTradeoff = document.getElementById("awTradeoff");

  awButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      awButtons.forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      const scenarioKey = btn.getAttribute("data-scenario");
      if (scenarioKey && awData[scenarioKey]) {
        const item = awData[scenarioKey];
        if (elLatency) elLatency.textContent = item.latency;
        if (elBlocks) elBlocks.textContent = item.blocks;
        if (elImpact) elImpact.textContent = item.impact;
        if (elDesc) elDesc.innerHTML = item.desc;
        if (elTradeoff) elTradeoff.innerHTML = item.tradeoff;
      }
    });
  });

  // Filter Matrix by Tier for Section 4
  const filterBtns = document.querySelectorAll(".matrix-filter-btn");
  const matrixRows = document.querySelectorAll("#matrix-table tbody tr");

  filterBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      filterBtns.forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      const tier = btn.getAttribute("data-tier");

      matrixRows.forEach((row) => {
        const rowTier = row.getAttribute("data-tier");
        if (tier === "all" || rowTier === tier) {
          (row as HTMLElement).style.display = "";
        } else {
          (row as HTMLElement).style.display = "none";
        }
      });
    });
  });

  // Master Leaderboard: Filter, Search, and Sort for Section 5
  const lbTable = document.getElementById("masterLeaderboardTable");
  if (lbTable) {
    const lbTbody = lbTable.querySelector("tbody");
    const lbFilterPills = document.querySelectorAll(".lb-pill");
    const lbSearchInput = document.getElementById("lbSearchInput") as HTMLInputElement | null;
    const lbClearSearch = document.getElementById("lbClearSearch") as HTMLButtonElement | null;
    const lbSortSelect = document.getElementById("lbSortSelect") as HTMLSelectElement | null;
    const lbSortHeaders = lbTable.querySelectorAll("th[data-sort]");

    let activeFilter = "all";
    let activeQuery = "";
    let currentSortKey = "default";
    let currentSortDir: "asc" | "desc" = "desc";

    function filterLeaderboard() {
      if (!lbTbody) return;
      const rows = Array.from(lbTbody.querySelectorAll("tr")) as HTMLElement[];

      rows.forEach((row) => {
        const rowArch = row.getAttribute("data-archetype") || "";
        const rowSearch = row.getAttribute("data-search") || "";

        const matchesFilter = activeFilter === "all" || rowArch === activeFilter;
        const matchesSearch = activeQuery === "" || rowSearch.includes(activeQuery);

        if (matchesFilter && matchesSearch) {
          row.style.display = "";
        } else {
          row.style.display = "none";
        }
      });
    }

    // Archetype pill filter click
    lbFilterPills.forEach((pill) => {
      pill.addEventListener("click", () => {
        lbFilterPills.forEach((p) => p.classList.remove("active"));
        pill.classList.add("active");
        activeFilter = pill.getAttribute("data-filter") || "all";
        filterLeaderboard();
      });
    });

    // Real-time search input
    if (lbSearchInput) {
      lbSearchInput.addEventListener("input", () => {
        activeQuery = lbSearchInput.value.trim().toLowerCase();
        if (lbClearSearch) {
          lbClearSearch.style.display = activeQuery.length > 0 ? "block" : "none";
        }
        filterLeaderboard();
      });
    }

    // Clear search button
    if (lbClearSearch && lbSearchInput) {
      lbClearSearch.addEventListener("click", () => {
        lbSearchInput.value = "";
        activeQuery = "";
        lbClearSearch.style.display = "none";
        filterLeaderboard();
        lbSearchInput.focus();
      });
    }

    // Multi-key row sorting function
    function sortRows(key: string, dir: "asc" | "desc") {
      if (!lbTbody) return;
      const rows = Array.from(lbTbody.querySelectorAll("tr")) as HTMLElement[];

      rows.sort((a, b) => {
        if (key === "default") {
          const idxA = parseInt(a.getAttribute("data-original-idx") || "0", 10);
          const idxB = parseInt(b.getAttribute("data-original-idx") || "0", 10);
          return idxA - idxB;
        }

        const valA = a.getAttribute(`data-${key}`) || "";
        const valB = b.getAttribute(`data-${key}`) || "";

        const numA = parseFloat(valA);
        const numB = parseFloat(valB);
        if (!isNaN(numA) && !isNaN(numB)) {
          return dir === "asc" ? numA - numB : numB - numA;
        }

        return dir === "asc" ? valA.localeCompare(valB) : valB.localeCompare(valA);
      });

      rows.forEach((r) => lbTbody.appendChild(r));
    }

    // Sort select change listener
    if (lbSortSelect) {
      lbSortSelect.addEventListener("change", () => {
        const val = lbSortSelect.value;
        lbSortHeaders.forEach((h) => h.classList.remove("sort-active", "sort-asc", "sort-desc"));
        if (val === "default") {
          sortRows("default", "asc");
        } else if (val === "memcpy-desc") {
          sortRows("memcpy", "desc");
        } else if (val === "fmax-desc") {
          sortRows("fmax", "desc");
        } else if (val === "area-asc") {
          sortRows("area", "asc");
        } else if (val === "name-asc") {
          sortRows("name", "asc");
        }
      });
    }

    // Interactive column header sort
    lbSortHeaders.forEach((th) => {
      th.addEventListener("click", () => {
        const key = th.getAttribute("data-sort");
        if (!key) return;

        if (currentSortKey === key) {
          currentSortDir = currentSortDir === "asc" ? "desc" : "asc";
        } else {
          currentSortKey = key;
          currentSortDir = ["name", "isa", "archetype", "bus"].includes(key) ? "asc" : "desc";
        }

        lbSortHeaders.forEach((h) => {
          h.classList.remove("sort-active", "sort-asc", "sort-desc");
        });
        th.classList.add("sort-active", currentSortDir === "asc" ? "sort-asc" : "sort-desc");

        sortRows(key, currentSortDir);
      });
    });
  }

</script>

