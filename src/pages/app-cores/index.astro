  }

  .diff-spec-card.diff-hazards { border-left: 6px solid var(--coral, #f38469); }
  .diff-spec-card.diff-math { border-left: 6px solid var(--yellow, #ffc83e); }
  .diff-spec-card.diff-memory { border-left: 6px solid var(--teal, #0d9488); }
  .diff-spec-card.diff-security { border-left: 6px solid var(--purple, #8275e8); }

