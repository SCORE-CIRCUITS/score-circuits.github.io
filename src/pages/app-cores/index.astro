                    <tr><th>Memory Concurrency:</th><td>{core.memConcurrency}</td></tr>
                    <tr><th>Silicon Evidence:</th><td>{core.siliconEvidence}</td></tr>
                    <tr><th>Verification Rigor:</th><td>{core.verificationRigor}</td></tr>
                  </tbody>
                </table>
              </div>
            </div>

            <!-- Technical Breakdown Sections -->
            <div class="dossier-tech-breakdown">
              <div class="tech-sub-block">
                <h5 class="tech-sub-title">&#9881; Microarchitectural Pipeline &amp; Datapath</h5>
                <p>{core.pipelineDesc}</p>
              </div>
              <div class="tech-sub-block">
                <h5 class="tech-sub-title">&#128421; Memory Subsystem, Radix Translation &amp; Interconnect Protocol</h5>
