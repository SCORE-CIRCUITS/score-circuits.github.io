    border: 1.5px solid var(--ink, #151b20);
    border-radius: 6px;
    box-shadow: 2px 2px 0 var(--ink, #151b20);
    padding: 0.5rem 0.85rem;
    font-size: 0.82rem;
    font-weight: 800;
    color: var(--ink, #151b20);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .aw-btn:hover {
    background: var(--paper-deep, #eee4c8);
  }

  .aw-btn.active {
    background: var(--cyan, #22bfd7);
    color: var(--ink, #151b20);
    font-weight: 900;
    box-shadow: 2px 2px 0 var(--ink, #151b20);
  }

  .aw-display {
    background: #ffffff;
    border: 2px solid var(--ink, #151b20);
    border-radius: 10px;
    box-shadow: 3px 3px 0 var(--ink, #151b20);
    padding: 1.25rem;
  }

  .aw-metric-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    background: var(--paper, #fffaf0);
    border: 1.5px solid var(--ink, #151b20);
    border-radius: 8px;
    padding: 1rem;
    margin-bottom: 1rem;
  }

  .aw-metric {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .aw-lbl {
    font-size: 0.72rem;
    font-weight: 800;
    font-family: var(--md-code-font, monospace);
    color: #242c33;
    text-transform: uppercase;
  }

  .aw-val {
    font-size: 0.9rem;
    font-weight: 900;
    color: var(--ink, #151b20);
  }

  .aw-step-desc {
    background: var(--cream, #fffaf0);
    border: 1.5px solid var(--ink, #151b20);
    border-radius: 6px;
    padding: 0.85rem 1rem;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--ink, #151b20);
    margin-bottom: 0.75rem;
  }

  .aw-tradeoff-box {
    background: var(--paper-deep, #eee4c8);
    border-left: 4px solid var(--coral, #f38469);
    border-radius: 0 6px 6px 0;
    padding: 0.75rem 1rem;
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--ink, #151b20);
  }

  /* Universal Primitives Flow */
  .anatomy-breakdown-intro {
    margin-top: 1.5rem;
    margin-bottom: 1rem;
  }

  .anatomy-subheading {
    font-size: 1.25rem;
    font-weight: 900;
    color: var(--ink, #151b20);
    margin: 0 0 0.5rem 0;
    letter-spacing: -0.01em;
  }

  .ladder-narrative {
    font-size: 0.96rem;
    line-height: 1.6;
    color: var(--ink-light, #242c33);
    margin: 0;
  }

  .primitives-flow {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: 1.75rem;
  }

  .primitive-card {
    background: #ffffff;
    border: 2px solid var(--ink, #151b20);
    border-radius: 12px;
    box-shadow: 3px 3px 0 var(--ink, #151b20);
    padding: 1.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .primitive-card:hover {
    transform: translateY(-2px);
    box-shadow: 4px 4px 0 var(--ink, #151b20);
  }

  .prim-card-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    border-bottom: 1.5px dashed var(--line, #eee4c8);
    padding-bottom: 0.65rem;
  }

  .prim-step-pill {
    background: var(--cream-soft, #f6f0dc);
    color: var(--ink, #151b20);
    border: 1px solid var(--ink, #151b20);
    font-size: 0.75rem;
    font-weight: 900;
    font-family: var(--md-code-font, monospace);
    letter-spacing: 0.05em;
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .prim-title {
    font-size: 1.15rem;
    font-weight: 900;
    color: var(--ink, #151b20);
    margin: 0;
    letter-spacing: -0.01em;
  }

  .prim-card-body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .prim-text {
    font-size: 0.94rem;
    line-height: 1.6;
    color: var(--ink-light, #242c33);
    margin: 0;
  }

  .prim-micro-insights {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    background: var(--paper-deep, #eee4c8);
    border: 1px solid var(--ink, #151b20);
    border-radius: 8px;
    padding: 0.85rem 1rem;
  }

  .prim-insight-row {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  @media (min-width: 680px) {
    .prim-insight-row {
      display: grid;
      grid-template-columns: 210px 1fr;
      align-items: baseline;
      gap: 0.75rem;
    }
  }

  .insight-label {
    font-size: 0.74rem;
    font-weight: 850;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink, #151b20);
    font-family: var(--md-code-font, monospace);
  }

  .insight-value {
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--ink-light, #151b20);
  }

  /* Tradeoff Table */
  .tradeoff-matrix-wrap {
    width: 100%;
    overflow-x: auto;
    border: 2px solid var(--ink, #151b20);
    border-radius: 10px;
    box-shadow: 3px 3px 0 var(--ink, #151b20);
    margin-top: 1rem;
    background: #ffffff;
  }

  .tradeoff-table {
    width: 100%;
    min-width: 680px;
    border-collapse: collapse;
    font-size: 0.88rem;
  }

  .tradeoff-table th {
    background: var(--paper-deep, #eee4c8);
    border-bottom: 2px solid var(--ink, #151b20);
    border-right: 1px solid var(--line, #eee4c8);
    padding: 0.75rem 1rem;
    text-align: left;
    font-weight: 900;
    font-family: var(--md-code-font, monospace);
    font-size: 0.78rem;
    text-transform: uppercase;
  }

  .tradeoff-table td {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--line, #eee4c8);
    border-right: 1px solid var(--line, #eee4c8);
    line-height: 1.5;
    color: var(--ink, #151b20);
  }

  .tradeoff-table tbody tr:last-child td {
    border-bottom: none;
  }

  .tradeoff-table tbody tr:hover {
    background: rgba(34, 191, 215, 0.05);
  }

  /* Triad Cards Top-Down Progressive Flow */
  .triad-cards-topdown {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-top: 1.25rem;
  }

  .triad-step-card {
    background: #ffffff;
    border: 2px solid var(--ink, #151b20);
    border-radius: 12px;
    box-shadow: 4px 4px 0 var(--ink, #151b20);
    padding: 1.5rem;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .triad-step-card:hover {
    transform: translateY(-2px);
    box-shadow: 6px 6px 0 var(--ink, #151b20);
  }

  .triad-step-card.axis-1-border {
    border-left: 8px solid var(--yellow, #ffc83e) !important;
  }

  .triad-step-card.axis-2-border {
    border-left: 8px solid var(--cyan, #22bfd7) !important;
  }

  .triad-step-card.axis-3-border {
    border-left: 8px solid var(--coral, #f38469) !important;
  }

  .triad-step-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 0.9rem;
    border-bottom: 1.5px dashed var(--line, #eee4c8);
    padding-bottom: 0.75rem;
  }

  .triad-pill-badge {
    font-size: 0.8rem;
    font-weight: 900;
    font-family: var(--md-code-font, monospace);
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
    border: 1.5px solid var(--ink, #151b20);
    box-shadow: 1.5px 1.5px 0 var(--ink, #151b20);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .triad-title-block {
    flex: 1;
    min-width: 200px;
  }

  .triad-title {
    font-size: 1.2rem;
    font-weight: 900;
    color: var(--ink, #151b20);
    margin: 0 0 0.2rem 0;
  }

  .triad-archetype-tag {
    font-size: 0.78rem;
    font-family: var(--md-code-font, monospace);
    font-weight: 700;
    color: var(--ink-light, #242c33);
  }

  .triad-kpi-chip {
    background: var(--paper, #fffaf0);
    border: 1.5px solid var(--ink, #151b20);
    border-radius: 6px;
    padding: 0.35rem 0.65rem;
    font-size: 0.8rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    box-shadow: 1.5px 1.5px 0 var(--ink, #151b20);
  }

  .kpi-chip-label {
    color: var(--ink-light, #242c33);
    font-size: 0.72rem;
    text-transform: uppercase;
    font-family: var(--md-code-font, monospace);
  }

  .kpi-chip-val {
    color: var(--ink, #151b20);
    font-weight: 900;
    font-family: var(--md-code-font, monospace);
  }

  .triad-step-body p {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--ink-light, #242c33);
    margin: 0;
  }

  .triad-specs-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.85rem;
    padding-top: 0.75rem;
    border-top: 1px dashed var(--line, #eee4c8);
    font-size: 0.8rem;
  }

  .triad-spec-item {
    background: var(--paper-deep, #eee4c8);
    border: 1px solid var(--ink, #151b20);
    border-radius: 4px;
    padding: 0.25rem 0.55rem;
    font-size: 0.75rem;
    font-family: var(--md-code-font, monospace);
  }

  .triad-connector {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0.75rem 0;
  }

  /* Archetype Preview Deck */
  .archetype-preview-deck {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
    margin-top: 1.25rem;
  }

  .arch-preview-item {
    background: #ffffff;
    border: 2px solid var(--ink, #151b20);
    border-radius: 10px;
    box-shadow: 3px 3px 0 var(--ink, #151b20);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .arch-preview-item h4 {
    font-size: 1rem;
    font-weight: 900;
    color: var(--ink, #151b20);
    margin: 0;
  }

  .arch-preview-item p {
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--ink-light, #242c33);
    margin: 0;
  }

  .api-num {
    font-size: 0.7rem;
    font-weight: 900;
    font-family: var(--md-code-font, monospace);
    background: var(--paper-deep, #eee4c8);
    border: 1px solid var(--ink, #151b20);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    display: inline-block;
    width: fit-content;
  }

  @media (max-width: 768px) {
    .concept-step-card {
      padding: 1.15rem;
    }

    .aw-controls {
      flex-direction: column;
      align-items: stretch;
    }

    .aw-btn {
      width: 100%;
      text-align: left;
    }

    .archetype-preview-deck {
      grid-template-columns: 1fr;
    }

    .primitive-card {
      padding: 1.05rem;
      gap: 0.65rem;
    }

    .prim-card-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.4rem;
    }
  }

  /* ============================================================ */
  /* Section 2: Four Archetypes, Ladder & Deep-Dive Styling      */
  /* ============================================================ */
  .arch-ladder {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-bottom: 2rem;
  }

  .ladder-step {
    background: var(--paper, #fffaf0);
    border: 2px solid var(--ink, #151b20);
    border-radius: 12px;
    box-shadow: 4px 4px 0 var(--ink, #151b20);
    padding: 1.75rem;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .ladder-step:hover {
    transform: translateY(-2px);
    box-shadow: 6px 6px 0 var(--ink, #151b20);
  }

  .ladder-step.archetype-coral-border {
    border-left: 8px solid var(--coral, #f38469) !important;
  }

  .ladder-step.archetype-teal-border {
    border-left: 8px solid var(--teal, #0d9488) !important;
  }

  .ladder-step.archetype-lime-border {
    border-left: 8px solid var(--lime, #b7df69) !important;
  }

  .ladder-step.archetype-yellow-border {
    border-left: 8px solid var(--yellow, #ffc83e) !important;
  }

  .ladder-header {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    margin-bottom: 1.25rem;
  }

  .ladder-num-badge {
    font-size: 1.35rem;
    font-weight: 900;
    font-family: var(--md-code-font, monospace);
    width: 48px;
    height: 48px;
    border-radius: 10px;
    border: 2px solid var(--ink, #151b20);
    box-shadow: 2px 2px 0 var(--ink, #151b20);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .ladder-title-wrap {
    flex: 1;
  }

  .ladder-eyebrow {
    font-size: 0.72rem;
    font-weight: 900;
    font-family: var(--md-code-font, monospace);
    letter-spacing: 0.04em;
    color: var(--ink-light, #242c33);
    margin-bottom: 0.25rem;
    text-transform: uppercase;
  }

  .ladder-title {
    font-size: 1.35rem;
    font-weight: 900;
    color: var(--ink, #151b20);
    margin: 0;
    line-height: 1.3;
  }

  .ladder-body {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .ladder-summary-bar {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0.75rem;
    margin-top: 0.5rem;
    background: #ffffff;
    border: 1.5px solid var(--ink, #151b20);
    border-radius: 8px;
    padding: 0.75rem 1rem;
    box-shadow: 2px 2px 0 var(--ink, #151b20);
  }

  .ladder-metric {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .lm-lbl {
    font-size: 0.7rem;
    font-weight: 800;
    font-family: var(--md-code-font, monospace);
    color: #242c33;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .lm-val {
    font-size: 0.88rem;
    font-weight: 800;
    color: var(--ink, #151b20);
  }

  .ladder-connector {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0.85rem 0;
  }

  .connector-line {
    width: 0;
    height: 14px;
    border-left: 2px solid var(--ink, #151b20);
  }

  .connector-pill {
    background: var(--paper-deep, #eee4c8);
    border: 1.5px solid var(--ink, #151b20);
    border-radius: 999px;
    box-shadow: 2px 2px 0 var(--ink, #151b20);
    padding: 0.35rem 1rem;
    font-size: 0.76rem;
    font-weight: 800;
    color: var(--ink, #151b20);
    text-align: center;
    max-width: 90%;
  }

  .archetype-coral-border {
    border-top: 5px solid var(--coral, #f38469) !important;
  }

  .archetype-teal-border {
    border-top: 5px solid var(--teal, #0d9488) !important;
  }

  .archetype-lime-border {
    border-top: 5px solid var(--lime, #b7df69) !important;
  }

  .archetype-yellow-border {
    border-top: 5px solid var(--yellow, #ffc83e) !important;
  }

  .concept-stream {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .sub-topic-card {
    background: #ffffff;
    border: 1.5px solid var(--ink, #151b20);
    border-radius: 10px;
    padding: 1.5rem;
    box-shadow: 3px 3px 0 var(--ink, #151b20);
    margin-bottom: 1.5rem;
  }

  .sub-topic-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.85rem;
    padding-bottom: 0.5rem;
    border-bottom: 1.5px dashed var(--line, #eee4c8);
    flex-wrap: nowrap;
  }

  .sub-topic-title-group {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    min-width: 0;
    flex: 1;
  }

  .sub-topic-title {
    font-size: 1.12rem;
    font-weight: 900;
    color: var(--ink, #151b20);
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sub-topic-spec-badge {
    font-size: 0.75rem;
    font-weight: 800;
    font-family: var(--md-code-font, monospace);
    background: var(--paper-deep, #eee4c8);
    color: var(--ink, #151b20);
    border: 1px solid var(--ink, #151b20);
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .pill-badge {
    font-size: 0.72rem;
    font-weight: 900;
    font-family: var(--md-code-font, monospace);
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    border: 1px solid var(--ink, #151b20);
  }

  .concept-list {
    margin: 0 0 1.25rem 0;
    padding-left: 1.25rem;
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--ink-light, #151b20);
  }

  .concept-list li {
    margin-bottom: 0.5rem;
  }


  /* ============================================================ */
  /* Section 3: Common Architectural DNA (Similarities)          */
  /* ============================================================ */
  .similarities-grid {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .sim-card {
    background: #ffffff;
    border: 2px solid var(--ink, #151b20);
    border-radius: 12px;
    box-shadow: 3px 3px 0 var(--ink, #151b20);
    padding: 1.35rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .sim-card.sim-isa { border-left: 6px solid var(--teal, #0d9488); }
  .sim-card.sim-mmode { border-left: 6px solid var(--purple, #8275e8); }
  .sim-card.sim-abi { border-left: 6px solid var(--yellow, #ffc83e); }
  .sim-card.sim-bench { border-left: 6px solid var(--lime, #b7df69); }

  .sim-header {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .sim-num {
    font-size: 1rem;
    font-weight: 900;
    font-family: var(--md-code-font, monospace);
    width: 36px;
    height: 36px;
    border-radius: 8px;
    border: 1.5px solid var(--ink, #151b20);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .sim-num.num-teal { background: var(--teal, #0d9488); color: #ffffff; }
  .sim-num.num-purple { background: var(--purple, #8275e8); color: #ffffff; }
  .sim-num.num-yellow { background: var(--yellow, #ffc83e); color: var(--ink, #151b20); }
  .sim-num.num-lime { background: var(--lime, #b7df69); color: var(--ink, #151b20); }

  .sim-header h4 {
    font-size: 1.15rem;
    font-weight: 900;
    color: var(--ink, #151b20);
    margin: 0;
  }

  .sim-lead {
    font-size: 0.92rem;
    color: var(--ink-light, #242c33);
    line-height: 1.55;
    margin: 0;
  }

  .sim-points-stack {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    margin-top: 0.25rem;
  }

  .sim-point-row {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 0.85rem;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--ink-light, #242c33);
    background: var(--paper, #fffaf0);
    padding: 0.6rem 0.85rem;
    border-radius: 6px;
    border: 1px solid var(--line, #eee4c8);
    align-items: baseline;
  }

  .point-badge {
    font-weight: 800;
    font-family: var(--md-code-font, monospace);
    font-size: 0.82rem;
    color: var(--ink, #151b20);
    text-transform: uppercase;
  }

  .point-desc {
    color: var(--ink-light, #242c33);
  }

  @media (max-width: 680px) {
    .sim-point-row {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }
  }


  /* ============================================================ */
  /* Section 4: Microarchitectural Differences & Matrix Styling   */
  /* ============================================================ */
  .diff-cards-deck {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  .diff-spec-card {
    background: #ffffff;
    border: 2px solid var(--ink, #151b20);
    border-radius: 12px;
    box-shadow: 3px 3px 0 var(--ink, #151b20);
    padding: 1.35rem 1.5rem;
    display: flex;
    flex-direction: column;
