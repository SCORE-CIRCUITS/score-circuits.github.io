---
import BaseLayout from "../../layouts/BaseLayout.astro";

const updates = [
  {
    version: "v2.1",
    date: "November 2026",
    title: "Complete 51-Tool Architecture Directory & Neo-Brutalist Redesign",
    summary: "Rebuilt the entire SCORE documentation platform using Astro and the Warm Paper & Ink Neo-Brutalist design tokens from the dataset-fundamentals course website. Added deep-dive architectural walkthroughs and reproduction commands for all 51 open-source tools across Categories 1 to 4.",
    items: [
      "Generated dedicated architectural profile pages for all 51 tools in tools/.",
      "Integrated 4-tier benchmark leaderboards with one-click LaTeX code export for CSUR survey authoring.",
      "Embedded paper figures gallery highlighting vector utilization collapse and manycore barrier bottlenecks.",
      "Unified repository search across ISAs, bus protocols, licenses, and hardware description languages."
    ]
  },
  {
    version: "v2.0",
    date: "November 2026",
    title: "Category 3 & 4 Empirical Benchmark Aggregation",
    summary: "Integrated cycle-accurate Verilator benchmarking logs for Ara (RVV 1.0), AraXL, Cheshire SoC, MemPool 256-core scratchpad cluster, and Snitch.",
    items: [
      "Executed 44 automated benchmark runs across matrix multiplication, 2D convolution, FFT, softmax, and 1D/2D DMA.",
      "Quantified the vector utilization collapse phenomenon on reduction kernels.",
      "Measured sustained DMA throughput and MMIO configuration latency on Cheshire SoC."
    ]
  },
  {
    version: "v1.5",
    date: "October 2026",
    title: "Literature Taxonomy & Architecture Ingestion",
    summary: "Indexed 46 open-source processor architectures and surveyed papers from IEEE TVLSI, IEEE TC, IEEE Micro, and ACM DAC.",
    items: [
      "Established the four-tier architectural taxonomy (MCU, 64-bit App, Vector, Full SoC).",
      "Created structured paper analysis digests and source notes.",
      "Audited silicon tapeouts spanning TSMC 16nm, GlobalFoundries 22FDX, and open-source SkyWater 130nm PDKs."
    ]
  },
  {
    version: "v1.0",
    date: "September 2026",
    title: "Initial SCORE Platform Launch",
    summary: "Initial open hardware evaluation harness uniting scalar RISC-V microcontroller cores under a common Verilator testbed.",
    items: [
      "Standardized baremetal CoreMark and Dhrystone evaluation scripts.",
      "Curated initial baseline cores: SERV, PicoRV32, Ibex, and SCR1."
    ]
  }
];
---

<BaseLayout
  title="Platform Updates"
  activeTab="updates"
  description="Changelog, release milestones, and platform development history for the SCORE benchmark repository."
>
  <div class="page-header">
    <div class="badge badge-primary">CHANGELOG &amp; MILESTONES</div>
    <h1 class="page-title">Platform Updates</h1>
    <p class="page-lead">
      Development timeline and release milestones for the SCORE open-source RISC-V survey and benchmarking platform.
    </p>
  </div>

  <div class="updates-timeline">
    {updates.map((up) => (
      <div class="update-card">
        <div class="update-header">
          <div class="ver-tag">{up.version}</div>
          <div class="update-date">{up.date}</div>
        </div>

        <h2 class="update-title">{up.title}</h2>
        <p class="update-summary">{up.summary}</p>

        <ul class="update-list">
          {up.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</BaseLayout>

<style>
  .page-header {
    background: #ffffff;
    border: var(--noc-border-heavy, 3px solid #1a1a1a);
    box-shadow: var(--noc-shadow-heavy, 6px 6px 0 #1a1a1a);
    padding: 2.5rem;
    margin-bottom: 2rem;
  }

  .page-title {
    font-size: 2.5rem;
    font-weight: 900;
    margin-top: 0.5rem;
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
  }

  .page-lead {
    font-size: 1.15rem;
    color: #444444;
    line-height: 1.6;
    max-width: 850px;
    margin: 0;
  }

  .updates-timeline {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-bottom: 3rem;
  }

  .update-card {
    background: #ffffff;
    border: var(--noc-border, 2px solid #1a1a1a);
    box-shadow: var(--noc-shadow, 4px 4px 0 #1a1a1a);
    padding: 2rem;
  }

  .update-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .ver-tag {
    background: #ffde59;
    border: 2px solid #1a1a1a;
    font-weight: 900;
    font-size: 0.9rem;
    padding: 0.25rem 0.65rem;
    font-family: var(--noc-font-mono, monospace);
  }

  .update-date {
    font-size: 0.85rem;
    font-weight: 700;
    color: #666666;
  }

  .update-title {
    font-size: 1.6rem;
    font-weight: 900;
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }

  .update-summary {
    font-size: 1rem;
    line-height: 1.6;
    color: #333333;
    margin-bottom: 1.25rem;
  }

  .update-list {
    margin: 0 0 0 1.25rem;
    padding: 0;
  }

  .update-list li {
    font-size: 0.92rem;
    line-height: 1.6;
    margin-bottom: 0.4rem;
    color: #222222;
  }
</style>

