    <!-- DOSSIER: MATRIX ENGINE (IME) -->
    <div id="core-matrix-extensions" class="core-dossier-card">
      <div class="dossier-header">
        <div class="dossier-badge-row">
          <span class="badge badge-yellow">ARCHETYPE 7</span>
