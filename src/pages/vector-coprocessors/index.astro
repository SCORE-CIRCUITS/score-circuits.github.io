  <!-- CLIENT JAVASCRIPT LOGIC                                                   -->
  <!-- ========================================================================= -->
  <script>
    // 1. Copy LaTeX
    document.querySelectorAll(".copy-latex-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const targetId = btn.getAttribute("data-target");
        const box = document.getElementById(targetId || "");
        if (box) {
          const isShown = box.style.display === "block";
          box.style.display = isShown ? "none" : "block";
          if (!isShown) {
            const code = box.querySelector("code")?.textContent || "";
            navigator.clipboard.writeText(code).then(() => {
              const orig = btn.textContent;
              btn.textContent = "Copied to Clipboard!";
              setTimeout(() => { btn.textContent = orig; }, 2000);
            });
          }
        }
      });
    });

    document.querySelectorAll(".close-latex-btn").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        const parent = (e.target as HTMLElement).closest(".latex-export-box") as HTMLElement;
        if (parent) parent.style.display = "none";
      });
    });

    // 2. Interactive Vector EDA Workbench
    const awVectorData: Record<string, { latency: string; blocks: string; impact: string; desc: string; tradeoff: string }> = {
      lane_scaling: {
        latency: "14.08M → 3.52M Cycles (4× Speedup)",
        blocks: "Host CVA6 → Sequencer → 4× Parallel FPUs → AXI4 128b",
        impact: "Scales to 8 FLOPS/Cycle (Peak SIMD Saturation)",
        desc: "<strong>Lane Scaling Mechanics:</strong> Scaling from 1 lane to 4 lanes (Ara) or 8 lanes (AraXL) multiplies spatial arithmetic capacity without increasing instruction-fetch bandwidth. A single <code>vfmacc.vv</code> issued by the host CPU drives all active lanes simultaneously, executing identical micro-operations on independent element slices.",
        tradeoff: "<strong>Silicon Trade-off:</strong> Datapath area grows linearly with lane count (~45 kGE per lane), while memory crossbar routing complexity and area grow as \(O(N^2)\). Without clustered multi-banked VRFs (such as AraXL), wide lane crossbars rapidly become timing critical paths."
      },
      vrf_conflict: {
        latency: "2 – 4 Clock Cycle Hazard Stall Bubble",
        blocks: "Sequencer Operand Request → SRAM Bank Arbiter → FPU Pipeline Freeze",
        impact: "Throughput drops by 35–50% during multi-operand bank collisions",
        desc: "<strong>VRF Multi-Banking Conflict Mechanics:</strong> A vector register file is physically partitioned into \(B\) independent banks (e.g. 8 banks in Ara). When instruction A attempts to read operand vector <code>v1</code> from Bank 2 while instruction B attempts to write vector <code>v4</code> to Bank 2 in the same cycle, an arbitration stall is injected, freezing execution lanes.",
        tradeoff: "<strong>Silicon Trade-off:</strong> Increasing the bank count from 4 to 16 eliminates conflicts but multiplies address decoders and routing multiplexers by 3.2×, consuming valuable silicon area."
      },
      vector_chaining: {
        latency: "0-Cycle Bubble Latency (Seamless Pipeline Overlap)",
        blocks: "FPU Lane 0 Output → Forwarding Multiplexer → ALU Lane 0 Input (Hit-Under-Flight)",
        impact: "Up to 1.85× speedup on fused multiply-add and reduction sequences",
        desc: "<strong>Vector Chaining Mechanics:</strong> Chaining allows instruction 2 (e.g. <code>vfadd</code>) to consume result elements of instruction 1 (e.g. <code>vfmul</code>) as soon as the first element emerges from the pipeline, rather than waiting for all \(VLEN/SEW\) elements of the entire vector to retire back to the VRF.",
        tradeoff: "<strong>Silicon Trade-off:</strong> Requires fine-grained element hazard scoreboards and inter-functional forwarding multiplexers, adding ~8% control logic overhead."
      },
      strided_memory: {
        latency: "12 – 36 Cycle Serialization Penalty",
        blocks: "VLSU AGU → Strided Address Generator → Serialized Memory Requests → Crossbar",
        impact: "Bandwidth collapses by 75%+ compared to continuous unit-stride bursts",
        desc: "<strong>Strided &amp; Gather/Scatter Bottleneck:</strong> Unit-stride vector memory operations transfer full 128-bit/256-bit cache lines in burst mode. Strided and indexed gather instructions force the VLSU to generate individual non-contiguous addresses, fragmenting bus bursts into serialized single-word queries.",
        tradeoff: "<strong>Silicon Trade-off:</strong> Supporting non-blocking multi-word gather units requires complex Miss Status Holding Registers (MSHRs) and crossbar arbiters, increasing VLSU area by 2.4×."
      },
      dae_streaming: {
        latency: "100% Lane Saturation (Sustained 1 MAC / cycle per lane)",
        blocks: "Autonomous Stream AGU → Prefetch FIFO → Register File Bypass → Execution PE",
        impact: "Eliminates scalar host issue bottleneck; restores utilization from 23% to 90%+",
        desc: "<strong>Decoupled Access-Execute &amp; SSR:</strong> DAE separates memory address generation from computing lanes. Autonomous Stream Semantic Registers (SSR) map streaming memory coordinates directly to hardware registers. A single hardware repeat loop (<code>FREP</code>) issues compute instructions without host scalar core intervention.",
        tradeoff: "<strong>Silicon Trade-off:</strong> Autonomous hardware AGUs require dedicated control counters and stride configuration registers (~15 kGE per stream channel) but resolve the vector coprocessor utilization collapse."
      }
    };

    const awButtons = document.querySelectorAll(".aw-btn");
    const elLatency = document.getElementById("awLatency");
    const elBlocks = document.getElementById("awBlocks");
    const elImpact = document.getElementById("awImpact");
    const elDesc = document.getElementById("awDesc");
    const elTradeoff = document.getElementById("awTradeoff");

    awButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        awButtons.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        const scenarioKey = btn.getAttribute("data-scenario");
        if (scenarioKey && awVectorData[scenarioKey]) {
          const item = awVectorData[scenarioKey];
          if (elLatency) elLatency.textContent = item.latency;
          if (elBlocks) elBlocks.textContent = item.blocks;
          if (elImpact) elImpact.textContent = item.impact;
          if (elDesc) elDesc.innerHTML = item.desc;
          if (elTradeoff) elTradeoff.innerHTML = item.tradeoff;
        }
      });
    });

    // 3. Filter Taxonomy Matrix by Domain
    const filterBtns = document.querySelectorAll(".matrix-filter-btn");
    const matrixRows = document.querySelectorAll("#matrix-table tbody tr");

    filterBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        filterBtns.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        const tier = btn.getAttribute("data-tier");

        matrixRows.forEach((row) => {
          const rowTier = row.getAttribute("data-tier");
          if (tier === "all" || rowTier === tier) {
            (row as HTMLElement).style.display = "";
          } else {
            (row as HTMLElement).style.display = "none";
          }
        });
      });
    });

    // 4. Master Leaderboard Filter, Search, and Sort
    const lbTable = document.getElementById("masterLeaderboardTable");
    if (lbTable) {
      const lbTbody = lbTable.querySelector("tbody");
      const lbFilterPills = document.querySelectorAll(".lb-pill");
      const lbSearchInput = document.getElementById("lbSearchInput") as HTMLInputElement | null;
      const lbClearSearch = document.getElementById("lbClearSearch") as HTMLButtonElement | null;
      const lbSortSelect = document.getElementById("lbSortSelect") as HTMLSelectElement | null;
      const lbVisibleCount = document.getElementById("lbVisibleCount");

      let currentFilter = "all";
      let currentQuery = "";
      let currentSort = "rank";

      function updateTable() {
        if (!lbTbody) return;
        const rows = Array.from(lbTbody.querySelectorAll("tr"));
        let visible = 0;

        rows.forEach((row) => {
          const cat = row.getAttribute("data-cat") || "";
          const search = row.getAttribute("data-search") || "";

          const matchesFilter = currentFilter === "all" || cat === currentFilter;
          const matchesQuery = !currentQuery || search.includes(currentQuery.toLowerCase());

          if (matchesFilter && matchesQuery) {
            row.style.display = "";
            visible++;
          } else {
            row.style.display = "none";
          }
        });

        if (lbVisibleCount) lbVisibleCount.textContent = visible.toString();

        // Sort visible rows
        rows.sort((a, b) => {
          if (currentSort === "rank") {
            const rA = parseInt(a.getAttribute("data-rank") || "0", 10);
            const rB = parseInt(b.getAttribute("data-rank") || "0", 10);
            return rA - rB;
          } else if (currentSort === "ops-desc") {
            const oA = parseFloat(a.getAttribute("data-ops") || "0");
            const oB = parseFloat(b.getAttribute("data-ops") || "0");
            return oB - oA;
          } else if (currentSort === "util-desc") {
            const uA = parseFloat(a.getAttribute("data-util") || "0");
            const uB = parseFloat(b.getAttribute("data-util") || "0");
            return uB - uA;
          } else if (currentSort === "cycles-asc") {
            const cA = parseInt(a.getAttribute("data-cycles") || "0", 10);
            const cB = parseInt(b.getAttribute("data-cycles") || "0", 10);
            return cA - cB;
          }
          return 0;
        });

        rows.forEach((r) => lbTbody.appendChild(r));
      }

      lbFilterPills.forEach((pill) => {
        pill.addEventListener("click", () => {
          lbFilterPills.forEach((p) => p.classList.remove("active"));
          pill.classList.add("active");
          currentFilter = pill.getAttribute("data-filter") || "all";
          updateTable();
        });
      });

      if (lbSearchInput) {
        lbSearchInput.addEventListener("input", () => {
          currentQuery = lbSearchInput.value.trim();
          if (lbClearSearch) {
            lbClearSearch.style.display = currentQuery ? "block" : "none";
          }
          updateTable();
        });
      }

      if (lbClearSearch && lbSearchInput) {
        lbClearSearch.addEventListener("click", () => {
          lbSearchInput.value = "";
          currentQuery = "";
          lbClearSearch.style.display = "none";
          updateTable();
        });
      }

      if (lbSortSelect) {
        lbSortSelect.addEventListener("change", () => {
          currentSort = lbSortSelect.value;
          updateTable();
        });
      }
    }
  </script>

