              <tr><th>Workload</th><th>Type</th><th>Cycles</th><th>Ops / Cycle</th><th>Utilization %</th><th>Evidence Source</th></tr>
            </thead>
            <tbody>
              <tr><td><code>fconv2d</code></td><td><code>INT32</code></td><td>89,752</td><td><strong>0.181</strong></td><td><span class='badge badge-coral'>18.05%</span></td><td>score_measured (Vtb_top)</td></tr><tr><td><code>fmatmul</code></td><td><code>INT32</code></td><td>370,008</td><td><strong>0.177</strong></td><td><span class='badge badge-coral'>17.71%</span></td><td>score_measured (Vtb_top)</td></tr><tr><td><code>fdotproduct</code></td><td><code>INT32</code></td><td>84,918</td><td><strong>0.024</strong></td><td><span class='badge badge-coral'>2.41%</span></td><td>score_measured (Vtb_top)</td></tr>
            </tbody>
          </table>
        </div>

        <!-- Reproduction Commands Box -->
        <div class="dossier-repro-box" style="background: #151b20; padding: 0.75rem 1rem; border-radius: 6px; margin-bottom: 1.25rem;">
          <div style="font-size: 0.72rem; font-weight: 800; color: #94a3b8; font-family: monospace; margin-bottom: 0.35rem;">REPRODUCTION / SIMULATION COMMAND:</div>
          <code style="font-size: 0.78rem; color: #38bdf8; font-family: monospace; word-break: break-all;">./scripts/benchmarks/run_cv32e40p_benchmarks.sh</code>
        </div>

        <!-- Pros & Cons -->
        <div class="dossier-pros-cons">
          <div class="pros-box">
            <strong>Key Strengths:</strong>
            <ul><li>Zero vector register state overhead; adds only ~6 kGE over base scalar core.</li><li>Hardware loops eliminate branch overhead on inner loops.</li><li>Extensively verified and silicon-proven across multiple foundry nodes.</li></ul>
