            </thead>
            <tbody>
              <tr><td><code>tile_gemm_int8</code></td><td><code>INT8</code></td><td>16,384</td><td><strong>128.00</strong></td><td><span class='badge badge-green'>87.50%</span></td><td>literature_reported (ISCA 2023)</td></tr><tr><td><code>tile_gemm_fp16</code></td><td><code>FP16</code></td><td>32,768</td><td><strong>64.00</strong></td><td><span class='badge badge-green'>85.00%</span></td><td>literature_reported (DATE 2024)</td></tr>
            </tbody>
          </table>
        </div>

        <!-- Reproduction Commands Box -->
        <div class="dossier-repro-box" style="background: var(--cream, #fffaf0); border: 1.5px solid var(--ink, #151b20); padding: 0.75rem 1rem; border-radius: 6px; margin-bottom: 1.25rem; box-shadow: 2px 2px 0 var(--ink, #151b20);"><div style="font-size: 0.72rem; font-weight: 800; color: var(--ink, #151b20); font-family: var(--md-code-font, monospace); margin-bottom: 0.35rem;">REPRODUCTION / SIMULATION COMMAND:</div><code style="font-size: 0.78rem; color: var(--ink, #151b20); font-weight: 700; font-family: var(--md-code-font, monospace); word-break: break-all;">./scripts/generate_matrix_extensions.sh</code></div>

        <!-- Pros & Cons -->
        <div class="dossier-pros-cons">
          <div class="pros-box">
            <strong>Key Strengths:</strong>
            <ul><li>128 Ops/cycle peak throughput on quantized INT8 matrix multiplications.</li><li>Outer-product dataflow eliminates register file read port bottlenecks.</li><li>Maintains backward compatibility with standard 1D vector instructions.</li></ul>
