      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .ladder-banner-tag {
      font-size: 0.75rem;
      font-weight: 900;
      font-family: var(--md-code-font, monospace);
      color: #9a3412;
    }

    .ladder-banner-txt {
      font-size: 0.82rem;
      font-weight: 800;
      font-family: var(--md-code-font, monospace);
      color: var(--ink, #151b20);
    }

    .boom-step-card {
      background: #ffffff;
      border: 2px solid var(--ink, #151b20);
      border-radius: 10px;
      box-shadow: 3px 3px 0 var(--ink, #151b20);
      padding: 1.15rem;
    }

    .boom-step-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 0.75rem;
      margin-bottom: 0.6rem;
      border-bottom: 1px dashed var(--line, #eee4c8);
      padding-bottom: 0.5rem;
    }

    .boom-step-badge {
      font-size: 0.72rem;
      font-weight: 900;
      font-family: var(--md-code-font, monospace);
      padding: 0.2rem 0.55rem;
      border-radius: 4px;
      border: 1.5px solid var(--ink, #151b20);
    }

    .boom-step-title-wrap {
      flex: 1;
      min-width: 220px;
    }

    .boom-step-title {
      font-size: 1.1rem;
      font-weight: 900;
      color: var(--ink, #151b20);
      margin: 0 0 0.15rem 0;
    }

    .boom-step-sub {
      font-size: 0.75rem;
      font-family: var(--md-code-font, monospace);
      font-weight: 700;
      color: var(--ink-light, #242c33);
    }

    .boom-step-metrics {
      display: flex;
      gap: 0.4rem;
    }

    .boom-step-desc {
      font-size: 0.85rem;
      line-height: 1.5;
      color: var(--ink-light, #242c33);
      margin: 0;
    }

    .boom-connector {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      padding: 0.25rem 0;
    }

    /* Paradigm Comparison Grid */
    .paradigm-compare-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 1.25rem;
      margin-bottom: 1.5rem;
    }

    .paradigm-col {
      background: #ffffff;
      border: 2px solid var(--ink, #151b20);
      border-radius: 10px;
      box-shadow: 3px 3px 0 var(--ink, #151b20);
      overflow: hidden;
    }

    .paradigm-header {
      padding: 1rem 1.25rem;
      border-bottom: 2px solid var(--ink, #151b20);
    }

    .p-badge {
      font-size: 0.75rem;
      font-weight: 900;
      font-family: var(--md-code-font, monospace);
      letter-spacing: 0.05em;
      padding: 0.25rem 0.65rem;
      border-radius: 6px;
      background: #ffffff;
      color: var(--ink, #151b20);
      border: 1.5px solid var(--ink, #151b20);
      box-shadow: 1.5px 1.5px 0 var(--ink, #151b20);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      margin-bottom: 0;
    }

    .p-title {
      font-size: 1.15rem;
      font-weight: 900;
      color: var(--ink, #151b20);
      margin: 0;
      letter-spacing: -0.01em;
    }

    .paradigm-header h4 {
      font-size: 1.15rem;
      font-weight: 900;
      color: var(--ink, #151b20);
      margin: 0 0 0.2rem 0;
    }

    .p-sub {
      font-size: 0.78rem;
      font-family: var(--md-code-font, monospace);
      font-weight: 800;
      color: #0284c7;
    }

    .paradigm-body {
      padding: 1.35rem;
      font-size: 0.92rem;
      line-height: 1.6;
      color: var(--ink-light, #242c33);
    }

    .paradigm-points {
      margin: 0.75rem 0 0 1.1rem;
      padding: 0;
    }

    .paradigm-points li {
      margin-bottom: 0.5rem;
    }

    /* KPI Summary Cards */
    .lb-kpi-summary-grid {
      display: flex;
      flex-direction: column;
      width: 100%;
      gap: 1rem;
      margin-bottom: 1.75rem;
    }

    .lb-kpi-card {
      border: 2px solid var(--ink, #151b20);
      border-radius: 10px;
      box-shadow: 3px 3px 0 var(--ink, #151b20);
      padding: 1.15rem;
    }

    .lb-kpi-badge {
      font-size: 0.7rem;
      font-weight: 900;
      font-family: var(--md-code-font, monospace);
      padding: 0.2rem 0.5rem;
      border-radius: 4px;
      border: 1.2px solid var(--ink, #151b20);
      display: inline-block;
      margin-bottom: 0.65rem;
    }

    .lb-kpi-val {
      font-size: 1.85rem;
      font-weight: 900;
      font-family: var(--md-code-font, monospace);
      line-height: 1.1;
      margin-bottom: 0.35rem;
    }

    .lb-kpi-unit {
      font-size: 0.9rem;
      font-weight: 800;
      color: #64748b;
    }

    .lb-kpi-core {
      font-size: 0.92rem;
      font-weight: 900;
      color: var(--ink, #151b20);
      margin-bottom: 0.25rem;
    }

    .lb-kpi-meta {
      font-size: 0.78rem;
      color: #64748b;
    }

    /* Leaderboard Controls */
    .lb-toolbar {
      background: #f6f0dc;
      border: 2px solid var(--ink, #151b20);
      border-radius: 10px;
      padding: 1rem;
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
      margin-bottom: 0.75rem;
    }

    .lb-filter-pills {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
    }

    .lb-pill {
      font-size: 0.78rem;
      font-weight: 800;
      font-family: var(--md-code-font, monospace);
      background: #ffffff;
      color: var(--ink, #151b20);
      border: 1.5px solid var(--ink, #151b20);
      border-radius: 5px;
      padding: 0.3rem 0.65rem;
      cursor: pointer;
      box-shadow: 1px 1px 0 var(--ink, #151b20);
      transition: all 0.15s ease;
    }

    .lb-pill.active, .lb-pill:hover {
      background: #ffc83e;
      transform: translateY(-1px);
      box-shadow: 2px 2px 0 var(--ink, #151b20);
    }

    .lb-search-wrap {
      position: relative;
      display: flex;
    }

    .lb-search-input {
      width: 100%;
      font-size: 0.88rem;
      font-family: var(--md-code-font, monospace);
      padding: 0.45rem 2rem 0.45rem 0.75rem;
      border: 1.5px solid var(--ink, #151b20);
      border-radius: 6px;
      background: #ffffff;
      color: var(--ink, #151b20);
    }

    .lb-clear-btn {
      position: absolute;
      right: 0.5rem;
      top: 50%;
      transform: translateY(-50%);
      background: none;
      border: none;
      font-size: 1.2rem;
      font-weight: 900;
      cursor: pointer;
      color: #64748b;
    }

    .lb-sort-wrap {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .lb-sort-label {
      font-size: 0.8rem;
      font-weight: 900;
      font-family: var(--md-code-font, monospace);
      color: var(--ink, #151b20);
    }

    .lb-sort-select {
      font-size: 0.8rem;
      font-weight: 800;
      font-family: var(--md-code-font, monospace);
      padding: 0.35rem 0.75rem;
      border: 1.5px solid var(--ink, #151b20);
      border-radius: 5px;
      background: #ffffff;
      color: var(--ink, #151b20);
    }

    .lb-active-count-bar {
      font-size: 0.8rem;
      font-weight: 800;
      font-family: var(--md-code-font, monospace);
      color: #64748b;
      margin-bottom: 0.75rem;
    }

    /* Table Formatting */
    .table-wrap {
      overflow-x: auto;
      border: 2px solid var(--ink, #151b20);
      border-radius: 10px;
      box-shadow: 4px 4px 0 var(--ink, #151b20);
      background: #ffffff;
    }

    .data-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.85rem;
      text-align: left;
    }

    .data-table th {
      background: #f6f0dc;
      padding: 0.75rem 0.85rem;
      font-weight: 900;
      font-family: var(--md-code-font, monospace);
      color: var(--ink, #151b20);
      border-bottom: 2px solid var(--ink, #151b20);
      white-space: nowrap;
    }

    .data-table td {
      padding: 0.75rem 0.85rem;
      border-bottom: 1px solid var(--line, #eee4c8);
      border-right: 1px solid var(--line, #eee4c8);
      vertical-align: middle;
    }

    .data-table tr:hover {
      background: #fffdfa;
    }

    .lb-rank-badge {
      font-size: 0.75rem;
      font-weight: 900;
      font-family: var(--md-code-font, monospace);
      padding: 0.2rem 0.45rem;
      border-radius: 4px;
      border: 1.2px solid var(--ink, #151b20);
      display: inline-block;
    }

    .rank-gold { background: #ffc83e; color: #151b20; }
    .rank-silver { background: #e2e8f0; color: #151b20; }
    .rank-bronze { background: #fed7aa; color: #151b20; }
    .rank-norm { background: #ffffff; color: #64748b; }

    .lb-core-title {
      font-size: 0.92rem;
      font-weight: 900;
    }

    .core-link {
      color: var(--ink, #151b20);
      text-decoration: underline;
    }

    .lb-core-var {
      font-size: 0.75rem;
      font-weight: 700;
      color: #64748b;
      margin-left: 0.25rem;
    }

    .lb-core-meta {
      font-size: 0.72rem;
      color: #64748b;
      margin-top: 0.15rem;
    }

    .mini-score-bar-track {
      width: 80px;
      height: 6px;
      background: #e2e8f0;
      border-radius: 3px;
      margin-top: 0.25rem;
      overflow: hidden;
    }

    .mini-score-bar-fill {
      height: 100%;
      background: #e11d48;
      border-radius: 3px;
    }

    /* Collapse Bars */
    .collapse-bars {
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
    }

    .c-bar-item {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .c-lbl {
      width: 320px;
      font-size: 0.85rem;
      font-weight: 800;
      font-family: var(--md-code-font, monospace);
      color: var(--ink, #151b20);
      flex-shrink: 0;
    }

    .c-track {
      flex: 1;
      height: 24px;
      background: #e2e8f0;
      border: 1.5px solid var(--ink, #151b20);
      border-radius: 5px;
      overflow: hidden;
    }

    .c-fill {
      height: 100%;
      display: flex;
      align-items: center;
      padding-left: 0.65rem;
      font-size: 0.75rem;
      font-weight: 900;
      font-family: var(--md-code-font, monospace);
      color: #ffffff;
      white-space: nowrap;
    }

    .fill-green { background: #059669; }
    .fill-yellow { background: #d97706; }
    .fill-orange { background: #ea580c; }
    .fill-red { background: #dc2626; }

    .collapse-analysis-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 1.25rem;
      margin-top: 1.5rem;
    }

    .col-analysis-card {
      background: #ffffff;
      border: 1.5px solid var(--ink, #151b20);
      border-radius: 8px;
      padding: 1.15rem;
      font-size: 0.88rem;
      line-height: 1.55;
    }

    .col-analysis-card h4 {
      font-size: 1.05rem;
      font-weight: 900;
      color: var(--ink, #151b20);
      margin: 0 0 0.5rem 0;
    }

    /* Core Dossiers */
    .dossiers-container {
      max-width: 1200px;
      margin: 0 auto 4rem;
      padding: 0 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }

    .core-dossier-card {
      background: var(--cream, #fffaf0);
      border: 2px solid var(--ink, #151b20);
      border-radius: 14px;
      box-shadow: 5px 5px 0 var(--ink, #151b20);
      padding: 2rem;
    }

    .dossier-header {
      border-bottom: 2px solid var(--line, #eee4c8);
      padding-bottom: 1rem;
      margin-bottom: 1.25rem;
    }

    .dossier-badge-row {
      display: flex;
      gap: 0.4rem;
      margin-bottom: 0.5rem;
    }

    .dossier-title {
      font-size: 1.55rem;
      font-weight: 900;
      color: var(--ink, #151b20);
      margin: 0 0 0.25rem 0;
    }

    .dossier-sub {
      font-size: 0.82rem;
      font-family: var(--md-code-font, monospace);
      font-weight: 700;
      color: #64748b;
    }

    .dossier-specs-grid {
      display: flex;
      flex-direction: column;
      width: 100%;
      gap: 0.5rem;
      background: #fffdfa;
      border: 1.5px solid var(--ink, #151b20);
      border-radius: 8px;
      padding: 1rem;
      margin-bottom: 1.25rem;
    }

    .spec-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.35rem 0;
      border-bottom: 1px dashed var(--line, #eee4c8);
      gap: 0.75rem;
    }

    .spec-item:last-child {
      border-bottom: none;
    }

    .s-k {
      font-size: 0.72rem;
      font-weight: 900;
      font-family: var(--md-code-font, monospace);
      color: #64748b;
    }

    .s-v {
      font-size: 0.85rem;
      font-weight: 800;
      color: var(--ink, #151b20);
    }

    .dossier-body {
      font-size: 0.9rem;
      line-height: 1.6;
      color: var(--ink-light, #242c33);
    }

    .dossier-pros-cons {
      display: flex;
      flex-direction: column;
      width: 100%;
      gap: 0.85rem;
      margin: 1.25rem 0;
    }

    .pros-box, .cons-box {
      border: 1.5px solid var(--ink, #151b20);
      border-radius: 8px;
      padding: 1rem;
      font-size: 0.84rem;
    }

    .pros-box { background: #f0fdf4; }
    .cons-box { background: #fef2f2; }

    .pros-box ul, .cons-box ul {
      margin: 0.5rem 0 0 1.1rem;
      padding: 0;
    }

    .pros-box li, .cons-box li {
      margin-bottom: 0.35rem;
    }

    .dossier-links {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-top: 1.25rem;
    }

    .core-link-pill {
      font-size: 0.78rem;
      font-weight: 800;
      font-family: var(--md-code-font, monospace);
      background: #f6f0dc;
      color: var(--ink, #151b20);
      border: 1.5px solid var(--ink, #151b20);
      border-radius: 5px;
      padding: 0.3rem 0.75rem;
      text-decoration: none;
      box-shadow: 1px 1px 0 var(--ink, #151b20);
      transition: all 0.15s ease;
    }

    .core-link-pill:hover {
      background: #ffc83e;
      transform: translateY(-1px);
      box-shadow: 2px 2px 0 var(--ink, #151b20);
    }

    /* LaTeX Drawer */
    .latex-export-wrap {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }

    .copy-latex-btn {
      font-size: 0.82rem;
      font-weight: 800;
      font-family: var(--md-code-font, monospace);
      background: #ffffff;
      color: var(--ink, #151b20);
      border: 1.8px solid var(--ink, #151b20);
      border-radius: 6px;
      padding: 0.45rem 0.95rem;
      box-shadow: 2px 2px 0 var(--ink, #151b20);
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .copy-latex-btn:hover {
      background: #ffc83e;
      transform: translateY(-1px);
      box-shadow: 3px 3px 0 var(--ink, #151b20);
    }

    .latex-export-box {
      width: 100%;
      background: var(--paper, #f6f0dc);
      color: var(--ink, #151b20);
      border: 2px solid var(--ink, #151b20);
      border-radius: 8px;
      padding: 1rem;
      box-shadow: 4px 4px 0 var(--ink, #151b20);
    }

    .latex-export-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.75rem;
      font-size: 0.85rem;
      font-weight: 800;
      font-family: var(--md-code-font, monospace);
      color: var(--ink, #151b20);
    }

    .close-latex-btn {
      background: none;
      border: none;
      color: var(--ink, #151b20);
      font-size: 1.25rem;
      font-weight: 900;
      cursor: pointer;
    }

    .latex-code-pre {
      margin: 0;
      font-size: 0.75rem;
      line-height: 1.45;
      overflow-x: auto;
      font-family: var(--md-code-font, monospace);
    }

    /* Helpers */
    .text-coral { color: #e11d48; }
    .text-green { color: #059669; }
    .text-yellow { color: #d97706; }
    .text-blue { color: #0284c7; }
    .text-teal { color: #0d9488; }
    .text-purple { color: #7c3aed; }
    .text-red { color: #dc2626; }

    .matrix-filter-bar {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.45rem;
      margin-bottom: 0.75rem;
    }

    .matrix-filter-label {
      font-size: 0.8rem;
      font-weight: 900;
      font-family: var(--md-code-font, monospace);
      color: var(--ink, #151b20);
    }

    .matrix-filter-btn {
      font-size: 0.75rem;
      font-weight: 800;
      font-family: var(--md-code-font, monospace);
      background: #ffffff;
      color: var(--ink, #151b20);
      border: 1.5px solid var(--ink, #151b20);
      border-radius: 5px;
      padding: 0.25rem 0.6rem;
      cursor: pointer;
      box-shadow: 1px 1px 0 var(--ink, #151b20);
      transition: all 0.15s ease;
    }

    .matrix-filter-btn.active, .matrix-filter-btn:hover {
      background: #ffc83e;
      transform: translateY(-1px);
      box-shadow: 2px 2px 0 var(--ink, #151b20);
    }

    .ppa-breakdown-cards {
      display: flex;
      flex-direction: column;
      width: 100%;
      gap: 1.25rem;
      margin-top: 1rem;
    }

    .ppa-card {
      background: #ffffff;
      border: 2px solid var(--ink, #151b20);
      border-radius: 10px;
      box-shadow: 3px 3px 0 var(--ink, #151b20);
      padding: 1.25rem;
    }

    .ppa-card-title {
      font-size: 1.1rem;
      font-weight: 900;
      color: var(--ink, #151b20);
      margin: 0 0 0.5rem 0;
    }

    .ppa-card-desc {
      font-size: 0.86rem;
      line-height: 1.55;
      color: var(--ink-light, #242c33);
      margin: 0;
    }

    .paradigm-ladder-flow {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      margin-top: 1.5rem;
    }

    .paradigm-step-card {
      background: #ffffff;
      border: 2px solid var(--ink, #151b20);
      border-radius: 12px;
      box-shadow: 3px 3px 0 var(--ink, #151b20);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .paradigm-step-card:hover {
      transform: translateY(-2px);
      box-shadow: 4px 4px 0 var(--ink, #151b20);
    }

    .paradigm-step-head {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      flex-wrap: wrap;
      padding: 0.85rem 1.25rem;
      border-bottom: 2px solid var(--ink, #151b20);
    }

    .dossier-repro-box {
      background: var(--cream, #fffaf0);
      border-radius: 6px;
      padding: 0.75rem 1rem;
      margin-top: 1rem;
      border: 1.5px solid var(--ink, #151b20);
      box-shadow: 2px 2px 0 var(--ink, #151b20);
      overflow-x: auto;
    }

    .dossier-deep-dive {
      background: #f8fafc;
      border: 2px solid var(--ink, #151b20);
      border-left: 6px solid #3b82f6 !important;
      border-radius: 8px;
      box-shadow: 3px 3px 0 var(--ink, #151b20);
      padding: 1rem 1.25rem;
      margin-top: 0.75rem;
      margin-bottom: 1.25rem;
    }

    .callout {
      background: var(--paper, #fffaf0);
      border: 2px solid var(--ink, #151b20);
      border-radius: 12px;
      padding: 1.5rem;
      box-shadow: 4px 4px 0 var(--ink, #151b20);
      margin: 1.5rem 0;
    }

    .callout-header {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 0.65rem;
      flex-wrap: wrap;
    }

    .callout-title {
      font-size: 1.2rem;
      font-weight: 900;
      color: var(--ink, #151b20);
      margin: 0;
      letter-spacing: -0.01em;
    }

    .arch-features-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 1.25rem;
      margin-top: 1.25rem;
    }

    .feature-card {
      background: #ffffff;
      border: 2px solid var(--ink, #151b20);
      border-radius: 10px;
      box-shadow: 3px 3px 0 var(--ink, #151b20);
      padding: 1.25rem;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .feature-card:hover {
      transform: translateY(-2px);
