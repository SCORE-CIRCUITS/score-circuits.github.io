            <td>~500&ndash;1,200</td>
            <td><span class="badge badge-green">score_measured</span></td>
          </tr>
          <!-- Archetype 7 -->
          <tr data-tier="domain-b">
            <td><strong>Arch 7</strong></td>
            <td><strong>Vector-Matrix Hybrid</strong></td>
            <td>RISC-V IME, T-Head Matrix</td>
            <td><code>RV-IME / XuanTie Matrix</code></td>
            <td>2D ZA Matrix Tiles</td>
            <td>TileLink / AXI4</td>
            <td>64&ndash;256 BF16</td>
            <td>~400&ndash;850</td>
            <td><span class="badge badge-teal">spec_open_draft</span></td>
          </tr>
          <!-- Archetype 8 -->
          <tr data-tier="domain-c">
            <td><strong>Arch 8</strong></td>
            <td><strong>Many-Core SIMT (GPGPU)</strong></td>
            <td>Vortex GPGPU</td>
