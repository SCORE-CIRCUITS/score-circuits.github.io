      <!-- Specs Stack -->
      <div class="dossier-specs-grid">
        <div class="spec-item"><span class="s-k">ISA:</span><span class="s-v"><code>Hwacha Vector-Fetch (VT)</code></span></div>
        <div class="spec-item"><span class="s-k">Lanes:</span><span class="s-v">4 Parallel Lanes</span></div>
        <div class="spec-item"><span class="s-k">Vector Length:</span><span class="s-v">Multi-Bank Decoupled Queue</span></div>
