              <tr><th>Parameter</th><th>Default</th><th>Silicon Impact</th><th>Description</th></tr>
            </thead>
            <tbody>
              <tr><td><code>VLEN</code></td><td><code>128</code></td><td>Register Width</td><td>Standard 128-bit vector register file.</td></tr><tr><td><code>ELEN</code></td><td><code>32</code></td><td>Max Element Width</td><td>Supports 32-bit integer and single-precision FP32.</td></tr><tr><td><code>NrLanes</code></td><td><code>1</code></td><td>Compute Slices</td><td>Single lane with multi-cycle temporal sequencing.</td></tr><tr><td><code>MemWidth</code></td><td><code>128</code></td><td>Bus Bandwidth</td><td>128-bit memory port allows unit-stride bursts of 16&times;INT8 elements.</td></tr><tr><td><code>MulLatency</code></td><td><code>2</code></td><td>Pipeline Depth</td><td>Multiplier pipeline latency in clock cycles.</td></tr>
            </tbody>
          </table>
