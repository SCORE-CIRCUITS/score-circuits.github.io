    margin-bottom: 0.5rem;
  }

  .tool-title-link a {
    font-size: 1.15rem;
    font-weight: 900;
    color: #1a1a1a;
    text-decoration: none;
  }

  .tool-title-link a:hover {
    text-decoration: underline;
  }

  .tool-lang-pill {
    font-size: 0.72rem;
    font-family: var(--noc-font-mono, monospace);
    color: #666666;
  }

  .tool-desc-short {
    font-size: 0.85rem;
    color: #444444;
    line-height: 1.45;
    margin-bottom: 0.85rem;
    flex-grow: 1;
  }

  .tool-spec-table {
    background: #ffffff;
    border: 1px solid #dddddd;
    padding: 0.5rem;
    font-size: 0.78rem;
    margin-bottom: 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .tool-card-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .script-badge {
    font-size: 0.7rem;
    color: #0b6b38;
    font-weight: 700;
  }

  .latex-export-box {
    background: #1a1a1a;
    border: 2px solid #1a1a1a;
    padding: 1.25rem;
    margin-top: 1rem;
  }

  .latex-head {
    display: flex;
    justify-content: space-between;
    color: #ffde59;
    font-size: 0.85rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
  }

  .close-latex-btn {
    background: transparent;
    border: none;
    color: #ffffff;
    font-size: 1.25rem;
    cursor: pointer;
  }

  .latex-code {
    margin: 0;
    padding: 0;
    font-family: var(--noc-font-mono, monospace);
    font-size: 0.82rem;
    color: #a8ffb2;
    overflow-x: auto;
  }
</style>
