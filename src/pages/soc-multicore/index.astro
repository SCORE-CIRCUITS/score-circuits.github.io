  }

  .tools-grid-inline {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.25rem;
  }

  .tool-card-cat {
    background: #fafafa;
    border: 2px solid #1a1a1a;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    box-shadow: 3px 3px 0 #1a1a1a;
  }

