  // ==========================================
  // 4f. 2-BIT SATURATING COUNTER BPU WORKBENCH (FIG 4.3)
  // ==========================================
  let bpuState = 1; // 0: SNT, 1: WNT, 2: WT, 3: ST
  let bpuHistory = [];
  let bpuPredictions = 0;
  let bpuCorrect = 0;

  const nodeBpuSNT = document.getElementById("nodeBpuSNT");
  const nodeBpuWNT = document.getElementById("nodeBpuWNT");
  const nodeBpuWT = document.getElementById("nodeBpuWT");
  const nodeBpuST = document.getElementById("nodeBpuST");

  const bgBpuPredCard = document.getElementById("bgBpuPredCard");
  const txtBpuPredHeader = document.getElementById("txtBpuPredHeader");
  const txtBpuPredState = document.getElementById("txtBpuPredState");
  const txtBpuPredAction = document.getElementById("txtBpuPredAction");

  const svgBpuAccVal = document.getElementById("svgBpuAccVal");
  const svgBpuAccSub = document.getElementById("svgBpuAccSub");
  const svgBpuPenaltyVal = document.getElementById("svgBpuPenaltyVal");
  const svgBpuPenaltySub = document.getElementById("svgBpuPenaltySub");
  const svgBpuHysteresisNote = document.getElementById("svgBpuHysteresisNote");

  function stepBpu(branchTaken) {
    const predictedTaken = bpuState >= 2;
    const isCorrect = (branchTaken === predictedTaken);
    bpuPredictions++;
    if (isCorrect) bpuCorrect++;

    // Update 2-bit counter with saturation
    if (branchTaken) {
      if (bpuState < 3) bpuState++;
    } else {
      if (bpuState > 0) bpuState--;
    }

    bpuHistory.push({ taken: branchTaken, correct: isCorrect, stateAfter: bpuState });
    if (bpuHistory.length > 8) bpuHistory.shift();

    updateBpuWorkbench(isCorrect, branchTaken);
  }

  function updateBpuWorkbench(lastCorrect = true, lastTaken = false) {
    const nodes = [
      { el: nodeBpuSNT, id: 0, selCol: "#151b20" },
      { el: nodeBpuWNT, id: 1, selCol: "#ffd8ce" },
      { el: nodeBpuWT, id: 2, selCol: "#c9f3f4" },
      { el: nodeBpuST, id: 3, selCol: "#b7df69" }
    ];

    nodes.forEach((n) => {
      if (!n.el) return;
      if (n.id === bpuState) {
        n.el.setAttribute("stroke-width", "4");
        n.el.setAttribute("stroke", "#151b20");
        n.el.setAttribute("filter", "drop-shadow(0 4px 6px rgba(0,0,0,0.2))");
      } else {
        n.el.setAttribute("stroke-width", "2");
        n.el.setAttribute("stroke", "#151b20");
        n.el.removeAttribute("filter");
      }
    });

    const stateNames = ["00: STRONGLY NOT TAKEN (SNT)", "01: WEAKLY NOT TAKEN (WNT)", "10: WEAKLY TAKEN (WT)", "11: STRONGLY TAKEN (ST)"];
    const predTakes = bpuState >= 2;

    if (txtBpuPredState) txtBpuPredState.textContent = `Current Counter: ${stateNames[bpuState]}`;
    if (txtBpuPredAction) {
      txtBpuPredAction.textContent = predTakes ? "PREDICTION: FETCH TARGET PC (BRANCH TAKEN)" : "PREDICTION: FETCH PC+4 (BRANCH NOT TAKEN)";
      txtBpuPredAction.setAttribute("fill", "#000000");
    }

    if (bgBpuPredCard) {
      bgBpuPredCard.setAttribute("fill", lastCorrect ? "#e7f4c8" : "#ffd8ce");
      bgBpuPredCard.setAttribute("stroke", lastCorrect ? "#b7df69" : "#f38469");
    }
    if (txtBpuPredHeader) {
      txtBpuPredHeader.textContent = lastCorrect ? "SPECULATION OUTCOME: PREDICTION CORRECT (0 FLUSH CYCLES)" : "SPECULATION OUTCOME: MISPREDICTION DETECTED (2-CYCLE PIPELINE FLUSH)";
      txtBpuPredHeader.setAttribute("fill", "#000000");
    }

    const accPct = bpuPredictions > 0 ? ((bpuCorrect / bpuPredictions) * 100).toFixed(1) : "94.2";
    if (svgBpuAccVal) svgBpuAccVal.textContent = `${accPct}% Accuracy (${bpuCorrect}/${bpuPredictions})`;
    if (svgBpuAccSub) svgBpuAccSub.textContent = `Dynamic branch history across ${bpuPredictions} simulated branch events`;

    if (!lastCorrect) {
      if (svgBpuPenaltyVal) svgBpuPenaltyVal.textContent = "2 Clock Cycles Lost";
      if (svgBpuPenaltySub) svgBpuPenaltySub.textContent = "IF and ID stages flushed with bubble instructions";
    } else {
      if (svgBpuPenaltyVal) svgBpuPenaltyVal.textContent = "0 Clock Cycles Lost";
      if (svgBpuPenaltySub) svgBpuPenaltySub.textContent = "Stream continues uninterrupted without pipeline bubbling";
    }

    if (svgBpuHysteresisNote) {
      if (bpuState === 1 || bpuState === 2) {
        svgBpuHysteresisNote.textContent = "Hysteresis active: Counter in weak state; 1 more confirming outcome will harden state";
      } else {
        svgBpuHysteresisNote.textContent = "Strong hysteresis locked: A single anomalous branch exit will NOT flip prediction";
      }
    }
  }

  document.getElementById("btnBpuTaken")?.addEventListener("click", () => stepBpu(true));
  document.getElementById("btnBpuNotTaken")?.addEventListener("click", () => stepBpu(false));
  document.getElementById("btnBpuLoopPreset")?.addEventListener("click", () => {
    // Simulate loop: 5 taken, 1 not taken
    for (let i = 0; i < 5; i++) stepBpu(true);
    stepBpu(false);
  });
  document.getElementById("btnBpuAlternatingPreset")?.addEventListener("click", () => {
    stepBpu(true); stepBpu(false); stepBpu(true); stepBpu(false);
  });

  // ==========================================
  // 5a. SV39 PAGE TABLE WALKER & TLB SIMULATOR (FIG 5.1)
  // ==========================================
  let ptwHitMode = true; // true: TLB hit, false: TLB miss
  let ptwPreset = "CODE"; // "CODE", "HEAP", "STACK"

  const grpTlbHitPath = document.getElementById("grpTlbHitPath");
  const grpPtwMissPath = document.getElementById("grpPtwMissPath");
  const txtPtwVaHex = document.getElementById("txtPtwVaHex");
  const txtPtwPaPpn = document.getElementById("txtPtwPaPpn");
  const txtPtwPaOffset = document.getElementById("txtPtwPaOffset");

  const svgPtwLatencyVal = document.getElementById("svgPtwLatencyVal");
  const svgPtwLatencySub = document.getElementById("svgPtwLatencySub");
  const svgPtwTrafficVal = document.getElementById("svgPtwTrafficVal");
  const svgPtwTrafficSub = document.getElementById("svgPtwTrafficSub");

  function updatePtwWorkbench() {
    // 1. Button active states
    const btnHit = document.getElementById("bgBtnPtwHit");
    const btnMiss = document.getElementById("bgBtnPtwMiss");
    if (btnHit) btnHit.setAttribute("fill", ptwHitMode ? "#b7df69" : "#eee4c8");
    if (btnMiss) btnMiss.setAttribute("fill", !ptwHitMode ? "#ffd8ce" : "#eee4c8");

    // 2. Preset buttons
    ["Code", "Heap", "Stack"].forEach((p) => {
      const bg = document.getElementById(`bgPtwPreset${p}`);
      const isSel = (p.toUpperCase() === ptwPreset);
      if (bg) bg.setAttribute("fill", isSel ? "#22bfd7" : "#eee4c8");
    });

    // 3. Address fields
    let vaStr = "0x0000_0001_0040_2000 (Binary: VPN[2]=0x000, VPN[1]=0x002, VPN[0]=0x001, Offset=0x000)";
    let ppnStr = "Physical Page Number: PPN[43:0] = 0x0000_8004_2";
    let offsetStr = "Page Offset: 0x000 (Direct Bit Pass-Through)";

    if (ptwPreset === "CODE") {
      vaStr = "0x0000_0001_0040_2000 (Binary: VPN[2]=0x000, VPN[1]=0x002, VPN[0]=0x001, Offset=0x000)";
      ppnStr = "Physical Page Number: PPN[43:0] = 0x0000_8004_2";
      offsetStr = "Page Offset: 0x000 (Direct Bit Pass-Through)";
    } else if (ptwPreset === "HEAP") {
      vaStr = "0x0000_0002_0080_5480 (Binary: VPN[2]=0x000, VPN[1]=0x004, VPN[0]=0x002, Offset=0x480)";
      ppnStr = "Physical Page Number: PPN[43:0] = 0x0000_8008_5";
      offsetStr = "Page Offset: 0x480 (Direct Bit Pass-Through)";
    } else if (ptwPreset === "STACK") {
      vaStr = "0x007F_FFFF_E000_0000 (Binary: VPN[2]=0x1FF, VPN[1]=0x1FF, VPN[0]=0x1FE, Offset=0x000)";
      ppnStr = "Physical Page Number: PPN[43:0] = 0x0000_7FFF_E";
      offsetStr = "Page Offset: 0x000 (Direct Bit Pass-Through)";
    }

    if (txtPtwVaHex) txtPtwVaHex.textContent = vaStr;
    if (txtPtwPaPpn) txtPtwPaPpn.textContent = ppnStr;
    if (txtPtwPaOffset) txtPtwPaOffset.textContent = offsetStr;

    // 4. Hit vs Miss visual opacity
    if (grpTlbHitPath) grpTlbHitPath.setAttribute("opacity", ptwHitMode ? "1" : "0.35");
    if (grpPtwMissPath) grpPtwMissPath.setAttribute("opacity", !ptwHitMode ? "1" : "0.35");

    // 5. Readouts
    if (ptwHitMode) {
      if (svgPtwLatencyVal) svgPtwLatencyVal.textContent = "1 Clock Cycle (~0.5 ns)";
      if (svgPtwLatencySub) svgPtwLatencySub.textContent = "TLB Hit: Zero memory bus wait-states";
      if (svgPtwTrafficVal) svgPtwTrafficVal.textContent = "0 Bytes DRAM Traffic";
      if (svgPtwTrafficSub) svgPtwTrafficSub.textContent = "Fully associative CAM match finishes before L1 cache access";
    } else {
      if (svgPtwLatencyVal) svgPtwLatencyVal.textContent = "~180 Clock Cycles";
      if (svgPtwLatencySub) svgPtwLatencySub.textContent = "TLB Miss: Hardware Page Table Walker traverses DRAM tree";
      if (svgPtwTrafficVal) svgPtwTrafficVal.textContent = "24 Bytes DRAM Traffic";
      if (svgPtwTrafficSub) svgPtwTrafficSub.textContent = "3 sequential 64-bit PTE fetches: Level 2 -> Level 1 -> Level 0 Leaf";
    }
  }

  document.getElementById("btnPtwModeHit")?.addEventListener("click", () => { ptwHitMode = true; updatePtwWorkbench(); });
  document.getElementById("btnPtwModeMiss")?.addEventListener("click", () => { ptwHitMode = false; updatePtwWorkbench(); });
  document.getElementById("btnPtwVaCode")?.addEventListener("click", () => { ptwPreset = "CODE"; updatePtwWorkbench(); });
  document.getElementById("btnPtwVaHeap")?.addEventListener("click", () => { ptwPreset = "HEAP"; updatePtwWorkbench(); });
  document.getElementById("btnPtwVaStack")?.addEventListener("click", () => { ptwPreset = "STACK"; updatePtwWorkbench(); });

</script>

