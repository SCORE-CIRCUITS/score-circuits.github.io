            <text x="142" y="129" font-size="9" font-weight="900" fill="#000000">RegFile</text>

            <!-- Register ID/EX -->
            <rect x="214" y="25" width="12" height="140" rx="2" fill="#eee4c8" stroke="#151b20" stroke-width="1.5"/>
