            <text x="35" y="65" font-weight="900" font-size="11" fill="#000000">1. FETCH</text>
            <rect x="25" y="75" width="65" height="25" rx="3" fill="#eee4c8"/>
            <text x="32" y="91" font-size="9" font-weight="900" fill="#000000">PC + 4</text>
