  function updateDualSim() {
    // 1. Update Input Control Buttons
    if (btnDualInATxt) btnDualInATxt.textContent = dualInA === 1 ? "A = 1 (1.0V)" : "A = 0 (0.0V)";
    if (btnDualInBTxt) btnDualInBTxt.textContent = dualInB === 1 ? "B = 1 (1.0V)" : "B = 0 (0.0V)";
