                <rect x="455" y="115" width="55" height="40" rx="4" fill="#e7f4c8" stroke="#b7df69"/><text x="463" y="132" font-size="8" font-weight="800">Node (1,1)</text><text x="465" y="146" font-size="7">Router</text>

