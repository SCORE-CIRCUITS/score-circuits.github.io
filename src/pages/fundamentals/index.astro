    if (btnDualInBBg) {
      btnDualInBBg.setAttribute("fill", dualInB === 1 ? "#c9f3f4" : "#fffaf0");
    }

    // Update Presets
    const is00 = dualInA === 0 && dualInB === 0;
    const is01 = dualInA === 0 && dualInB === 1;
    const is10 = dualInA === 1 && dualInB === 0;
    const is11 = dualInA === 1 && dualInB === 1;
    pillDual00?.setAttribute("fill", is00 ? "#fff0b9" : "#fffaf0");
    pillDual01?.setAttribute("fill", is01 ? "#fff0b9" : "#fffaf0");
