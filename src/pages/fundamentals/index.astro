  function updateIronLawSim() {
    const inst = parseInt(ilInstSlider?.value || "1000000", 10);
    const cpi = parseFloat(ilCpiSlider?.value || "1.20");
    const freq = parseInt(ilFreqSlider?.value || "1000", 10);

