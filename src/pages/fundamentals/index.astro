---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Fundamental Learnings"
  description="First-principles intuitive guide to computer architecture, silicon microprocessors, memory hierarchies, and the 4 SCORE categories."
>
  <!-- Page Header -->
  <div class="page-header accent-yellow">
    <div class="badge badge-accent">START HERE &bull; ZERO TO CHIP ARCHITECT</div>
    <h1 class="page-title">Fundamental Learnings in Computer Architecture</h1>
    <p class="page-lead">
      How do millions of microscopic switches carved into silicon execute software, stream video, and accelerate artificial intelligence? This guide starts from absolute first principles—designed so that <strong>newcomers, students, and engineers alike</strong> can intuitively grasp how computer chips work and why the <strong>4 SCORE Categories</strong> exist.
    </p>

    <!-- Quick Navigation Jump -->
    <div class="primer-nav">
      <a href="#what-is-a-chip" class="primer-jump">&sect; 1. What is a Chip?</a>
      <a href="#what-is-riscv" class="primer-jump">&sect; 2. What is RISC-V?</a>
      <a href="#pipeline-laundry" class="primer-jump">&sect; 3. The Laundry Assembly Line</a>
      <a href="#kitchen-memory" class="primer-jump">&sect; 4. The Chef's Kitchen (Memory)</a>
      <a href="#vehicle-analogy" class="primer-jump">&sect; 5. The 4 Categories Explained</a>
      <a href="#benchmarking-101" class="primer-jump">&sect; 6. How We Score Chips</a>
    </div>
  </div>

  <div class="fundamentals-stream">
    <!-- SECTION 1: What is a Chip? -->
    <section id="what-is-a-chip" class="fund-section-card">
      <div class="fund-header">
        <span class="fund-num">01</span>
        <div>
          <span class="badge badge-accent">FIRST PRINCIPLES</span>
          <h2 class="fund-title">What Exactly is a Computer Chip?</h2>
        </div>
      </div>
      <p class="fund-lead">
        At the most fundamental physical level, a computer chip is made of pure refined <strong>sand (silicon)</strong> carved with billions of microscopic electrical switches called <strong>transistors</strong>.
      </p>

      <div class="analogy-banner">
        <div class="analogy-icon">&#128161;</div>
        <div class="analogy-text">
          <strong>The Light Switch Analogy:</strong> Think of a transistor as a microscopic light switch. When electricity flows through, the switch is <strong>ON (1)</strong>. When blocked, it is <strong>OFF (0)</strong>. By connecting millions of these tiny switches together in clever patterns, we create <em>logic gates</em> that can add numbers, store data, and execute programs.
        </div>
      </div>

      <!-- INTERACTIVE TRANSISTOR / LOGIC GATE SIMULATOR -->
      <div class="interactive-widget-box" id="gateWidget">
        <div class="widget-header">
          <span class="widget-badge">INTERACTIVE SIMULATION</span>
          <h3 class="widget-title">Interactive Logic Gate &amp; Transistor Switch</h3>
          <p class="widget-desc">
            Toggle the inputs below to see how electrical currents pass through digital logic gates to turn on the output light!
          </p>
        </div>

        <div class="gate-controls-row">
          <div class="ctrl-group">
            <span class="ctrl-label">Select Logic Gate:</span>
            <div class="gate-btn-group">
              <button class="gate-sel-btn active" data-gate="AND">AND</button>
              <button class="gate-sel-btn" data-gate="OR">OR</button>
              <button class="gate-sel-btn" data-gate="NAND">NAND (Universal)</button>
              <button class="gate-sel-btn" data-gate="XOR">XOR (Adder)</button>
            </div>
          </div>

          <div class="inputs-group">
            <span class="ctrl-label">Toggle Inputs:</span>
            <div class="switch-pair">
              <button class="toggle-switch-btn" id="toggleInputA" data-val="1">
                Input A: <span class="val-pill pill-on">1 (HIGH)</span>
              </button>
              <button class="toggle-switch-btn" id="toggleInputB" data-val="1">
                Input B: <span class="val-pill pill-on">1 (HIGH)</span>
              </button>
            </div>
          </div>
        </div>

        <div class="gate-visual-display">
          <div class="gate-diagram-wrap">
            <div class="wire-in wire-a"><span class="wire-lbl">A = <span id="wireValA">1</span></span></div>
            <div class="wire-in wire-b"><span class="wire-lbl">B = <span id="wireValB">1</span></span></div>
            <div class="logic-gate-box" id="gateBoxLabel">
              <span class="gate-symbol-txt">AND</span>
              <span class="gate-sub-txt">Logic Gate</span>
            </div>
            <div class="wire-out"><span class="wire-lbl">OUT = <span id="wireValOut">1</span></span></div>
            
            <div class="lightbulb-container" id="bulbContainer">
              <div class="bulb-icon">&#128161;</div>
              <span class="bulb-status" id="bulbStatusTxt">OUTPUT ON (1)</span>
            </div>
          </div>

          <div class="gate-truth-table-wrap">
            <span class="tt-title">Truth Table for <strong id="ttGateName">AND</strong>:</span>
            <table class="truth-table" id="truthTableBody">
              <thead>
                <tr><th>A</th><th>B</th><th>Output</th><th>Status</th></tr>
              </thead>
              <tbody>
                <tr id="tr-00"><td>0</td><td>0</td><td class="res-cell">0</td><td class="state-cell">OFF</td></tr>
                <tr id="tr-01"><td>0</td><td>1</td><td class="res-cell">0</td><td class="state-cell">OFF</td></tr>
                <tr id="tr-10"><td>1</td><td>0</td><td class="res-cell">0</td><td class="state-cell">OFF</td></tr>
                <tr id="tr-11" class="active-tr"><td>1</td><td>1</td><td class="res-cell">1</td><td class="state-cell">ACTIVE &#9733;</td></tr>
              </tbody>
            </table>
          </div>
        </div>
        <div class="widget-insight" id="gateInsightTxt">
          <strong>Key Architectural Insight:</strong> The <strong>NAND gate</strong> is known as a <em>universal gate</em>. Any digital circuit—from an arithmetic adder to a 64-bit multi-core CPU—can be constructed entirely from connected NAND gates!
        </div>
      </div>

      <div class="fund-grid" style="margin-top: 1.5rem;">
        <div class="fund-box">
          <h4>Key Building Blocks</h4>
          <ul>
            <li><strong>Bit (0 or 1):</strong> The fundamental atomic unit of information.</li>
            <li><strong>Byte (8 bits):</strong> Enough bits to encode a single ASCII character (e.g. 'A' = <code>01000001</code>).</li>
            <li><strong>Clock Cycle:</strong> The synchronized heartbeat of the silicon chip. At 1.0 GHz, the clock ticks <strong>one billion times every second</strong>.</li>
            <li><strong>CPU (Central Processing Unit):</strong> The central engine that fetches binary instructions from memory and computes results.</li>
          </ul>
        </div>

        <div class="fund-box">
          <h4>From Software to Silicon</h4>
          <p>
            When you write software in Python, Rust, or C++:
          </p>
          <ol>
            <li>A <strong>Compiler</strong> converts your human-readable logic into <strong>Assembly Instructions</strong> (elementary primitives like <code>ADD</code>, <code>LW</code>, <code>BEQ</code>).</li>
            <li>The assembler encodes those mnemonics into binary <strong>Machine Code</strong> ($32$-bit or $64$-bit words).</li>
            <li>The processor's hardware decoders physically steer voltages across logic gates to execute the instruction!</li>
          </ol>
        </div>
      </div>
    </section>

    <!-- SECTION 2: What is RISC-V? -->
    <section id="what-is-riscv" class="fund-section-card">
      <div class="fund-header">
        <span class="fund-num">02</span>
        <div>
          <span class="badge badge-accent">OPEN ARCHITECTURE</span>
          <h2 class="fund-title">What is RISC-V and Why Does it Matter?</h2>
        </div>
      </div>
      <p class="fund-lead">
        An <strong>Instruction Set Architecture (ISA)</strong> is the contract, or dictionary, between software and hardware. Without an ISA, software cannot communicate with silicon.
      </p>

      <div class="fund-grid">
        <div class="fund-box">
          <h4>The Problem with Proprietary ISAs</h4>
          <p>
            Historically, instruction sets were strictly guarded proprietary property:
          </p>
          <ul>
            <li><strong>x86 (Intel / AMD):</strong> Dominates desktop PCs and cloud servers. Proprietary and closed; third parties cannot build an x86 core without risking copyright litigation.</li>
            <li><strong>ARM (Apple, Qualcomm, Raspberry Pi):</strong> Dominates mobile phones and IoT. Authors must pay substantial upfront license fees and ongoing royalties for each fabricated chip.</li>
          </ul>
        </div>

        <div class="fund-box">
          <h4>The RISC-V Open Revolution</h4>
          <p>
            Invented at UC Berkeley in 2010, <strong>RISC-V</strong> (pronounced <em>"risk-five"</em>) is an <strong>open, royalty-free standard</strong>. Anyone—from students and independent researchers to global technology corporations—can design, simulate, tape out, and commercialize RISC-V chips freely without licensing fees.
          </p>
          <div class="highlight-callout">
            <strong>Modular Extension Architecture:</strong> Start with a compact integer base (<code>RV32I</code> or <code>RV64I</code>), and snap on modular extensions like building blocks: <code>M</code> (Multiply/Divide), <code>A</code> (Atomics), <code>C</code> (Compressed 16-bit code), <code>F/D</code> (Floating-Point), and <code>V</code> (Vector acceleration).
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 3: The Laundry Assembly Line (Pipelining) -->
    <section id="pipeline-laundry" class="fund-section-card">
      <div class="fund-header">
        <span class="fund-num">03</span>
        <div>
          <span class="badge badge-accent">MICROARCHITECTURE</span>
          <h2 class="fund-title">The Laundry Assembly Line: How Pipelining Works</h2>
        </div>
      </div>
      <p class="fund-lead">
        Executing an instruction requires five sequential operations: <strong>Fetch (IF)</strong> &rarr; <strong>Decode (ID)</strong> &rarr; <strong>Execute (EX)</strong> &rarr; <strong>Memory Access (MEM)</strong> &rarr; <strong>Writeback (WB)</strong>. If a processor waited for an instruction to finish all five stages before beginning the next, execution units would sit idle 80% of the time!
      </p>

      <div class="analogy-banner">
        <div class="analogy-icon">&#129530;</div>
        <div class="analogy-text">
          <strong>The Classic Laundry Analogy:</strong><br />
          Imagine doing 4 loads of laundry using a Washer (30 min), Dryer (30 min), and Folding table (30 min):
          <ul>
            <li><strong>Without Pipelining (Sequential):</strong> Wash Load 1 &rarr; Dry Load 1 &rarr; Fold Load 1 (90 mins total). Then start Load 2. Total time for 4 loads = <strong>360 minutes (6 hours)</strong>!</li>
            <li><strong>With Pipelining (Overlapped):</strong> As soon as Load 1 moves to the dryer, throw Load 2 into the washer! All three appliances operate simultaneously. Total time for 4 loads drops to <strong>180 minutes (3 hours)</strong>—completing 1 fresh load every 30 minutes!</li>
          </ul>
        </div>
      </div>

      <!-- INTERACTIVE PIPELINE VISUALIZER -->
      <div class="interactive-widget-box" id="pipelineWidget">
        <div class="widget-header">
          <span class="widget-badge">INTERACTIVE VISUALIZER</span>
          <h3 class="widget-title">Interactive Pipeline Speedup Simulator</h3>
          <p class="widget-desc">
            Toggle between non-pipelined sequential execution and a 5-stage pipelined processor to witness the dramatic reduction in total clock cycles!
          </p>
        </div>

        <div class="pipe-toggle-row">
          <button class="pipe-mode-btn" id="btnPipeSeq" data-mode="seq">
            Sequential (No Pipeline)
          </button>
          <button class="pipe-mode-btn active" id="btnPipePipe" data-mode="pipe">
            5-Stage Pipelined (Overlapped)
          </button>
        </div>

        <div class="pipe-metrics-summary">
          <div class="pm-box">
            <span class="pm-lbl">Total Clock Cycles:</span>
            <span class="pm-val" id="pmCycles">8 Cycles</span>
          </div>
          <div class="pm-box">
            <span class="pm-lbl">Throughput (Instructions / Cycle):</span>
            <span class="pm-val" id="pmThroughput">0.50 IPC (Max 1.0)</span>
          </div>
          <div class="pm-box highlight-box">
            <span class="pm-lbl">Speedup Factor:</span>
            <span class="pm-val highlight-val" id="pmSpeedup">2.50&times; Faster</span>
          </div>
        </div>

        <div class="pipe-grid-container">
          <div class="pipe-grid" id="pipeVisualGrid">
            <!-- Rendered dynamically by script -->
          </div>
        </div>

        <div class="pipe-stage-legend">
          <span class="legend-item"><span class="stage-color-chip chip-if"></span> IF: Fetch</span>
          <span class="legend-item"><span class="stage-color-chip chip-id"></span> ID: Decode</span>
          <span class="legend-item"><span class="stage-color-chip chip-ex"></span> EX: Execute</span>
          <span class="legend-item"><span class="stage-color-chip chip-mem"></span> MEM: Memory</span>
          <span class="legend-item"><span class="stage-color-chip chip-wb"></span> WB: Writeback</span>
        </div>
      </div>

      <div class="pipeline-comparison-grid" style="margin-top: 1.5rem;">
        <div class="pipe-card">
          <span class="pipe-badge">1-STAGE / BIT-SERIAL</span>
          <h4>SERV (~2.1 kGE)</h4>
          <p>
            Does laundry <strong>one sock at a time</strong>. Processes 1 bit per cycle over 32 cycles. Minimizes silicon footprint to fit in the smallest FPGA or ASIC budgets.
          </p>
        </div>

        <div class="pipe-card">
          <span class="pipe-badge">2-STAGE PIPELINE</span>
          <h4>Ibex (~24.5 kGE)</h4>
          <p>
            Two stages: Fetch and Execute. Features low branch penalties (only 1 bubble on mispredictions), making it an industrial standard for embedded microcontrollers.
          </p>
        </div>

        <div class="pipe-card">
          <span class="pipe-badge">4-STAGE DUAL-ISSUE</span>
          <h4>VeeR EL2 (~48.5 kGE)</h4>
          <p>
            Dual-pipe parallel assembly lines! Decodes and issues <strong>two instructions simultaneously</strong> per clock cycle to reach superscalar IPC (CoreMark = 3.62/MHz).
          </p>
        </div>

        <div class="pipe-card">
          <span class="pipe-badge">6-STAGE APPLICATION</span>
          <h4>CVA6 (~148 kGE)</h4>
          <p>
            Deep 6-stage pipeline (Fetch, Decode, Issue, Execute, Commit, Writeback) operating at >1.4 GHz with Sv39 virtual memory for full Linux operating systems.
          </p>
        </div>
      </div>
    </section>

    <!-- SECTION 4: The Chef's Kitchen (Memory Hierarchy) -->
    <section id="kitchen-memory" class="fund-section-card">
      <div class="fund-header">
        <span class="fund-num">04</span>
        <div>
          <span class="badge badge-accent">MEMORY SUBSYSTEMS</span>
          <h2 class="fund-title">The Chef's Kitchen: Understanding the Memory Hierarchy</h2>
        </div>
      </div>
      <p class="fund-lead">
        A fast processor without fast memory is like a world-class chef who has to drive across town every time they need a pinch of salt. Modern chips use a multi-tiered memory hierarchy to keep data right next to the computing core.
      </p>

      <div class="analogy-banner">
        <div class="analogy-icon">&#128104;&#8205;&#127859;</div>
        <div class="analogy-text">
          <strong>The Kitchen Counter Analogy:</strong>
          <ul>
            <li><strong>Registers (Chef's Hands &amp; Cutting Board):</strong> Instant access (0 clock cycles). Extremely fast, but holds only 32 numbers!</li>
            <li><strong>L1 Cache (Kitchen Spice Rack):</strong> Inches away from the chef. Takes 1–2 clock cycles. Stores a few thousand bytes of frequently used ingredients.</li>
            <li><strong>Main Memory / DRAM (The Pantry Downstairs):</strong> Takes 50–200 clock cycles. Holds gigabytes of data, but the chef has to stop cooking and walk downstairs to retrieve items.</li>
            <li><strong>Storage / SSD / Flash (The Grocery Store):</strong> Takes thousands to millions of clock cycles! Holds terabytes permanently even when power is turned off.</li>
          </ul>
        </div>
      </div>

      <!-- INTERACTIVE MEMORY LATENCY SCALE WIDGET -->
      <div class="interactive-widget-box" id="memoryWidget">
        <div class="widget-header">
          <span class="widget-badge">INTERACTIVE LATENCY COMPARISON</span>
          <h3 class="widget-title">The Memory Latency Gap (Human Scale)</h3>
          <p class="widget-desc">
            If 1 CPU clock cycle was scaled to <strong>1 second</strong> in human time, how long would the CPU wait for each memory level? Select a level to compare:
          </p>
        </div>

        <div class="mem-level-selector">
          <button class="mem-level-btn active" data-level="reg">1. CPU Registers (0.5 ns)</button>
          <button class="mem-level-btn" data-level="l1">2. L1 Cache (1.5 ns)</button>
          <button class="mem-level-btn" data-level="dram">3. Main DRAM (60 ns)</button>
          <button class="mem-level-btn" data-level="ssd">4. NVMe SSD (50,000 ns)</button>
        </div>

        <div class="mem-detail-card">
          <div class="mdc-top">
            <span class="mdc-title" id="memTitle">CPU Register File (32 Registers)</span>
            <span class="mdc-latency" id="memLatency">Latency: &lt; 0.5 nanoseconds (0 cycles)</span>
          </div>

          <div class="human-scale-box">
            <div class="hs-icon" id="hsIcon">&#9997;</div>
            <div class="hs-text">
              <strong id="hsTimeText">Human Equivalent: 1 Second</strong>
              <p id="hsDescText">
                Like picking up a pencil already sitting in your hand. The processor computes immediately with zero stalls.
              </p>
            </div>
          </div>

          <div class="latency-bar-track">
            <div class="latency-bar-fill" id="latencyBarFill" style="width: 2%;"></div>
          </div>
          <div class="latency-scale-labels">
            <span>Instant (Registers)</span>
            <span>Seconds (L1 Cache)</span>
            <span>Minutes (Main Memory)</span>
            <span>Months (SSD Storage)</span>
          </div>
        </div>
      </div>

      <div class="fund-grid" style="margin-top: 1.5rem;">
        <div class="fund-box">
          <h4>Scratchpad SRAM vs. Hardware Cache</h4>
          <ul>
            <li><strong>Tightly-Coupled Scratchpad (TCDM):</strong> Dedicated, low-latency SRAM with guaranteed 1-cycle access. The software programmer explicitly allocates memory buffers. Used extensively in real-time embedded systems (Category 1) and parallel manycore clusters (Category 4 <strong>MemPool</strong>).</li>
            <li><strong>Hardware Cache:</strong> Automatically monitors memory access patterns to prefetch data. A successful look-up is a <em>Cache Hit</em>; a miss stalls the processor while fetching from slower external memory.</li>
          </ul>
        </div>

        <div class="fund-box">
          <h4>Virtual Memory &amp; The MMU</h4>
          <p>
            When running multi-tasking operating systems with multiple processes:
          </p>
          <ul>
            <li>The <strong>Memory Management Unit (MMU)</strong> grants each software process an isolated virtual address space.</li>
            <li>Hardware Page Table Walkers (PTW) automatically translate virtual addresses to physical DRAM pages.</li>
            <li><strong>Linux requires an MMU</strong> (Category 2). Microcontrollers operate without an MMU, executing baremetal firmware directly on physical addresses (Category 1).</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- SECTION 5: The 4 Categories via the Vehicle Analogy -->
    <section id="vehicle-analogy" class="fund-section-card">
      <div class="fund-header">
        <span class="fund-num">05</span>
        <div>
          <span class="badge badge-accent">THE BIG PICTURE</span>
          <h2 class="fund-title">The 4 SCORE Categories: Explained via Vehicles</h2>
        </div>
      </div>
      <p class="fund-lead">
        Why does SCORE categorize open-source chips into 4 categories? Because you wouldn't use a 50-car freight train to buy milk, nor could you haul 1,000 tons of steel on a bicycle. Different computational tasks demand fundamentally different chip architectures!
      </p>

      <div class="vehicle-grid">
        <div class="v-card cat1-v">
          <div class="v-icon">&#128692;</div>
          <span class="v-badge">CATEGORY 01</span>
          <h3>The Electric Bicycle</h3>
          <div class="v-subtitle">Microcontroller &amp; Scalar Cores</div>
          <p>
            Ultra-compact, highly efficient, and cheap. Ideal for dedicated control loops: monitoring sensors, battery management, and security root-of-trust controllers. Consumes microwatts of power.
          </p>
          <div class="v-examples">Examples: SERV, PicoRV32, Ibex, Hazard3</div>
          <a href="/mcu-scalar/" class="btn btn-outline btn-xs" style="margin-top: 0.75rem;">Explore Category 1 &rarr;</a>
        </div>

        <div class="v-card cat2-v">
          <div class="v-icon">&#128663;</div>
          <span class="v-badge">CATEGORY 02</span>
          <h3>The Passenger Sedan</h3>
          <div class="v-subtitle">64-bit Application Cores</div>
          <p>
            Comfortable, full-featured daily driver. Integrates an MMU, multi-level caches, and 64-bit addresses. Capable of hosting full Linux distributions, network stacks, and user software.
          </p>
          <div class="v-examples">Examples: CVA6 (Ariane), Rocket Chip, BOOM</div>
          <a href="/app-cores/" class="btn btn-outline btn-xs" style="margin-top: 0.75rem;">Explore Category 2 &rarr;</a>
        </div>

        <div class="v-card cat3-v">
          <div class="v-icon">&#128646;</div>
          <span class="v-badge">CATEGORY 03</span>
          <h3>The Heavy Cargo Train</h3>
          <div class="v-subtitle">Vector &amp; Coprocessor Engines</div>
          <p>
            Built for massive bulk data. Rather than computing one number at a time, parallel vector lanes process dozens of data points simultaneously. Essential for AI matrix multiplication, vision, and signal processing.
          </p>
          <div class="v-examples">Examples: Ara (RVV 1.0), AraXL, Gemmini</div>
          <a href="/vector-coprocessors/" class="btn btn-outline btn-xs" style="margin-top: 0.75rem;">Explore Category 3 &rarr;</a>
        </div>

        <div class="v-card cat4-v">
          <div class="v-icon">&#127970;</div>
          <span class="v-badge">CATEGORY 04</span>
          <h3>The Complete City Transit System</h3>
          <div class="v-subtitle">SoC Platforms &amp; Multi-Core Clusters</div>
          <p>
            Not just an isolated vehicle, but an entire metropolitan transport network! Features multi-lane expressways (AXI4/NoC), traffic dispatchers (arbiters), autonomous delivery trucks (DMA engines), and hundreds of parallel cores (up to 432 cores).
          </p>
          <div class="v-examples">Examples: MemPool (256 cores), Cheshire, Occamy</div>
          <a href="/soc-multicore/" class="btn btn-outline btn-xs" style="margin-top: 0.75rem;">Explore Category 4 &rarr;</a>
        </div>
      </div>
    </section>

    <!-- SECTION 6: How We Score Chips -->
    <section id="benchmarking-101" class="fund-section-card">
      <div class="fund-header">
        <span class="fund-num">06</span>
        <div>
          <span class="badge badge-accent">BENCHMARKING 101</span>
          <h2 class="fund-title">How We Score &amp; Measure Chips</h2>
        </div>
      </div>
      <p class="fund-lead">
        Evaluating a processor is never as simple as asking "which core is fastest?" Architecture requires balancing performance against silicon area, energy, and design complexity:
      </p>

      <div class="fund-grid">
        <div class="fund-box">
          <h4>Efficiency &amp; Speed Metrics</h4>
          <ul>
            <li>
              <strong>CPI (Cycles per Instruction):</strong> Average clock cycles required to retire an instruction. Lower is better. A CPI of 1.0 indicates one instruction completes per cycle. Superscalar dual-issue cores achieve CPI &lt; 1.0!
            </li>
            <li>
              <strong>CoreMark / MHz:</strong> The standard industry benchmark for embedded cores. Measures integer compute capability per megahertz of operating frequency.
            </li>
            <li>
              <strong>Ops / Cycle:</strong> Operations completed per clock tick. Vector processors and systolic arrays reach 4 to 30+ Ops/Cycle by evaluating SIMD lanes in parallel.
            </li>
            <li>
              <strong>Vector Utilization (%):</strong> The percentage of cycles that arithmetic execution units are actively calculating numbers vs. sitting idle waiting for memory.
            </li>
          </ul>
        </div>

        <div class="fund-box">
          <h4>Physical Silicon Metrics</h4>
          <ul>
            <li>
              <strong>Gate Count (kGE - Kilo Gate Equivalents):</strong> Standardized silicon area measured in thousands of two-input NAND gates (NAND2):
              <br />
              &bull; <code>SERV</code> = ~2.1 kGE (ultra-compact bit-serial)<br />
              &bull; <code>Ibex</code> = ~24.5 kGE (balanced embedded core)<br />
              &bull; <code>CVA6</code> = ~148 kGE (64-bit Linux application core)<br />
              &bull; <code>BOOM</code> = ~420 kGE (superscalar out-of-order)
            </li>
            <li>
              <strong>Process Node (nm):</strong> The fabrication technology (e.g. 130nm, 28nm, 16nm). Smaller nodes pack more transistors into smaller footprints, operating at higher frequencies and lower voltages.
            </li>
          </ul>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  // ==========================================
  // WIDGET 1: LOGIC GATE & TRANSISTOR SWITCH
  // ==========================================
  let currentGate = "AND";
  let inputA = 1;
  let inputB = 1;

  const btnA = document.getElementById("toggleInputA");
  const btnB = document.getElementById("toggleInputB");
  const wireValA = document.getElementById("wireValA");
  const wireValB = document.getElementById("wireValB");
  const wireValOut = document.getElementById("wireValOut");
  const gateBoxLabel = document.getElementById("gateBoxLabel")?.querySelector(".gate-symbol-txt");
  const bulbContainer = document.getElementById("bulbContainer");
  const bulbStatusTxt = document.getElementById("bulbStatusTxt");
  const ttGateName = document.getElementById("ttGateName");
  const gateInsightTxt = document.getElementById("gateInsightTxt");

  function evaluateGate(gate: string, a: number, b: number): number {
    switch (gate) {
      case "AND": return a && b ? 1 : 0;
      case "OR": return a || b ? 1 : 0;
      case "NAND": return !(a && b) ? 1 : 0;
      case "XOR": return a !== b ? 1 : 0;
      default: return 0;
    }
  }

  function updateGateWidget() {
    const out = evaluateGate(currentGate, inputA, inputB);

    if (wireValA) wireValA.textContent = String(inputA);
    if (wireValB) wireValB.textContent = String(inputB);
    if (wireValOut) wireValOut.textContent = String(out);
    if (gateBoxLabel) gateBoxLabel.textContent = currentGate;
    if (ttGateName) ttGateName.textContent = currentGate;

    // Update Input buttons UI
    if (btnA) {
      btnA.innerHTML = `Input A: <span class="val-pill ${inputA ? 'pill-on' : 'pill-off'}">${inputA} (${inputA ? 'HIGH' : 'LOW'})</span>`;
    }
    if (btnB) {
      btnB.innerHTML = `Input B: <span class="val-pill ${inputB ? 'pill-on' : 'pill-off'}">${inputB} (${inputB ? 'HIGH' : 'LOW'})</span>`;
    }

    // Update bulb
    if (bulbContainer && bulbStatusTxt) {
      if (out === 1) {
        bulbContainer.classList.add("bulb-active");
        bulbStatusTxt.textContent = "OUTPUT ON (1)";
      } else {
        bulbContainer.classList.remove("bulb-active");
        bulbStatusTxt.textContent = "OUTPUT OFF (0)";
      }
    }

    // Update Truth table
    const rows = [
      { id: "tr-00", a: 0, b: 0 },
      { id: "tr-01", a: 0, b: 1 },
      { id: "tr-10", a: 1, b: 0 },
      { id: "tr-11", a: 1, b: 1 },
    ];

    rows.forEach(r => {
      const rowEl = document.getElementById(r.id);
      if (rowEl) {
        const rowOut = evaluateGate(currentGate, r.a, r.b);
        const resCell = rowEl.querySelector(".res-cell");
        const stateCell = rowEl.querySelector(".state-cell");
        if (resCell) resCell.textContent = String(rowOut);
        if (stateCell) stateCell.textContent = rowOut ? "ON (1)" : "OFF (0)";

        if (r.a === inputA && r.b === inputB) {
          rowEl.classList.add("active-tr");
          if (stateCell) stateCell.textContent = rowOut ? "ACTIVE ★ (1)" : "ACTIVE ★ (0)";
        } else {
          rowEl.classList.remove("active-tr");
        }
      }
    });

    // Update insight
    if (gateInsightTxt) {
      if (currentGate === "NAND") {
        gateInsightTxt.innerHTML = "<strong>Key Architectural Insight:</strong> The <strong>NAND gate</strong> is functionally universal. Every digital system—from single-cycle ALUs to 64-bit multi-core processors—can be fabricated entirely using interconnected NAND gates!";
      } else if (currentGate === "XOR") {
        gateInsightTxt.innerHTML = "<strong>Key Architectural Insight:</strong> The <strong>XOR gate</strong> is the core arithmetic engine of computer addition! It computes binary addition ($1 + 1 = 0$ with carry), forming the foundation of every CPU's Arithmetic Logic Unit (ALU).";
      } else if (currentGate === "AND") {
        gateInsightTxt.innerHTML = "<strong>Key Architectural Insight:</strong> An <strong>AND gate</strong> outputs $1$ only when both control gates receive voltage. CPUs use AND gates to check conditional flags and enable memory write operations.";
      } else {
        gateInsightTxt.innerHTML = "<strong>Key Architectural Insight:</strong> An <strong>OR gate</strong> outputs $1$ if either input is active. Microprocessors use OR gates to multiplex data buses and handle shared interrupt request lines.";
      }
    }
  }

  // Gate selection buttons
  document.querySelectorAll(".gate-sel-btn").forEach(btn => {
    btn.addEventListener("click", () => {
      document.querySelectorAll(".gate-sel-btn").forEach(b => b.classList.remove("active"));
      btn.classList.add("active");
      currentGate = btn.getAttribute("data-gate") || "AND";
      updateGateWidget();
    });
  });

  btnA?.addEventListener("click", () => {
    inputA = inputA === 1 ? 0 : 1;
    updateGateWidget();
  });

  btnB?.addEventListener("click", () => {
    inputB = inputB === 1 ? 0 : 1;
    updateGateWidget();
  });

  // ==========================================
  // WIDGET 2: PIPELINING LAUNDRY SIMULATOR
  // ==========================================
  let pipeMode = "pipe"; // "seq" or "pipe"

  const btnSeq = document.getElementById("btnPipeSeq");
  const btnPipe = document.getElementById("btnPipePipe");
  const pmCycles = document.getElementById("pmCycles");
  const pmThroughput = document.getElementById("pmThroughput");
  const pmSpeedup = document.getElementById("pmSpeedup");
  const gridContainer = document.getElementById("pipeVisualGrid");

  const stages = [
    { name: "IF", cls: "chip-if" },
    { name: "ID", cls: "chip-id" },
    { name: "EX", cls: "chip-ex" },
    { name: "MEM", cls: "chip-mem" },
    { name: "WB", cls: "chip-wb" },
  ];

  function renderPipeline() {
    if (!gridContainer) return;

    if (pipeMode === "seq") {
      // 4 instructions * 5 stages = 20 cycles
      if (pmCycles) pmCycles.textContent = "20 Cycles";
      if (pmThroughput) pmThroughput.textContent = "0.20 IPC (Stalled)";
      if (pmSpeedup) pmSpeedup.textContent = "1.00× (Baseline)";

      let html = `<div class="p-row p-head"><div class="p-cell p-label">Instruction</div>`;
      for (let c = 1; c <= 20; c++) {
        html += `<div class="p-cell p-col-hdr">C${c}</div>`;
      }
      html += `</div>`;

      for (let inst = 0; inst < 4; inst++) {
        html += `<div class="p-row"><div class="p-cell p-label">Inst ${inst + 1}</div>`;
        const startCycle = inst * 5;
        for (let c = 0; c < 20; c++) {
          if (c >= startCycle && c < startCycle + 5) {
            const stIdx = c - startCycle;
            html += `<div class="p-cell p-stage ${stages[stIdx].cls}">${stages[stIdx].name}</div>`;
          } else {
            html += `<div class="p-cell p-empty">&middot;</div>`;
          }
        }
        html += `</div>`;
      }
      gridContainer.innerHTML = html;
    } else {
      // Pipelined: 4 instructions overlap across 8 cycles
      if (pmCycles) pmCycles.textContent = "8 Cycles";
      if (pmThroughput) pmThroughput.textContent = "0.50 IPC (Peak 1.0)";
      if (pmSpeedup) pmSpeedup.textContent = "2.50× Faster!";

      let html = `<div class="p-row p-head"><div class="p-cell p-label">Instruction</div>`;
      for (let c = 1; c <= 8; c++) {
        html += `<div class="p-cell p-col-hdr">C${c}</div>`;
      }
      html += `</div>`;

      for (let inst = 0; inst < 4; inst++) {
        html += `<div class="p-row"><div class="p-cell p-label">Inst ${inst + 1}</div>`;
        const startCycle = inst; // 0, 1, 2, 3
        for (let c = 0; c < 8; c++) {
          if (c >= startCycle && c < startCycle + 5) {
            const stIdx = c - startCycle;
            html += `<div class="p-cell p-stage ${stages[stIdx].cls}">${stages[stIdx].name}</div>`;
          } else {
            html += `<div class="p-cell p-empty">&middot;</div>`;
          }
        }
        html += `</div>`;
      }
      gridContainer.innerHTML = html;
    }
  }

  btnSeq?.addEventListener("click", () => {
    pipeMode = "seq";
    btnSeq.classList.add("active");
    btnPipe?.classList.remove("active");
    renderPipeline();
  });

  btnPipe?.addEventListener("click", () => {
    pipeMode = "pipe";
    btnPipe.classList.add("active");
    btnSeq?.classList.remove("active");
    renderPipeline();
  });

  // Initial render
  renderPipeline();

  // ==========================================
  // WIDGET 3: MEMORY LATENCY SCALE WIDGET
  // ==========================================
  const memData: Record<string, { title: string; latency: string; timeText: string; desc: string; icon: string; width: string }> = {
    reg: {
      title: "CPU Register File (32 Registers, e.g. x0–x31)",
      latency: "Latency: < 0.5 nanoseconds (0 stall cycles)",
      timeText: "Human Scale: 1 Second",
      desc: "Like picking up a pencil already sitting in your hand. The processor computes immediately with zero stalls.",
      icon: "✍️",
      width: "3%"
    },
    l1: {
      title: "Level 1 Cache (16 KB - 64 KB SRAM)",
      latency: "Latency: ~1.5 nanoseconds (1–2 clock cycles)",
      timeText: "Human Scale: 3 Seconds",
      desc: "Like reaching for a cookbook sitting right on your kitchen counter. Ultra-fast, near-zero execution impact.",
      icon: "📖",
      width: "15%"
    },
    dram: {
      title: "Main Memory / DDR4 DRAM (8 GB - 64 GB)",
      latency: "Latency: ~60 nanoseconds (60–200 clock cycles)",
      timeText: "Human Scale: 4 Minutes",
      desc: "Like leaving your desk, walking downstairs, and searching through a pantry. The processor must pause execution and wait.",
      icon: "🚶",
      width: "55%"
    },
    ssd: {
      title: "Solid State Storage / NVMe SSD (1 TB - 4 TB)",
      latency: "Latency: ~50,000 nanoseconds (50,000+ clock cycles)",
      timeText: "Human Scale: 2.3 Months!",
      desc: "Like boarding a cargo sailboat and traveling across the ocean to pick up a single ingredient. The CPU switches to other processes entirely.",
      icon: "⛵",
      width: "100%"
    }
  };

  const memTitle = document.getElementById("memTitle");
  const memLatency = document.getElementById("memLatency");
  const hsTimeText = document.getElementById("hsTimeText");
  const hsDescText = document.getElementById("hsDescText");
  const hsIcon = document.getElementById("hsIcon");
  const latencyBarFill = document.getElementById("latencyBarFill");

  document.querySelectorAll(".mem-level-btn").forEach(btn => {
    btn.addEventListener("click", () => {
      document.querySelectorAll(".mem-level-btn").forEach(b => b.classList.remove("active"));
      btn.classList.add("active");
      const lvl = btn.getAttribute("data-level") || "reg";
      const info = memData[lvl];
      if (info) {
        if (memTitle) memTitle.textContent = info.title;
        if (memLatency) memLatency.textContent = info.latency;
        if (hsTimeText) hsTimeText.textContent = info.timeText;
        if (hsDescText) hsDescText.textContent = info.desc;
        if (hsIcon) hsIcon.textContent = info.icon;
        if (latencyBarFill) latencyBarFill.style.width = info.width;
      }
    });
  });
</script>

