  @media (max-width: 768px) {
    .fund-title {
      font-size: 1.4rem;
      line-height: 1.25;
    }
  }

  @media (max-width: 480px) {
    .fund-title {
      font-size: 1.2rem;
    }
  }

  .fund-lead {
    font-size: 1.05rem;
    color: var(--ink-light);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  @media (max-width: 640px) {
    .fund-lead {
      font-size: 0.95rem;
      line-height: 1.55;
      margin-bottom: 1.2rem;
    }
  }

  /* Top-Down Concept Stream System */
  .concept-stream {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .concept-step-card {
    background: var(--paper);
    border: 1.5px solid var(--ink);
    border-radius: 10px;
    padding: 1.5rem;
    box-shadow: 2.5px 2.5px 0px var(--ink);
    position: relative;
  }

  @media (max-width: 640px) {
    .concept-step-card {
      padding: 1.15rem 0.9rem;
      border-radius: 8px;
      box-shadow: 2px 2px 0px var(--ink);
    }
  }

  .step-card-header {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }

  .step-tag {
    background: var(--yellow);
    color: var(--ink);
    font-family: var(--md-code-font, monospace);
    font-weight: 900;
    font-size: 0.72rem;
    padding: 0.15rem 0.5rem;
    border-radius: 6px;
    border: 1.5px solid var(--ink);
    line-height: 1.2;
    display: inline-block;
  }

  .step-card-title {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 850;
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  @media (max-width: 640px) {
    .step-card-title {
      font-size: 1.05rem;
    }
  }

  .concept-step-card p {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--ink-light);
    margin-top: 0;
    margin-bottom: 0.75rem;
  }

  .concept-list {
    margin: 0;
    padding-left: 1.25rem;
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--ink-light);
    margin-bottom: 0.75rem;
  }

  .concept-list li {
    margin-bottom: 0.4rem;
  }

  .formula-box {
    background: var(--cream);
    border: 1.5px solid var(--ink);
    border-radius: 8px;
    padding: 0.85rem;
    margin: 0.85rem 0;
    text-align: center;
    font-size: 0.95rem;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    word-break: break-word;
  }

  .formula-label {
    font-weight: 800;
    color: var(--ink);
    margin-right: 0.5rem;
  }

  .small-text {
    font-size: 0.84rem;
    color: var(--ink-light);
    line-height: 1.5;
  }

  /* ============================================================ */
  /* SCHEMATICS & DIAGRAM CONTAINERS                              */
  /* ============================================================ */
  .schematic-container {
    background: var(--cream);
    border: 2px solid var(--ink);
    border-radius: 10px;
    padding: 1rem;
    margin: 1.25rem 0;
    box-shadow: 3px 3px 0px var(--ink);
  }

  @media (max-width: 640px) {
    .schematic-container {
      padding: 0.75rem 0.5rem;
    }
  }

  .schematic-header {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }

  .schematic-tag {
    background: var(--ink);
    color: #ffffff;
    font-size: 0.68rem;
    font-weight: 800;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    font-family: var(--md-code-font, monospace);
  }

  .schematic-title {
    font-size: 0.95rem;
    font-weight: 850;
    color: var(--ink);
  }

  .schematic-svg-wrap {
    background: #ffffff;
    border: 1.5px solid var(--ink);
    border-radius: 8px;
    padding: 0.5rem;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    display: flex;
    justify-content: center;
  }

  .schematic-svg {
    width: 100%;
    max-width: 720px;
    height: auto;
    min-width: 320px;
    display: block;
  }

  .schematic-caption {
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--ink-light);
    margin-top: 0.65rem;
    border-top: 1px dashed var(--line);
    padding-top: 0.5rem;
  }

  /* ============================================================ */
  /* PROBLEM & DESIGN TRADE-OFF BOX                               */
  /* ============================================================ */
  .tradeoff-box {
    background: #fffbeb;
    border: 2px solid var(--ink);
    border-radius: 10px;
    padding: 1.25rem;
    margin: 1.25rem 0;
    box-shadow: 3px 3px 0px var(--ink);
  }

  @media (max-width: 640px) {
    .tradeoff-box {
      padding: 1rem 0.85rem;
    }
  }

  .tradeoff-badge {
    display: inline-block;
    background: var(--yellow);
    color: var(--ink);
    border: 1.5px solid var(--ink);
    font-size: 0.72rem;
    font-weight: 900;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    margin-bottom: 0.85rem;
    box-shadow: 1.5px 1.5px 0px var(--ink);
  }

  .tradeoff-grid {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .tradeoff-col {
    background: var(--paper);
    border: 1.5px solid var(--ink);
    border-radius: 8px;
    padding: 0.85rem 1rem;
  }

  .to-label {
    display: block;
    font-size: 0.82rem;
    font-weight: 900;
    color: var(--ink);
    margin-bottom: 0.35rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .tradeoff-col p {
    font-size: 0.86rem;
    line-height: 1.5;
    margin: 0;
    color: var(--ink);
  }

  /* ============================================================ */
  /* SUBTOPIC LIVE INTERACTIVE WIDGETS                            */
  /* ============================================================ */
  .sub-interactive-card {
    background: var(--paper);
    border: 2px solid var(--ink);
    border-radius: 10px;
    padding: 1.25rem;
    margin: 1.25rem 0 0.5rem 0;
    box-shadow: 3px 3px 0px var(--ink);
  }

  @media (max-width: 640px) {
    .sub-interactive-card {
      padding: 1rem 0.75rem;
    }
  }

  .sub-widget-header {
    margin-bottom: 1rem;
  }

  .sub-w-tag {
    display: inline-block;
    background: var(--cyan);
    color: var(--ink);
    border: 1px solid var(--ink);
    font-size: 0.68rem;
    font-weight: 900;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    margin-bottom: 0.35rem;
  }

  .sub-w-title {
    font-size: 1.15rem;
    font-weight: 900;
    color: var(--ink);
    margin: 0 0 0.25rem 0;
  }

  .sub-w-desc {
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--ink-light);
    margin: 0;
  }

  /* CMOS Power Widget Controls */
  .cmos-ctrl-row {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    background: var(--cream);
    border: 1.5px solid var(--ink);
    border-radius: 8px;
    padding: 0.85rem 1rem;
    margin-bottom: 1rem;
  }

  .cmos-toggle-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .ctrl-label {
    font-size: 0.78rem;
    font-weight: 800;
    color: var(--ink);
    display: block;
  }

  .val-mono {
    font-family: var(--md-code-font, monospace);
    color: #0369a1;
    font-weight: 900;
  }

  .slider-ctrl {
    flex: 1;
    min-width: 140px;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .cmos-metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 0.75rem;
  }

  @media (max-width: 640px) {
    .cmos-metrics-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .cmos-m-card {
    background: var(--cream);
    border: 1.5px solid var(--ink);
    border-radius: 8px;
    padding: 0.75rem;
    text-align: center;
  }

  .cmos-m-card.highlight {
    background: var(--yellow-soft);
    border: 2px solid var(--ink);
  }

  .m-caption {
    display: block;
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--ink-light);
    margin-bottom: 0.3rem;
  }

  .m-status {
    display: block;
    font-size: 0.95rem;
    font-weight: 900;
    margin-bottom: 0.25rem;
  }

  .m-status.on { color: #15803d; }
  .m-status.off { color: #b91c1c; }
  .m-status.vout { color: #0284c7; }
  .m-status.power { color: #b45309; font-size: 1.15rem; }

  .m-detail {
    font-size: 0.72rem;
    color: var(--ink-light);
    display: block;
  }

  /* Standard Cell Selector */
  .cell-selector-bar {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  @media (max-width: 640px) {
    .cell-selector-bar {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .cell-btn {
    background: var(--cream);
    border: 1.5px solid var(--ink);
    border-radius: 6px;
    padding: 0.35rem 0.65rem;
    font-size: 0.78rem;
    font-weight: 800;
    cursor: pointer;
  }

  .cell-btn.active {
    background: var(--yellow);
    box-shadow: 2px 2px 0px var(--ink);
    transform: translate(-1px, -1px);
  }

  .cell-detail-card {
    background: var(--cream, #fffaf0);
    border: 2px solid var(--ink, #151b20);
    border-radius: 10px;
    padding: 1.25rem;
    box-shadow: 3px 3px 0 var(--ink, #151b20);
  }

  .cd-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .cd-item {
    background: #ffffff;
    border: 1.5px solid var(--ink, #151b20);
    border-radius: 8px;
    padding: 0.85rem 1rem;
    box-shadow: 2px 2px 0 var(--ink, #151b20);
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  .cd-lbl {
    display: block;
    font-size: 0.72rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-light, #52606d);
    margin-bottom: 0.35rem;
  }

  .cd-val {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .cd-primary,
  :global(.cd-primary) {
    font-size: 1.15rem;
    font-weight: 900;
    line-height: 1.25;
    color: var(--ink, #151b20);
    font-family: var(--md-code-font, monospace);
  }

  .cd-val.highlight .cd-primary,
  :global(.cd-val.highlight .cd-primary) {
    color: #b45309;
  }

  .cd-sub,
  :global(.cd-sub) {
    font-size: 0.82rem;
    font-weight: 700;
    color: #4b5563;
    line-height: 1.35;
  }

  .cd-desc {
    font-size: 0.88rem;
    line-height: 1.6;
    margin: 0;
    color: var(--ink, #151b20);
    border-top: 1.5px dashed var(--line, #cbd5e1);
    padding-top: 0.85rem;
  }

  
  /* Enforce clean inline rendering for prose inline formatting tags */
  p em,
  p strong,
  p code,
  p sub,
  p sup,
  .concept-step-card p em,
  .fund-section-card p em {
    display: inline !important;
    text-align: inherit !important;
    margin: 0 !important;
    color: inherit !important;
    font-size: inherit !important;
  }

  p em {
    font-style: italic;
  }

  p strong,
  .concept-step-card p strong,
  .fund-section-card p strong {
    font-style: normal;
    font-weight: 850;
    color: var(--ink, #151b20);
  }

  /* Pill Button Group */
  .pill-btn-group {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .pill-btn {
    background: var(--cream);
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    padding: 0.3rem 0.65rem;
    font-size: 0.76rem;
    font-weight: 800;
    cursor: pointer;
  }

  .pill-btn.active {
    background: var(--cyan);
    box-shadow: 1.5px 1.5px 0px var(--ink);
    transform: translate(-1px, -1px);
  }

  .amp-card, .ilm-card, .im-card {
    background: var(--cream);
    border: 1.5px solid var(--ink);
    border-radius: 8px;
    padding: 0.75rem 1rem;
    text-align: center;
  }

  .amp-card.highlight, .ilm-card.highlight, .im-card.highlight {
    background: var(--yellow-soft);
    border: 2px solid var(--ink);
  }

  .adder-metrics-panel, .rvv-metrics-panel, .iron-law-metrics-grid, .interconnect-metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .amp-label, .ilm-lbl {
    display: block;
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--ink-light);
    margin-bottom: 0.25rem;
  }

  .amp-val, .ilm-val {
    display: block;
    font-size: 1.35rem;
    font-weight: 900;
    color: var(--ink);
    margin-bottom: 0.2rem;
  }

  .amp-sub, .ilm-sub {
    font-size: 0.72rem;
    color: var(--ink-light);
  }

  /* Hazard Simulator */
  .hazard-ctrl-row {
    display: flex;
    gap: 1rem;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .hazard-result-display {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 0.75rem;
    background: var(--cream);
    border: 1.5px solid var(--ink);
    border-radius: 8px;
    padding: 0.85rem;
  }

  .hr-metric {
    text-align: center;
  }

  .hr-label {
    display: block;
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--ink-light);
    margin-bottom: 0.2rem;
  }

  .hr-val {
    font-size: 1.25rem;
    font-weight: 900;
    color: var(--ink);
  }

  .hr-val.zero { color: #15803d; }
  .hr-val.bad { color: #b91c1c; }

  .toggle-btn.is-off {
    background: #fecaca;
    color: #991b1b;
  }

  /* Sv39 Card */
  .sv39-breakdown-card {
    background: var(--cream);
    border: 1.5px solid var(--ink);
    border-radius: 8px;
    padding: 1rem;
    margin-top: 1rem;
  }

  .sv39-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  @media (max-width: 640px) {
    .sv39-row {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .sv39-col {
    background: var(--paper);
    border: 1.5px solid var(--ink);
    border-radius: 6px;
    padding: 0.65rem;
    text-align: center;
  }

  .sv39-lbl {
    display: block;
    font-size: 0.68rem;
    font-weight: 800;
    color: var(--ink-light);
    margin-bottom: 0.2rem;
  }

  .sv39-hex {
    display: block;
    font-size: 0.95rem;
    font-weight: 900;
    font-family: var(--md-code-font, monospace);
    color: var(--ink);
  }

  .sv39-bits {
    font-size: 0.68rem;
    color: var(--ink-light);
  }

  .c-vpn2 { border-top: 4px solid #ea580c; }
  .c-vpn1 { border-top: 4px solid #16a34a; }
  .c-vpn0 { border-top: 4px solid #2563eb; }
  .c-off  { border-top: 4px solid #ca8a04; }

  .sv39-pa-res {
    background: var(--paper);
    border: 1.5px solid var(--ink);
    border-radius: 6px;
    padding: 0.65rem 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .pa-lbl { font-size: 0.8rem; font-weight: 800; }
  .pa-val { font-size: 1.05rem; font-weight: 900; font-family: var(--md-code-font, monospace); color: #0284c7; }

  /* Interconnect Grid */
  .im-title {
    display: block;
    font-size: 0.88rem;
    font-weight: 900;
    margin-bottom: 0.5rem;
  }

  .im-stat {
    font-size: 0.82rem;
    margin-bottom: 0.35rem;
  }

  .status-bad { color: #dc2626; font-weight: 800; }
  .status-warn { color: #ca8a04; font-weight: 800; }
  .status-good { color: #16a34a; font-weight: 800; }

  /* Interactive Widget Outer Box */
  .interactive-widget-box {
    background: var(--paper);
    border: 2px solid var(--ink);
    border-radius: 12px;
    padding: 1.5rem;
    box-shadow: 4px 4px 0px var(--ink);
  }

  @media (max-width: 768px) {
    .interactive-widget-box {
      padding: 1.15rem 0.85rem;
      border-radius: 10px;
      box-shadow: 3px 3px 0px var(--ink);
    }
    .widget-title {
      font-size: 1.18rem;
      line-height: 1.3;
    }
  }

  .widget-header {
    margin-bottom: 1.25rem;
  }

  .widget-badge {
    background: var(--cyan);
    color: var(--ink);
    border: 1px solid var(--ink);
    border-radius: 4px;
    font-size: 0.72rem;
    font-weight: 800;
    padding: 0.15rem 0.45rem;
    display: inline-block;
    margin-bottom: 0.35rem;
  }

  .widget-title {
    font-size: 1.35rem;
    font-weight: 900;
    color: var(--ink);
    margin: 0.25rem 0 0.35rem 0;
  }

  .widget-desc {
    font-size: 0.88rem;
    color: var(--ink-light);
    line-height: 1.5;
    margin: 0;
  }

  /* Logic Gate Widget */
  .gate-selector-bar {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }

  @media (max-width: 640px) {
    .gate-selector-bar {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.35rem;
    }
  }

  .gate-btn {
    background: var(--cream);
    border: 1.5px solid var(--ink);
    border-radius: 6px;
    padding: 0.35rem 0.85rem;
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--ink);
    cursor: pointer;
    transition: all 0.12s ease;
  }

  @media (max-width: 640px) {
    .gate-btn {
      padding: 0.35rem 0.25rem;
      font-size: 0.78rem;
      text-align: center;
    }
  }

  .gate-btn.active {
    background: var(--yellow);
    box-shadow: 2px 2px 0px var(--ink);
    transform: translate(-1px, -1px);
  }

  .gate-sim-body {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .circuit-interactive-panel {
    background: var(--cream);
    border: 1.5px solid var(--ink);
    border-radius: 10px;
    padding: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: 180px;
  }

  @media (max-width: 540px) {
    .circuit-interactive-panel {
      padding: 0.85rem 0.5rem;
      gap: 0.35rem;
      min-height: 160px;
    }
  }

  .inputs-group {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .input-ctrl {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .in-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--ink);
  }

  .toggle-btn {
    background: #e2e8f0;
    border: 1.5px solid var(--ink);
    border-radius: 6px;
    padding: 0.4rem 0.75rem;
    font-size: 0.82rem;
    font-weight: 800;
    cursor: pointer;
    box-shadow: 2px 2px 0px var(--ink);
    transition: all 0.1s ease;
  }

  .toggle-btn.is-on {
    background: var(--lime);
  }

  .gate-symbol-visual {
    display: flex;
    align-items: center;
    position: relative;
  }

  .gate-box-art {
    background: var(--ink);
    color: #ffffff;
    border: 2px solid var(--ink);
    border-radius: 8px;
    padding: 1rem 1.25rem;
    text-align: center;
    box-shadow: 3px 3px 0px var(--yellow);
    min-width: 110px;
  }

  .gate-art-name {
    display: block;
    font-size: 1.2rem;
    font-weight: 900;
  }

  .gate-art-formula {
    display: block;
    font-size: 0.75rem;
    color: var(--yellow);
    margin-top: 0.25rem;
    font-family: var(--md-code-font, monospace);
  }

  .output-bulb-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
  }

  .out-label {
    font-size: 0.75rem;
    font-weight: 700;
  }

  .bulb-lamp {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    border: 2px solid var(--ink);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 900;
    font-size: 1.25rem;
    box-shadow: 2px 2px 0px var(--ink);
    transition: all 0.2s ease;
