                <th style="min-width: 80px;">'C' Ext</th>
                <th style="min-width: 140px;">Key Advanced Exts</th>
                <th style="min-width: 260px;">Architectural Motive &amp; Target Niche</th>
              </tr>
            </thead>
            <tbody>
              <tr>
