    color: var(--ink-light, #242c33);
    margin: 0;
  }

  .prim-micro-insights {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    background: var(--paper-deep, #eee4c8);
    border: 1px solid var(--ink, #151b20);
    border-radius: 8px;
    padding: 0.85rem 1rem;
  }

  .prim-insight-row {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  @media (min-width: 680px) {
    .prim-insight-row {
      display: grid;
      grid-template-columns: 190px 1fr;
      align-items: baseline;
      gap: 0.75rem;
    }
  }

  .insight-label {
    font-size: 0.74rem;
    font-weight: 850;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink, #151b20);
    font-family: var(--md-code-font, monospace);
  }

  .insight-value {
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--ink-light, #151b20);
  }

  .mobile-scroll-hint {
    font-size: 0.76rem;
    font-weight: 800;
    color: var(--ink-light, #242c33);
    font-family: var(--md-code-font, monospace);
    text-align: center;
    padding: 0.4rem 0.5rem 0.1rem 0.5rem;
    display: none;
  }

  @media (max-width: 768px) {
    .mobile-scroll-hint {
      display: block;
    }
  }

  /* Section 1.2: Modular ISA Spectrum */
  .isa-subtopic-block {
    margin-bottom: 1.5rem;
  }

  .isa-subtopic-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--ink, #151b20);
    margin: 0 0 0.5rem 0;
    flex-wrap: wrap;
  }

  .isa-subtopic-text {
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--ink-light, #242c33);
    margin: 0 0 1rem 0;
  }

  .isa-base-grid {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .isa-base-card {
    background: #ffffff;
    border: 2px solid var(--ink, #151b20);
    border-radius: 10px;
    box-shadow: 3px 3px 0 var(--ink, #151b20);
    padding: 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .isa-base-card.isa-rv32i {
    border-left: 6px solid var(--teal, #0d9488);
  }

  .isa-base-card.isa-rv32e {
    border-left: 6px solid var(--coral, #f38469);
  }

  .isa-base-card-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .isa-code-pill {
    font-family: var(--md-code-font, monospace);
    font-weight: 900;
    font-size: 0.85rem;
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
    border: 1.5px solid var(--ink, #151b20);
  }

  .isa-rv32i .isa-code-pill {
    background: var(--teal, #0d9488);
    color: #ffffff;
  }

  .isa-rv32e .isa-code-pill {
    background: var(--coral, #f38469);
    color: #ffffff;
  }

  .isa-card-title-text {
    font-weight: 800;
    font-size: 0.96rem;
    color: var(--ink, #151b20);
  }

  .isa-base-card-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .isa-metric-item {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 0.5rem;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--ink-light, #242c33);
  }

  .isa-metric-label {
    font-weight: 800;
    color: var(--ink, #151b20);
    font-size: 0.8rem;
    font-family: var(--md-code-font, monospace);
    text-transform: uppercase;
  }

  .isa-metric-val {
    color: var(--ink-light, #242c33);
  }

  /* Modular Extensions Flow */
  .isa-extensions-flow {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .isa-ext-card {
    background: #ffffff;
    border: 2px solid var(--ink, #151b20);
    border-radius: 10px;
    box-shadow: 3px 3px 0 var(--ink, #151b20);
    padding: 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .isa-ext-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    border-bottom: 1px dashed var(--line, #eee4c8);
    padding-bottom: 0.65rem;
  }

  .isa-ext-badge-group {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .isa-ext-badge {
    font-size: 0.72rem;
    font-weight: 900;
    font-family: var(--md-code-font, monospace);
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    border: 1px solid var(--ink, #151b20);
  }

  .isa-ext-name {
    font-size: 0.98rem;
    font-weight: 800;
    color: var(--ink, #151b20);
  }

  .isa-cost-pill {
    font-size: 0.78rem;
    font-family: var(--md-code-font, monospace);
    font-weight: 800;
    background: var(--paper-deep, #eee4c8);
    color: var(--ink, #151b20);
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--ink, #151b20);
  }

  .isa-ext-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.91rem;
    line-height: 1.55;
    color: var(--ink-light, #242c33);
  }

  .isa-ext-body p {
    margin: 0;
  }

  .isa-adoption-note {
    background: var(--paper, #fffaf0);
    border-left: 3px solid var(--ink, #151b20);
    padding: 0.5rem 0.75rem;
    border-radius: 4px;
    font-size: 0.86rem;
    color: var(--ink, #151b20);
    margin-top: 0.25rem;
  }

  /* Section 1.3: Divergence Drivers */
  .drivers-grid {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .driver-card {
    background: #ffffff;
    border: 2px solid var(--ink, #151b20);
    border-radius: 12px;
    box-shadow: 3px 3px 0 var(--ink, #151b20);
    padding: 1.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .driver-card.driver-substrate {
    border-left: 6px solid var(--coral, #f38469);
  }

  .driver-card.driver-language {
    border-left: 6px solid var(--teal, #0d9488);
  }

  .driver-card.driver-mission {
    border-left: 6px solid var(--yellow, #ffc83e);
  }

  .driver-top-badge {
    font-size: 0.72rem;
    font-weight: 900;
    font-family: var(--md-code-font, monospace);
    letter-spacing: 0.04em;
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    border: 1px solid var(--ink, #151b20);
    display: inline-block;
    align-self: flex-start;
  }

  .driver-substrate .driver-top-badge { background: var(--coral, #f38469); color: #ffffff; }
  .driver-language .driver-top-badge { background: var(--teal, #0d9488); color: #ffffff; }
  .driver-mission .driver-top-badge { background: var(--yellow, #ffc83e); color: var(--ink, #151b20); }

  .driver-card h4 {
    font-size: 1.15rem;
    font-weight: 900;
    color: var(--ink, #151b20);
    margin: 0;
  }

  .driver-card p {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--ink-light, #242c33);
    margin: 0;
  }

  .driver-card p:last-child {
    margin-bottom: 0;
  }

  .formula-callout-box {
    background: #ffffff;
    border: 2px solid var(--ink, #151b20);
    border-left: 6px solid var(--yellow, #ffc83e);
    border-radius: 10px;
    padding: 1.25rem;
    box-shadow: 3px 3px 0 var(--ink, #151b20);
    margin-bottom: 1.25rem;
  }

  .formula-line {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--ink, #151b20);
    margin-bottom: 0.5rem;
  }

  .formula-line code {
    background: var(--paper-deep, #eee4c8);
    padding: 0.3rem 0.6rem;
    border-radius: 6px;
    border: 1px solid var(--ink, #151b20);
    font-family: var(--md-code-font, monospace);
  }

  .formula-explanation p {
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--ink-light, #151b20);
    margin: 0;
  }

  .archetypes-rationale-table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  /* Top-Down Progressive Architectural Ladder */
  .arch-ladder {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-bottom: 2rem;
  }

  .ladder-step {
    background: var(--paper, #fffaf0);
    border: 2px solid var(--ink, #151b20);
    border-radius: 12px;
    box-shadow: 4px 4px 0 var(--ink, #151b20);
    padding: 1.75rem;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .ladder-step:hover {
    transform: translateY(-2px);
    box-shadow: 6px 6px 0 var(--ink, #151b20);
  }

  .ladder-step.archetype-coral-border {
    border-left: 8px solid var(--coral, #f38469) !important;
  }

  .ladder-step.archetype-teal-border {
    border-left: 8px solid var(--teal, #0d9488) !important;
  }

  .ladder-step.archetype-lime-border {
    border-left: 8px solid var(--lime, #b7df69) !important;
  }

  .ladder-step.archetype-yellow-border {
    border-left: 8px solid var(--yellow, #ffc83e) !important;
  }

  .ladder-header {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    margin-bottom: 1.25rem;
  }

  .ladder-num-badge {
    font-size: 1.35rem;
    font-weight: 900;
    font-family: var(--md-code-font, monospace);
    width: 48px;
    height: 48px;
    border-radius: 10px;
    border: 2px solid var(--ink, #151b20);
    box-shadow: 2px 2px 0 var(--ink, #151b20);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .ladder-title-wrap {
    flex: 1;
  }

  .ladder-eyebrow {
    font-size: 0.72rem;
    font-weight: 900;
    font-family: var(--md-code-font, monospace);
    letter-spacing: 0.04em;
    color: var(--ink-light, #242c33);
    margin-bottom: 0.25rem;
    text-transform: uppercase;
  }

  .ladder-title {
    font-size: 1.35rem;
    font-weight: 900;
    color: var(--ink, #151b20);
    margin: 0;
    line-height: 1.3;
  }

  .ladder-body {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .ladder-narrative {
    font-size: 0.96rem;
    line-height: 1.6;
    color: var(--ink-light, #242c33);
    margin: 0;
  }

  .ladder-summary-bar {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0.75rem;
    margin-top: 0.5rem;
    background: #ffffff;
    border: 1.5px solid var(--ink, #151b20);
    border-radius: 8px;
    padding: 0.75rem 1rem;
    box-shadow: 2px 2px 0 var(--ink, #151b20);
  }

  .ladder-metric {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .lm-lbl {
    font-size: 0.7rem;
    font-weight: 800;
    font-family: var(--md-code-font, monospace);
    color: #242c33;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .lm-val {
    font-size: 0.88rem;
    font-weight: 800;
    color: var(--ink, #151b20);
  }

  /* Ladder Transition Connector */
  .ladder-connector {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0.85rem 0;
  }

  .connector-line {
    width: 0;
    height: 14px;
    border-left: 2px solid var(--ink, #151b20);
  }

  .connector-pill {
    background: var(--paper-deep, #eee4c8);
    border: 1.5px solid var(--ink, #151b20);
    border-radius: 999px;
    box-shadow: 2px 2px 0 var(--ink, #151b20);
    padding: 0.35rem 1rem;
    font-size: 0.76rem;
    font-weight: 800;
    color: var(--ink, #151b20);
    text-align: center;
    max-width: 90%;
  }

  /* Section 1.1 Styles */
  .archetype-coral-border {
    border-top: 5px solid var(--coral, #f38469) !important;
  }

  .archetype-teal-border {
    border-top: 5px solid var(--teal, #0d9488) !important;
  }

  .archetype-lime-border {
    border-top: 5px solid var(--lime, #b7df69) !important;
  }

  .archetype-yellow-border {
    border-top: 5px solid var(--yellow, #ffc83e) !important;
  }

  .concept-stream {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .concept-step-card {
    background: var(--paper, #fffaf0);
    border: 2px solid var(--ink, #151b20);
    border-radius: 12px;
    box-shadow: 4px 4px 0 var(--ink, #151b20);
    padding: 1.75rem;
  }

  .step-card-header {
    margin-bottom: 0.75rem;
  }

  .step-tag {
    font-size: 0.72rem;
    font-weight: 900;
    font-family: var(--md-code-font, monospace);
    letter-spacing: 0.04em;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    border: 1px solid var(--ink, #151b20);
    display: inline-block;
    margin-bottom: 0.4rem;
  }

  .step-card-title {
    font-size: 1.45rem;
    font-weight: 900;
    color: var(--ink, #151b20);
    margin: 0;
    letter-spacing: -0.01em;
  }

  .step-card-lead {
    font-size: 0.98rem;
    line-height: 1.6;
    color: var(--ink-light, #151b20);
    margin-bottom: 1.5rem;
  }

  .sub-topic-card {
    background: #ffffff;
    border: 1.5px solid var(--ink, #151b20);
    border-radius: 10px;
    padding: 1.5rem;
    box-shadow: 3px 3px 0 var(--ink, #151b20);
    margin-bottom: 1.5rem;
  }

  .sub-topic-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.85rem;
    padding-bottom: 0.5rem;
    border-bottom: 1.5px dashed var(--line, #eee4c8);
    flex-wrap: nowrap;
  }

  .sub-topic-title-group {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    min-width: 0;
    flex: 1;
  }

  .sub-topic-head h4,
  .sub-topic-title {
    font-size: 1.12rem;
    font-weight: 900;
    color: var(--ink, #151b20);
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sub-topic-spec-badge {
    font-size: 0.75rem;
    font-weight: 800;
    font-family: var(--md-code-font, monospace);
    background: var(--paper-deep, #eee4c8);
    color: var(--ink, #151b20);
    border: 1px solid var(--ink, #151b20);
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .pill-badge {
    font-size: 0.72rem;
    font-weight: 900;
    font-family: var(--md-code-font, monospace);
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    border: 1px solid var(--ink, #151b20);
  }

  .schematic-container {
    background: var(--paper, #fffaf0);
    border: 2px solid var(--ink, #151b20);
    border-radius: 10px;
    padding: 1.25rem;
    margin: 1.25rem 0;
    box-shadow: 3px 3px 0 var(--ink, #151b20);
  }

  .schematic-header {
    margin-bottom: 0.75rem;
  }

  .schematic-tag {
    font-size: 0.7rem;
    font-weight: 900;
    font-family: var(--md-code-font, monospace);
    background: var(--yellow, #ffc83e);
    color: var(--ink, #151b20);
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    border: 1px solid var(--ink, #151b20);
    display: inline-block;
    margin-bottom: 0.35rem;
  }

  .schematic-title {
    font-size: 1.1rem;
    font-weight: 900;
    color: var(--ink, #151b20);
    margin: 0;
  }

  .schematic-svg-wrap {
    width: 100%;
    overflow-x: auto;
    border-radius: 8px;
    margin-bottom: 0.75rem;
  }

  .schematic-svg {
    width: 100%;
    min-width: 680px;
    height: auto;
    display: block;
  }

  .schematic-caption {
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--ink-light, #242c33);
    margin: 0;
  }

  /* Interactive Workbench Card */
  .interactive-workbench-card {
    background: var(--cream, #fffaf0);
    border: 2px solid var(--ink, #151b20);
    border-radius: 12px;
    padding: 1.75rem;
    box-shadow: 4px 4px 0 var(--yellow, #ffc83e);
    margin: 2rem 0;
  }

  .workbench-header {
    margin-bottom: 1.25rem;
  }

  .w-badge {
    font-size: 0.72rem;
    font-weight: 900;
    font-family: var(--md-code-font, monospace);
    background: var(--cream-soft, #f6f0dc);
    color: var(--ink, #151b20);
    border: 1px solid var(--ink, #151b20);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    display: inline-block;
    margin-bottom: 0.4rem;
  }

  .w-title {
    font-size: 1.35rem;
    font-weight: 900;
    color: var(--ink, #151b20);
    margin: 0 0 0.4rem 0;
  }

  .w-desc {
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--ink-light, #242c33);
    margin: 0;
  }

  .sim-ctrl-deck {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1.25rem;
    background: var(--paper, #fffaf0);
    border: 1.5px solid var(--ink, #151b20);
    border-radius: 8px;
    padding: 1rem;
    margin-bottom: 1.25rem;
  }

  .ctrl-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .ctrl-label {
    font-size: 0.78rem;
    font-weight: 800;
    color: var(--ink-light, #242c33);
    text-transform: uppercase;
  }

  .btn-toggle-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .sim-toggle-btn {
    background: #ffffff;
    border: 1.5px solid var(--ink, #151b20);
    border-radius: 6px;
    box-shadow: 2px 2px 0 var(--ink, #151b20);
    padding: 0.35rem 0.65rem;
    font-size: 0.8rem;
    font-weight: 800;
    color: var(--ink, #151b20);
    cursor: pointer;
    transition: all 0.1s ease;
  }

  .sim-toggle-btn:hover {
    background: var(--yellow-soft, #fff0b9);
  }

  .sim-toggle-btn.active {
    background: var(--yellow, #ffc83e);
    box-shadow: 2px 2px 0 var(--ink, #151b20);
  }

  .action-btn-row {
    display: flex;
    gap: 0.5rem;
  }

  .sim-monitor-display {
    background: #ffffff;
    border: 2px solid var(--ink, #151b20);
    border-radius: 10px;
    box-shadow: 3px 3px 0 var(--ink, #151b20);
    padding: 1.25rem;
  }

  .monitor-top-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .mon-block {
    display: flex;
    flex-direction: column;
  }

  .mon-lbl {
    font-size: 0.75rem;
    font-weight: 800;
    color: #242c33;
    text-transform: uppercase;
  }

  .mon-val {
    font-size: 0.95rem;
    font-weight: 900;
    color: var(--ink, #151b20);
  }

  .progress-wrap {
    width: 100%;
    height: 10px;
    background: var(--paper-deep, #eee4c8);
    border: 1.5px solid var(--ink, #151b20);
    border-radius: 5px;
    overflow: hidden;
    margin-bottom: 1rem;
  }

  .progress-bar-fill {
    height: 100%;
    background: var(--lime, #b7df69);
    transition: width 0.15s ease;
  }

  .datapath-status-box {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--cream, #fffaf0);
    border: 1.5px solid var(--ink, #151b20);
    border-radius: 6px;
    padding: 0.75rem 1rem;
    margin-bottom: 1rem;
  }

  .status-indicator-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--lime, #b7df69);
    border: 1px solid var(--ink, #151b20);
    animation: pulse 1.5s infinite ease-in-out;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.85); }
  }

  .status-msg {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--ink, #151b20);
    line-height: 1.4;
  }

  .live-metrics-strip {
    display: grid;
