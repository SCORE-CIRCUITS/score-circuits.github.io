    text-transform: uppercase;
  }

  .btn-toggle-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .sim-toggle-btn {
    background: #ffffff;
    border: 1.5px solid var(--ink, #151b20);
