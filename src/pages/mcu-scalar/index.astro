  .sim-num.num-teal { background: var(--teal, #0d9488); color: #ffffff; }
  .sim-num.num-purple { background: var(--purple, #8275e8); color: #ffffff; }
  .sim-num.num-yellow { background: var(--yellow, #ffc83e); color: var(--ink, #151b20); }
  .sim-num.num-lime { background: var(--lime, #b7df69); color: var(--ink, #151b20); }

  .sim-header h4 {
    font-size: 1.15rem;
    font-weight: 900;
