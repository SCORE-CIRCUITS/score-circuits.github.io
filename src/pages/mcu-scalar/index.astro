  .table-heading {
    font-size: 1.35rem;
    font-weight: 900;
    color: var(--ink, #151b20);
    margin: 0 0 0.25rem 0;
  }

  .table-caption {
    font-size: 0.9rem;
    color: var(--ink-light, #242c33);
    margin: 0;
  }

  /* Table styling */
  .table-scroll {
    overflow-x: auto;
    margin-bottom: 1.25rem;
    border-radius: 10px;
    border: 2px solid var(--ink, #151b20);
    background: #ffffff;
    box-shadow: 3px 3px 0 var(--ink, #151b20);
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.86rem;
  }

  .data-table th, .data-table td {
    padding: 0.75rem 0.85rem;
    border: 1px solid var(--line, #eee4c8);
    text-align: left;
    vertical-align: middle;
  }

  .data-table th {
    background: var(--cream-soft, #f6f0dc);
    color: var(--ink, #151b20);
    font-weight: 800;
    font-size: 0.82rem;
    letter-spacing: 0.02em;
    white-space: nowrap;
    border-bottom: 2px solid var(--ink, #151b20);
  }

  .data-table tr:nth-child(even) td {
    background: var(--paper, #fffaf0);
  }

  .score-badge {
    background: var(--yellow, #ffc83e);
    color: var(--ink, #151b20);
    padding: 0.2rem 0.5rem;
    font-weight: 900;
    font-family: var(--md-code-font, monospace);
    border: 1.5px solid var(--ink, #151b20);
    border-radius: 4px;
    box-shadow: 1.5px 1.5px 0 var(--ink, #151b20);
    display: inline-block;
  }

  .highlight-row {
    background: #fff0b9 !important;
  }

  .table-footnote {
    font-size: 0.8rem;
    color: var(--ink-light, #242c33);
    font-style: italic;
    margin-top: 0.5rem;
  }

  /* ==========================================================================
     Level 1 Benchmark Leaderboard: Master Table, KPI Grid & Interactive Controls
     ========================================================================== */

  /* KPI Scoreboard Grid */
  .lb-kpi-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin: 1.5rem 0 1.25rem 0;
  }

  .lb-kpi-card {
    background: #ffffff;
    border: 2px solid var(--ink, #151b20);
    border-radius: 10px;
    box-shadow: 3px 3px 0 var(--ink, #151b20);
    padding: 1rem 1.15rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .lb-kpi-card:hover {
    transform: translateY(-2px);
    box-shadow: 4px 4px 0 var(--ink, #151b20);
  }

  .lb-kpi-badge {
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-light, #242c33);
    margin-bottom: 0.35rem;
  }

  .lb-kpi-value {
    font-size: 1.85rem;
    font-weight: 900;
    font-family: var(--md-code-font, monospace);
    line-height: 1.1;
    margin-bottom: 0.2rem;
  }

  .lb-kpi-card .text-accent {
    color: #22bfd7;
  }

  .lb-kpi-card .text-teal {
    color: #0d9488;
  }

  .lb-kpi-card .text-coral {
    color: #f38469;
  }

  .lb-kpi-card .text-lime {
    color: #b7df69;
  }

  .lb-kpi-core {
    font-size: 0.92rem;
    font-weight: 800;
    color: var(--ink, #151b20);
  }

  .lb-kpi-meta {
    font-size: 0.76rem;
    color: var(--ink-light, #242c33);
    margin-top: 0.2rem;
    line-height: 1.35;
  }

  /* Interactive Filter, Search & Sort Control Bar */
  .lb-controls-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    margin: 1.25rem 0 1rem 0;
    padding: 0.85rem 1rem;
    background: var(--cream-soft, #f6f0dc);
    border: 2px solid var(--ink, #151b20);
    border-radius: 10px;
    box-shadow: 3px 3px 0 var(--ink, #151b20);
  }

  .lb-filter-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .lb-filter-label {
    font-size: 0.78rem;
    font-weight: 800;
    color: var(--ink, #151b20);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .lb-filter-pills {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .lb-pill {
    background: #ffffff;
    border: 1.5px solid var(--ink, #151b20);
    border-radius: 6px;
    padding: 0.28rem 0.65rem;
    font-size: 0.76rem;
    font-weight: 700;
    color: var(--ink, #151b20);
    cursor: pointer;
    transition: all 0.15s ease;
    box-shadow: 1.5px 1.5px 0 var(--ink, #151b20);
  }

  .lb-pill:hover {
    background: #fff0b9;
    transform: translate(-1px, -1px);
    box-shadow: 2px 2px 0 var(--ink, #151b20);
  }

  .lb-pill.active {
    background: var(--ink, #151b20);
    color: #ffffff;
    border-color: var(--ink, #151b20);
    box-shadow: 1.5px 1.5px 0 #22bfd7;
  }

  .lb-search-sort-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .lb-search-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }

  .lb-search-icon {
    position: absolute;
    left: 0.65rem;
    font-size: 0.82rem;
    pointer-events: none;
    opacity: 0.6;
  }

  .lb-search-input {
    padding: 0.35rem 1.8rem 0.35rem 2.05rem;
    font-size: 0.8rem;
    font-weight: 600;
    border: 1.5px solid var(--ink, #151b20);
    border-radius: 6px;
    background: #ffffff;
    width: 240px;
    outline: none;
    transition: border-color 0.15s, box-shadow 0.15s;
    color: var(--ink, #151b20);
  }

  .lb-search-input:focus {
    border-color: #22bfd7;
    box-shadow: 0 0 0 2px rgba(2, 132, 199, 0.25);
  }

  .lb-clear-btn {
    position: absolute;
    right: 0.5rem;
    background: transparent;
    border: none;
    font-size: 1.15rem;
    cursor: pointer;
    color: #242c33;
    line-height: 1;
    padding: 0;
  }

  .lb-clear-btn:hover {
    color: #151b20;
  }

  .lb-sort-wrap {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .lb-sort-label {
    font-size: 0.78rem;
    font-weight: 800;
    color: var(--ink, #151b20);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .lb-sort-select {
    padding: 0.32rem 0.65rem;
    font-size: 0.78rem;
    font-weight: 700;
    border: 1.5px solid var(--ink, #151b20);
    border-radius: 6px;
    background: #ffffff;
    color: var(--ink, #151b20);
    cursor: pointer;
    outline: none;
  }

  .lb-sort-select:focus {
    border-color: #22bfd7;
  }

  /* Leaderboard Scroll Container & Master Table */
  .leaderboard-scroll {
    position: relative;
    max-width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border-radius: 10px;
    border: 2px solid var(--ink, #151b20);
    box-shadow: 4px 4px 0 var(--ink, #151b20);
    background: #ffffff;
    margin-bottom: 1.25rem;
  }

  .leaderboard-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    font-size: 0.84rem;
  }

  .leaderboard-table th,
  .leaderboard-table td {
    padding: 0.65rem 0.85rem;
    border-bottom: 1px solid var(--line, #eee4c8);
    border-right: 1px solid var(--line, #eee4c8);
    vertical-align: middle;
  }

  .leaderboard-table th:last-child,
  .leaderboard-table td:last-child {
    border-right: none;
  }

  .leaderboard-table thead th {
    background: var(--cream-soft, #f6f0dc);
    color: var(--ink, #151b20);
    font-weight: 800;
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border-bottom: 2px solid var(--ink, #151b20);
    position: sticky;
    top: 0;
    z-index: 5;
    user-select: none;
  }

  .leaderboard-table thead th[data-sort] {
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .leaderboard-table thead th[data-sort]:hover {
    background: #fff0b9;
  }

  .th-content {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    white-space: nowrap;
  }

  .th-content-right {
    justify-content: flex-end;
    width: 100%;
  }

  .th-content-center {
    justify-content: center;
    width: 100%;
  }

  .sort-icon {
    font-size: 0.82rem;
    opacity: 0.4;
    transition: opacity 0.15s, transform 0.15s;
  }

  th.sort-active .sort-icon {
    opacity: 1;
    color: #22bfd7;
    font-weight: 900;
  }

  th.sort-asc .sort-icon {
    transform: rotate(180deg);
  }

  /* Sticky First Column */
  .leaderboard-table th.sticky-col,
  .leaderboard-table td.sticky-col {
    position: sticky;
    left: 0;
    min-width: 230px;
    max-width: 280px;
    border-right: 2px solid var(--ink, #151b20) !important;
    box-shadow: 4px 0 8px -2px rgba(21, 27, 32, 0.15);
  }

  .leaderboard-table th.sticky-col {
    z-index: 12;
    background: var(--cream-soft, #f6f0dc);
  }

  .leaderboard-table td.sticky-col {
    z-index: 10;
    background: #ffffff;
  }

  .leaderboard-table tr:nth-child(even) td.sticky-col {
    background: var(--paper, #fffaf0);
  }

  .leaderboard-table tr.highlight-row td.sticky-col {
    background: #fff0b9;
  }

  /* Synchronized Hover across all cells including sticky column */
  .leaderboard-table tbody tr:hover td,
  .leaderboard-table tbody tr:hover td.sticky-col {
    background: #e7f4c8 !important;
  }

  /* First Column Cell Details */
  .col-rank-core-wrap {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .rank-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.1rem;
    height: 1.85rem;
    padding: 0 0.3rem;
    font-size: 0.76rem;
    font-weight: 900;
    font-family: var(--md-code-font, monospace);
    border-radius: 6px;
    border: 1.5px solid var(--ink, #151b20);
    box-shadow: 1.5px 1.5px 0 var(--ink, #151b20);
    flex-shrink: 0;
  }

  .rank-gold {
    background: linear-gradient(135deg, #fff0b9 0%, #ffc83e 100%);
    color: #151b20;
  }

  .rank-silver {
    background: linear-gradient(135deg, #f6f0dc 0%, #151b20 100%);
    color: #151b20;
  }

  .rank-bronze {
    background: linear-gradient(135deg, #ffd8ce 0%, #ffc83e 100%);
    color: #151b20;
  }

  .rank-pill {
    background: #eee4c8;
    color: #242c33;
  }

  .core-details-box {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .core-link {
    color: var(--ink, #151b20);
    text-decoration: none;
    font-size: 0.94rem;
    font-weight: 800;
  }

  .core-link:hover {
    color: #22bfd7;
    text-decoration: underline;
  }

  .core-variant-sub {
    font-size: 0.72rem;
    color: var(--ink-light, #242c33);
    font-family: var(--md-code-font, monospace);
  }

  .champion-tag {
    display: inline-block;
    font-size: 0.64rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.1rem 0.38rem;
    border-radius: 4px;
    border: 1px solid var(--ink, #151b20);
    width: fit-content;
    margin-top: 0.15rem;
