                </defs>

                <!-- Base Frame & Grid -->
                <rect width="758" height="378" x="1" y="1" rx="8" fill="#fffaf0" stroke="#151b20" stroke-width="1.5"/>
                <rect width="756" height="344" x="2" y="2" rx="7" fill="url(#cadGridPico)"/>

                <!-- Status Header Banner -->
                <rect x="2" y="2" width="756" height="24" fill="#f6f0dc" stroke="#151b20" stroke-width="1.5" rx="6"/>
                <circle cx="16" cy="14" r="4" fill="#0d9488"/>
                <text x="28" y="17" font-size="9" font-weight="900" fill="#151b20" font-family="monospace">SCORE EDA WORKBENCH • PICORV32 MULTI-CYCLE SHARED ADDER TOPOLOGY</text>

                <!-- Left Column: Input Sources -->
                <rect x="30" y="55" width="140" height="45" rx="5" fill="#fffaf0" stroke="#151b20" stroke-width="1.5"/>
