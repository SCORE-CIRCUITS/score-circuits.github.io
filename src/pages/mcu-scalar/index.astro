      { name: "INCLUDE_BRANCH_PREDICTOR", defaultVal: "Enabled", desc: "Enable dynamic branch prediction table and BTB" },
      { name: "ICACHE_SIZE / DCACHE_SIZE", defaultVal: "4KB to 16KB", desc: "Parameterized L1 Harvard cache geometries" },
      { name: "BUS_INTERFACE", defaultVal: "AXI4", desc: "Select external interconnect interface: AXI4 or Avalon" }
    ]
  }
];
