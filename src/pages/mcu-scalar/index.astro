<script>
  // Filter Matrix by Tier
  const filterBtns = document.querySelectorAll(".matrix-filter-btn");
  const matrixRows = document.querySelectorAll("#matrix-table tbody tr");

  filterBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      filterBtns.forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      const tier = btn.getAttribute("data-tier");

      matrixRows.forEach((row) => {
        const rowTier = row.getAttribute("data-tier");
        if (tier === "all" || rowTier === tier) {
          (row as HTMLElement).style.display = "";
        } else {
          (row as HTMLElement).style.display = "none";
        }
      });
    });
  });

  // Archetype 1 Live Simulator
  let simCore = "serv";
  let simCycle = 0;
  let simInterval: any = null;

  const coreSpecs: Record<string, any> = {
    serv: {
      name: "SERV (1-Stage Bit-Serial)",
      maxCycles: 32,
      area: "~2.1 kGE (126 LUTs)",
      cpi: "32.0 cycles/inst",
      adders: "1 single 1-bit Adder",
      score: "0.03 CoreMark/MHz",
      unit: "1-Bit Full Adder Slice + Carry Flip-Flop",
      getPhase: (c: number) => c === 0 ? "Idle / Instruction Fetch" : (c < 32 ? `Serial Bit-Shift & Add [Bit ${c-1}]` : "32-Bit Commit / Complete"),
      getMsg: (c: number) => c === 0 ? "Cycle 0: Fetching opcode. Shift registers rs1, rs2, and rd initialized." : (c < 32 ? `Cycle ${c}: Shifting bit ${c-1} of rs1 & rs2 into 1-bit ALU. Carry-out stored in 1b flip-flop.` : "Cycle 32: All 32 bits computed and shifted into rd. Word committed to register file!")
    },
    picorv32: {
      name: "PicoRV32 (Multi-Cycle Shared ALU)",
      maxCycles: 4,
      area: "~9.5 kGE (750 LUTs)",
      cpi: "3.85 cycles/inst",
      adders: "1 single shared 32-bit Adder",
      score: "0.8970 CoreMark/MHz",
      unit: "Shared 32-bit Adder + FSM Controller",
      getPhase: (c: number) => {
        if (c === 0) return "Idle / Ready";
        if (c === 1) return "Phase 1: Fetch (PC <= PC + 4 via Shared Adder)";
        if (c === 2) return "Phase 2: Decode & Register Fetch (Memory Wait)";
        if (c === 3) return "Phase 3: Execute (ALU rs1 + rs2 via Shared Adder)";
        return "Phase 4: Writeback & Register Commit";
      },
      getMsg: (c: number) => {
        if (c === 0) return "Cycle 0: Ready for instruction fetch.";
        if (c === 1) return "Cycle 1: Shared adder increments PC (PC + 4). Memory read request asserted on native bus.";
        if (c === 2) return "Cycle 2: Instruction word returned from bus. Opcode decoded; rs1 & rs2 read into internal latches.";
        if (c === 3) return "Cycle 3: Shared adder reused to execute arithmetic addition (rs1 + rs2).";
        return "Cycle 4: Result written back to rd register. Instruction complete in 4 clock cycles!";
      }
    },
    darkriscv: {
      name: "DarkRISCV (1-2 Stage Async LUT-RAM)",
      maxCycles: 2,
      area: "~8.2 kGE (850 LUTs)",
      cpi: "1.64 cycles/inst",
      adders: "Parallel 32-bit ALU",
      score: "0.6435 CoreMark/MHz",
      unit: "Combinational LUT-RAM Decode + Synchronous ALU",
      getPhase: (c: number) => c === 0 ? "Idle" : (c === 1 ? "Stage 1: Combinational Fetch/Decode" : "Stage 2: Synchronous Execute & Commit"),
      getMsg: (c: number) => c === 0 ? "Ready." : (c === 1 ? "Cycle 1: Combinational read from distributed LUT-RAM without wait-states." : "Cycle 2: Parallel 32-bit ALU evaluates result and commits to register file!")
    }
  };

  function updateSimUI() {
    const spec = coreSpecs[simCore];
    const dispName = document.getElementById("dispCoreName");
    const dispCyc = document.getElementById("dispCycle");
    const dispPh = document.getElementById("dispPhase");
    const dispHw = document.getElementById("dispHwUnit");
    const dispMsg = document.getElementById("dispStatusMsg");
    const dispArea = document.getElementById("dispArea");
    const dispCpi = document.getElementById("dispCpi");
    const dispAdd = document.getElementById("dispAdders");
    const dispScore = document.getElementById("dispScore");
    const fill = document.getElementById("simProgressFill");

    if (dispName) dispName.textContent = spec.name;
    if (dispCyc) dispCyc.textContent = `Cycle ${simCycle} of ${spec.maxCycles}`;
    if (dispPh) dispPh.textContent = spec.getPhase(simCycle);
    if (dispHw) dispHw.textContent = spec.unit;
    if (dispMsg) dispMsg.textContent = spec.getMsg(simCycle);
    if (dispArea) dispArea.textContent = spec.area;
    if (dispCpi) dispCpi.textContent = spec.cpi;
    if (dispAdd) dispAdd.textContent = spec.adders;
    if (dispScore) dispScore.textContent = spec.score;

    if (fill) {
      const pct = Math.min(100, Math.round((simCycle / spec.maxCycles) * 100));
      fill.style.width = `${pct}%`;
    }
  }

  document.querySelectorAll(".sim-toggle-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll(".sim-toggle-btn").forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      simCore = btn.getAttribute("data-core") || "serv";
      simCycle = 0;
      if (simInterval) { clearInterval(simInterval); simInterval = null; }
      const runBtn = document.getElementById("btnAutoRun");
      if (runBtn) runBtn.textContent = "▶ Auto-Run";
      updateSimUI();
    });
  });

  const stepBtn = document.getElementById("btnStepCycle");
  if (stepBtn) {
    stepBtn.addEventListener("click", () => {
      const spec = coreSpecs[simCore];
      if (simCycle < spec.maxCycles) {
        simCycle++;
      } else {
        simCycle = 0;
      }
      updateSimUI();
    });
  }

  const resetBtn = document.getElementById("btnResetSim");
  if (resetBtn) {
    resetBtn.addEventListener("click", () => {
      simCycle = 0;
      if (simInterval) { clearInterval(simInterval); simInterval = null; }
      const runBtn = document.getElementById("btnAutoRun");
      if (runBtn) runBtn.textContent = "▶ Auto-Run";
      updateSimUI();
    });
  }

  const runBtn = document.getElementById("btnAutoRun");
  if (runBtn) {
    runBtn.addEventListener("click", () => {
      if (simInterval) {
        clearInterval(simInterval);
        simInterval = null;
        runBtn.textContent = "▶ Auto-Run";
      } else {
        runBtn.textContent = "⏸ Pause";
        simInterval = setInterval(() => {
          const spec = coreSpecs[simCore];
          if (simCycle < spec.maxCycles) {
            simCycle++;
          } else {
            simCycle = 0;
          }
          updateSimUI();
        }, simCore === "serv" ? 150 : 600);
      }
    });
  }

  // Copy LaTeX Table
  document.querySelectorAll(".copy-latex-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const targetId = btn.getAttribute("data-target");
      const box = document.getElementById(targetId || "");
      if (box) {
        const isShown = box.style.display === "block";
        box.style.display = isShown ? "none" : "block";
        if (!isShown) {
          const code = box.querySelector("code")?.textContent || "";
          navigator.clipboard.writeText(code).then(() => {
            const orig = btn.textContent;
            btn.textContent = "Copied to Clipboard!";
            setTimeout(() => { btn.textContent = orig; }, 2000);
          });
        }
      }
    });
  });

  document.querySelectorAll(".close-latex-btn").forEach((btn) => {
    btn.addEventListener("click", (e) => {
      const parent = (e.target as HTMLElement).closest(".latex-export-box") as HTMLElement;
      if (parent) parent.style.display = "none";
    });
  });
</script>

