  }

  .point-badge {
    font-weight: 800;
    font-family: var(--md-code-font, monospace);
    font-size: 0.82rem;
    color: var(--ink, #151b20);
    text-transform: uppercase;
  }

  .point-desc {
    color: var(--ink-light, #242c33);
  }

  /* Differences Cards Deck (Top-Down) */
  .diff-cards-deck {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  .diff-spec-card {
    background: #ffffff;
    border: 2px solid var(--ink, #151b20);
    border-radius: 12px;
    box-shadow: 3px 3px 0 var(--ink, #151b20);
    padding: 1.35rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .diff-spec-card.diff-hazards { border-left: 6px solid var(--coral, #f38469); }
  .diff-spec-card.diff-math { border-left: 6px solid var(--yellow, #ffc83e); }
  .diff-spec-card.diff-memory { border-left: 6px solid var(--teal, #0d9488); }
  .diff-spec-card.diff-security { border-left: 6px solid var(--purple, #8275e8); }

  .diff-spec-head {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .diff-tag {
    font-size: 0.72rem;
    font-weight: 900;
    font-family: var(--md-code-font, monospace);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    border: 1px solid var(--ink, #151b20);
    display: inline-block;
    width: fit-content;
    margin-bottom: 0.25rem;
  }

  .diff-spec-head h4 {
    font-size: 1.15rem;
    font-weight: 900;
    color: var(--ink, #151b20);
    margin: 0;
  }

  .diff-lead {
    font-size: 0.92rem;
    color: var(--ink-light, #242c33);
    line-height: 1.55;
    margin: 0;
  }

  .diff-points-stack {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    margin-top: 0.25rem;
  }

  .diff-point-row {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 0.85rem;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--ink-light, #242c33);
    background: var(--paper, #fffaf0);
    padding: 0.6rem 0.85rem;
    border-radius: 6px;
    border: 1px solid var(--line, #eee4c8);
    align-items: baseline;
  }

  .diff-point-title {
    font-weight: 800;
    font-family: var(--md-code-font, monospace);
    font-size: 0.82rem;
    color: var(--ink, #151b20);
    text-transform: uppercase;
  }

  .diff-point-text {
    color: var(--ink-light, #242c33);
  }

  .concept-list {
    margin: 0;
    padding-left: 1.25rem;
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--ink-light, #151b20);
  }

  .concept-list li {
    margin-bottom: 0.4rem;
  }

  .table-title-box {
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .table-title-flex {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .matrix-filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .matrix-filter-btn {
    background: var(--paper, #fffaf0);
    border: 1.5px solid var(--ink, #151b20);
    border-radius: 6px;
    box-shadow: 2px 2px 0 var(--ink, #151b20);
    padding: 0.35rem 0.7rem;
    font-size: 0.78rem;
    font-weight: 800;
    color: var(--ink, #151b20);
    cursor: pointer;
    transition: all 0.1s ease;
  }

  .matrix-filter-btn:hover {
    background: var(--yellow-soft, #fff0b9);
    transform: translate(-1px, -1px);
  }

  .matrix-filter-btn.active {
    background: var(--yellow, #ffc83e);
    box-shadow: 2px 2px 0 var(--ink, #151b20);
  }

  .dossier-jump-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1rem;
    padding-top: 0.85rem;
    border-top: 1.5px dashed var(--line, #eee4c8);
  }

  .dossier-jump-pill {
    background: var(--paper, #fffaf0);
    border: 1.5px solid var(--ink, #151b20);
    border-radius: 999px;
    box-shadow: 2px 2px 0 var(--ink, #151b20);
    padding: 0.25rem 0.65rem;
    font-size: 0.78rem;
    font-weight: 800;
    color: var(--ink, #151b20);
    text-decoration: none;
    transition: all 0.1s ease;
  }

  .dossier-jump-pill:hover {
    background: var(--yellow, #ffc83e);
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0 var(--ink, #151b20);
