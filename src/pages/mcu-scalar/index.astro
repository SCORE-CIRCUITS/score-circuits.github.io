// Helper to derive archetype code for filtering
function getArchetypeCategory(arch: string): string {
  if (arch.includes("1-Stage") || arch.includes("1-2 Stage") || arch.includes("Multi-Cycle")) return "archetype-1";
  if (arch.includes("2-Stage")) return "archetype-2";
  if (arch.includes("3-Stage") || arch.includes("4-Stage Modular") || arch.includes("5-Stage") || arch.includes("Structural")) return "archetype-3";
  if (arch.includes("Decoupled") || arch.includes("Dual-Issue") || arch.includes("Superscalar")) return "archetype-4";
  return "archetype-2";
}

// Compute rank map by CoreMark/MHz (non-zero scores first)
const sortedByCoremark = [...masterBenchmarkData]
  .map((row) => ({
    key: row.name + "::" + row.variant,
    score: parseFloat(row.coremarkMhz) || 0
  }))
  .sort((a, b) => b.score - a.score);

const coremarkRankMap = new Map();
sortedByCoremark.forEach((item, index) => {
  coremarkRankMap.set(item.key, index + 1);
});

function getCpiClass(cpiStr: string): string {
  const cpiVal = parseFloat(cpiStr);
  if (isNaN(cpiVal)) return "cpi-mid";
  if (cpiVal <= 1.15) return "cpi-elite";
  if (cpiVal <= 1.45) return "cpi-good";
  if (cpiVal <= 2.0) return "cpi-mid";
  return "cpi-slow";
}

const leaderboardProcessedData = masterBenchmarkData.map((row, idx) => {
  const archCat = getArchetypeCategory(row.archetype);
  const rank = coremarkRankMap.get(row.name + "::" + row.variant) || (idx + 1);
  const rankClass = rank === 1 ? "rank-gold" : rank === 2 ? "rank-silver" : rank === 3 ? "rank-bronze" : "rank-pill";
  const scoreNum = parseFloat(row.coremarkMhz) || 0;
  const scorePercent = Math.min(100, Math.max(2, Math.round((scoreNum / 3.2256) * 100)));
  const cpiVal = parseFloat(row.cpi) || 999;
  const cpiClass = getCpiClass(row.cpi);
  const areaVal = parseFloat(row.areaKge) || 999;
  const fmaxVal = parseInt(row.fmax) || 0;
  const searchStr = `${row.name} ${row.variant} ${row.isa} ${row.archetype} ${row.simulator} ${row.bus}`.toLowerCase();
  const isGoldScore = scoreNum >= 2.5;
  const hasBar = scoreNum > 0;

  return {
    ...row,
    idx,
    archCat,
    rank,
    rankClass,
    scoreNum,
    scorePercent,
    cpiVal,
    cpiClass,
    areaVal,
    fmaxVal,
    searchStr,
    isGoldScore,
    hasBar
  };
});

