  .lm-lbl {
    font-size: 0.72rem;
    color: #666;
    font-weight: 700;
  }

  .lm-val {
    font-size: 0.88rem;
    font-weight: 900;
    color: var(--ink, #151b20);
  }

  .arch-verdict-box {
    background: var(--cream, #fffaf0);
