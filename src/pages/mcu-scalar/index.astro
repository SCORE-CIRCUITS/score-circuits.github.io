  .sub-topic-card {
    background: #ffffff;
    border: 1.5px solid var(--ink, #151b20);
    border-radius: 10px;
    padding: 1.5rem;
    box-shadow: 3px 3px 0 var(--ink, #151b20);
    margin-bottom: 1.5rem;
