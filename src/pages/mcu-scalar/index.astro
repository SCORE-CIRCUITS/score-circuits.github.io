    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  /* First-Principles Intuitive Introduction */
  .intro-narrative {
    display: flex;
    flex-direction: column;
    gap: 0.95rem;
    margin-top: 1rem;
    margin-bottom: 1.75rem;
