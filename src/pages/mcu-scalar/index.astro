    <div class="table-scroll leaderboard-scroll">
      <table class="data-table leaderboard-table" id="masterLeaderboardTable">
        <thead>
          <tr>
            <th class="sticky-col col-rank-core" data-sort="name">
              <div class="th-content">
                <span># &bull; Core &amp; Variant</span>
                <span class="sort-icon">&#8645;</span>
              </div>
            </th>
            <th data-sort="isa">
              <div class="th-content">
                <span>ISA Support</span>
                <span class="sort-icon">&#8645;</span>
              </div>
            </th>
            <th data-sort="archetype">
              <div class="th-content">
                <span>Pipeline Archetype</span>
                <span class="sort-icon">&#8645;</span>
              </div>
            </th>
            <th class="th-numeric" data-sort="coremark">
              <div class="th-content th-content-right">
                <span>CoreMark / MHz</span>
                <span class="sort-icon">&#8645;</span>
              </div>
            </th>
            <th class="th-numeric" data-sort="dmips">
              <div class="th-content th-content-right">
                <span>DMIPS / MHz</span>
                <span class="sort-icon">&#8645;</span>
              </div>
            </th>
            <th class="th-center" data-sort="cpi">
              <div class="th-content th-content-center">
                <span>Empirical CPI</span>
                <span class="sort-icon">&#8645;</span>
              </div>
            </th>
            <th class="th-numeric">
              <div class="th-content th-content-right">
                <span>Total Cycles</span>
              </div>
            </th>
            <th class="th-center" data-sort="area">
              <div class="th-content th-content-center">
                <span>Area (kGE)</span>
                <span class="sort-icon">&#8645;</span>
              </div>
            </th>
            <th class="th-center" data-sort="fmax">
              <div class="th-content th-content-center">
                <span>ASIC Fmax</span>
                <span class="sort-icon">&#8645;</span>
              </div>
            </th>
            <th>
              <div class="th-content">
                <span>Simulation Engine</span>
              </div>
            </th>
            <th>
              <div class="th-content">
                <span>Bus Interface</span>
              </div>
            </th>
          </tr>
        </thead>
        <tbody>
          {leaderboardProcessedData.map((row) => (
            <tr 
              class={row.highlight ? "highlight-row" : ""}
              data-original-idx={row.idx}
              data-archetype={row.archCat}
              data-coremark={row.scoreNum}
              data-dmips={parseFloat(row.dmipsMhz) || 0}
              data-cpi={row.cpiVal}
              data-area={row.areaVal}
              data-fmax={row.fmaxVal}
              data-name={row.name.toLowerCase()}
              data-isa={row.isa.toLowerCase()}
              data-search={row.searchStr}
            >
              <td class="sticky-col col-rank-core">
                <div class="col-rank-core-wrap">
                  <span class={`rank-badge ${row.rankClass}`}>#{row.rank}</span>
                  <div class="core-details-box">
                    <strong><a href={`#dossier-${row.slug}`} class="core-link">{row.name}</a></strong>
                    <span class="core-variant-sub">{row.variant}</span>
                    {row.badgeText && (
                      <span class={`champion-tag ${row.badgeClass}`}>{row.badgeText}</span>
                    )}
                  </div>
                </div>
              </td>
              <td>
                <code class="isa-pill">{row.isa}</code>
              </td>
              <td>
                <span class={`badge ${row.badgeClass}`}>{row.archetype}</span>
              </td>
              <td class="td-numeric">
                <div class="score-cell-wrap">
                  <span class={row.isGoldScore ? "score-pill-gold" : "score-pill-plain"}>
                    {row.coremarkMhz}
                  </span>
                  {row.hasBar && (
                    <div class="mini-bar-track" title={`${row.scorePercent}% of peak (3.23 CoreMark/MHz)`}>
                      <div class="mini-bar-fill" style={`width: ${row.scorePercent}%;`}></div>
                    </div>
                  )}
                </div>
              </td>
              <td class="td-numeric">
                <strong class="tabular-dmips">{row.dmipsMhz}</strong>
              </td>
              <td class="td-center">
                <span class={`cpi-pill ${row.cpiClass}`}>
                  <code>{row.cpi}</code>
                </span>
              </td>
              <td class="td-numeric">
                <div class="cycles-cell-wrap">
                  <span class="cycles-num">{row.totalCycles}</span>
                  <span class="iter-sub">{row.iterations}</span>
                </div>
              </td>
              <td class="td-center">
                <span class="area-pill">{row.areaKge} kGE</span>
              </td>
              <td class="td-center">
                <span class="fmax-pill">{row.fmax}</span>
              </td>
              <td>
                <span class="meta-pill">{row.simulator}</span>
              </td>
              <td>
                <span class="meta-pill">{row.bus}</span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="table-footnote">
      *Note on SERV: Raw execution requires 32 clock cycles per instruction (0.03 CoreMark/MHz raw IPC); scaled timer ratio on servant SoC maps to 0.9696. RV12 and RISC-V VHDL pass SCORE lint/structural checksuites; full simulation requires commercial EDA testbench.
    </p>

    </section>

  <!-- SECTION 6: CONFIGURATION SENSITIVITY DEEP-DIVE -->
  <section id="configuration-scaling" class="content-block">
    <div class="block-header-wrap">
      <div class="badge badge-accent">&sect; 6. CONFIGURATION SENSITIVITY</div>
      <h2 class="block-title">Multi-Configuration Scaling: Architectural Tuning Impact</h2>
      <p class="block-lead">
        A processor core is not a static point in design space. Parametric switches—such as swapping a 32-cycle serial multiplier for single-cycle DSP blocks or adding dynamic branch prediction—dramatically transform performance.
      </p>
    </div>

    <div class="sensitivity-container">
      {configSensitivity.map((fam) => (
        <div class="family-scaling-card">
          <div class="fam-head">
            <h3>{fam.family}</h3>
            <p class="fam-desc">{fam.description}</p>
          </div>
          <div class="table-scroll">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Configuration</th>
                  <th>ISA Extensions</th>
                  <th>Multiplier Datapath</th>
                  <th>Branch Handling</th>
                  <th>Security / Features</th>
                  <th>CoreMark / MHz</th>
                  <th>DMIPS / MHz</th>
                  <th>Empirical CPI</th>
                  <th>Analysis Notes</th>
                </tr>
              </thead>
              <tbody>
                {fam.variants.map((v) => (
                  <tr>
                    <td><strong>{v.config}</strong></td>
                    <td><code>{v.isa}</code></td>
                    <td>{v.mult}</td>
                    <td>{v.bp}</td>
                    <td>{v.pmp}</td>
                    <td><span class="score-badge">{v.coremark}</span></td>
                    <td><strong>{v.dmips}</strong></td>
                    <td><code>{v.cpi}</code></td>
                    <td><small>{v.notes}</small></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- SECTION 7: NATIVE DETAILED ARCHITECTURAL DOSSIERS (NO MD LINKS) -->
  <section id="core-dossiers" class="dossiers-container">
    <div class="section-title-wrap">
      <div class="badge badge-primary">&sect; 7. NATIVE ARCHITECTURAL SPECIFICATIONS</div>
      <h2 class="section-heading">Detailed Native Core Dossiers</h2>
      <p class="section-sub">
        Comprehensive native microarchitectural breakdowns, memory bus specifications, silicon and FPGA deployment evidence, verified empirical benchmark metrics, and engineering trade-offs.
      </p>

      <!-- Quick Dossier Jump Bar -->
      <div class="dossier-jump-bar">
        <span class="jump-label">Jump to Core Dossier:</span>
        {bespokeDossiers.map((c) => (
          <a href={`#dossier-${c.slug}`} class="dossier-jump-pill">{c.name.split(' ')[0]}</a>
        ))}
      </div>
    </div>

    <div class="dossiers-list">
      {bespokeDossiers.map((core) => (
        <article class="dossier-card" id={`dossier-${core.slug}`}>
          <!-- Dossier Header -->
          <div class="dossier-header">
            <div class="dh-left">
              <span class="d-badge">{core.lang}</span>
              <span class="d-org">{core.org}</span>
              <span class="d-class-pill">{core.archClass}</span>
            </div>
            <div class="dh-right">
              <span class="d-license">{core.license}</span>
            </div>
          </div>

          <h3 class="dossier-core-name">{core.name}</h3>
          <p class="dossier-lead">{core.subtitle}</p>

          <!-- Specifications Grid -->
          <div class="dossier-specs-grid">
            <div class="ds-col">
              <table class="ds-table">
                <tbody>
                  <tr><th>Target ISA:</th><td><code>{core.isa}</code></td></tr>
                  <tr><th>Bus Interface:</th><td>{core.bus}</td></tr>
                  <tr><th>Silicon Area:</th><td><strong>{core.area}</strong></td></tr>
                  <tr><th>Target Fmax:</th><td>{core.fmax}</td></tr>
                </tbody>
              </table>
            </div>
            <div class="ds-col">
              <table class="ds-table">
                <tbody>
                  <tr><th>Measured CoreMark:</th><td><span class="score-badge">{core.measuredCoremark}</span></td></tr>
                  <tr><th>Measured Dhrystone:</th><td>{core.measuredDhrystone}</td></tr>
                  <tr><th>Silicon Evidence:</th><td>{core.siliconEvidence}</td></tr>
                  <tr><th>Verification Rigor:</th><td>{core.verificationRigor}</td></tr>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Technical Breakdown Sections -->
          <div class="dossier-tech-breakdown">
            <div class="tech-sub-block">
              <h5 class="tech-sub-title">&#9881; Microarchitectural Pipeline &amp; Datapath</h5>
              <p>{core.pipelineDesc}</p>
            </div>
            <div class="tech-sub-block">
              <h5 class="tech-sub-title">&#128421; Memory Subsystem &amp; Interconnect Protocol</h5>
              <p>{core.memDesc}</p>
            </div>
          </div>

          <!-- Architectural Assessment (Strengths & Trade-offs) -->
          <div class="dossier-assessment-grid">
            <div class="assess-item strength">
              <strong>&#10003; Architectural Strengths:</strong> {core.strengths}
            </div>
            <div class="assess-item limitation">
              <strong>&#9888; Engineering Trade-offs:</strong> {core.tradeoffs}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<script>
  // Filter Matrix by Tier
  const filterBtns = document.querySelectorAll(".matrix-filter-btn");
  const matrixRows = document.querySelectorAll("#matrix-table tbody tr");

  filterBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      filterBtns.forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      const tier = btn.getAttribute("data-tier");

      matrixRows.forEach((row) => {
        const rowTier = row.getAttribute("data-tier");
        if (tier === "all" || rowTier === tier) {
          (row as HTMLElement).style.display = "";
        } else {
          (row as HTMLElement).style.display = "none";
        }
      });
    });
  });

  // Base ISA Table Filter & Search
  const isaCatBtns = document.querySelectorAll(".isa-cat-btn");
  const isaRows = document.querySelectorAll("#isaFullSpecTable tbody tr");
  const isaSearch = document.getElementById("isaSearchInput") as HTMLInputElement;

  function filterIsaTable() {
    const activeCat = document.querySelector(".isa-cat-btn.active")?.getAttribute("data-isa-cat") || "all";
    const query = isaSearch ? isaSearch.value.trim().toLowerCase() : "";

    isaRows.forEach((row) => {
      const rowCat = row.getAttribute("data-cat");
      const text = row.textContent?.toLowerCase() || "";
      const matchesCat = activeCat === "all" || rowCat === activeCat;
      const matchesQuery = query === "" || text.includes(query);

      if (matchesCat && matchesQuery) {
        (row as HTMLElement).style.display = "";
      } else {
        (row as HTMLElement).style.display = "none";
      }
    });
  }

  isaCatBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      isaCatBtns.forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      filterIsaTable();
    });
  });

  if (isaSearch) {
    isaSearch.addEventListener("input", filterIsaTable);
  }

  // Archetype 1 Live Simulator
  let simCore = "serv";
  let simCycle = 0;
  let simInterval: any = null;

  const coreSpecs: Record<string, any> = {
    serv: {
      name: "SERV (1-Stage Bit-Serial)",
      maxCycles: 32,
      area: "~2.1 kGE (126 LUTs)",
      cpi: "32.0 cycles/inst",
      adders: "1 single 1-bit Adder",
      score: "0.03 CoreMark/MHz",
      unit: "1-Bit Full Adder Slice + Carry Flip-Flop",
      getPhase: (c: number) => c === 0 ? "Idle / Instruction Fetch" : (c < 32 ? `Serial Bit-Shift & Add [Bit ${c-1}]` : "32-Bit Commit / Complete"),
      getMsg: (c: number) => c === 0 ? "Cycle 0: Fetching opcode. Shift registers rs1, rs2, and rd initialized." : (c < 32 ? `Cycle ${c}: Shifting bit ${c-1} of rs1 & rs2 into 1-bit ALU. Carry-out stored in 1b flip-flop.` : "Cycle 32: All 32 bits computed and shifted into rd. Word committed to register file!")
    },
    picorv32: {
      name: "PicoRV32 (Multi-Cycle Shared ALU)",
      maxCycles: 4,
      area: "~9.5 kGE (750 LUTs)",
      cpi: "3.85 cycles/inst",
      adders: "1 single shared 32-bit Adder",
      score: "0.8970 CoreMark/MHz",
      unit: "Shared 32-bit Adder + FSM Controller",
      getPhase: (c: number) => {
        if (c === 0) return "Idle / Ready";
        if (c === 1) return "Phase 1: Fetch (PC <= PC + 4 via Shared Adder)";
        if (c === 2) return "Phase 2: Decode & Register Fetch (Memory Wait)";
        if (c === 3) return "Phase 3: Execute (ALU rs1 + rs2 via Shared Adder)";
        return "Phase 4: Writeback & Register Commit";
      },
      getMsg: (c: number) => {
        if (c === 0) return "Cycle 0: Ready for instruction fetch.";
        if (c === 1) return "Cycle 1: Shared adder increments PC (PC + 4). Memory read request asserted on native bus.";
        if (c === 2) return "Cycle 2: Instruction word returned from bus. Opcode decoded; rs1 & rs2 read into internal latches.";
        if (c === 3) return "Cycle 3: Shared adder reused to execute arithmetic addition (rs1 + rs2).";
        return "Cycle 4: Result written back to rd register. Instruction complete in 4 clock cycles!";
      }
    },
    darkriscv: {
      name: "DarkRISCV (1-2 Stage Async LUT-RAM)",
      maxCycles: 2,
      area: "~8.2 kGE (850 LUTs)",
      cpi: "1.64 cycles/inst",
      adders: "Parallel 32-bit ALU",
      score: "0.6435 CoreMark/MHz",
      unit: "Combinational LUT-RAM Decode + Synchronous ALU",
      getPhase: (c: number) => c === 0 ? "Idle" : (c === 1 ? "Stage 1: Combinational Fetch/Decode" : "Stage 2: Synchronous Execute & Commit"),
      getMsg: (c: number) => c === 0 ? "Ready." : (c === 1 ? "Cycle 1: Combinational read from distributed LUT-RAM without wait-states." : "Cycle 2: Parallel 32-bit ALU evaluates result and commits to register file!")
    }
  };

  function updateSimUI() {
    const spec = coreSpecs[simCore];
    const dispName = document.getElementById("dispCoreName");
    const dispCyc = document.getElementById("dispCycle");
    const dispPh = document.getElementById("dispPhase");
    const dispHw = document.getElementById("dispHwUnit");
    const dispMsg = document.getElementById("dispStatusMsg");
    const dispArea = document.getElementById("dispArea");
    const dispCpi = document.getElementById("dispCpi");
    const dispAdd = document.getElementById("dispAdders");
    const dispScore = document.getElementById("dispScore");
    const fill = document.getElementById("simProgressFill");

    if (dispName) dispName.textContent = spec.name;
    if (dispCyc) dispCyc.textContent = `Cycle ${simCycle} of ${spec.maxCycles}`;
    if (dispPh) dispPh.textContent = spec.getPhase(simCycle);
    if (dispHw) dispHw.textContent = spec.unit;
    if (dispMsg) dispMsg.textContent = spec.getMsg(simCycle);
    if (dispArea) dispArea.textContent = spec.area;
    if (dispCpi) dispCpi.textContent = spec.cpi;
    if (dispAdd) dispAdd.textContent = spec.adders;
    if (dispScore) dispScore.textContent = spec.score;

    if (fill) {
      const pct = Math.min(100, Math.round((simCycle / spec.maxCycles) * 100));
      fill.style.width = `${pct}%`;
    }
  }

  document.querySelectorAll(".sim-toggle-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll(".sim-toggle-btn").forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      simCore = btn.getAttribute("data-core") || "serv";
      simCycle = 0;
      if (simInterval) { clearInterval(simInterval); simInterval = null; }
      const runBtn = document.getElementById("btnAutoRun");
      if (runBtn) runBtn.textContent = "▶ Auto-Run";
      updateSimUI();
    });
  });

  const stepBtn = document.getElementById("btnStepCycle");
  if (stepBtn) {
    stepBtn.addEventListener("click", () => {
      const spec = coreSpecs[simCore];
      if (simCycle < spec.maxCycles) {
        simCycle++;
      } else {
        simCycle = 0;
      }
      updateSimUI();
    });
  }

  const resetBtn = document.getElementById("btnResetSim");
  if (resetBtn) {
    resetBtn.addEventListener("click", () => {
      simCycle = 0;
      if (simInterval) { clearInterval(simInterval); simInterval = null; }
      const runBtn = document.getElementById("btnAutoRun");
      if (runBtn) runBtn.textContent = "▶ Auto-Run";
      updateSimUI();
    });
  }

  const runBtn = document.getElementById("btnAutoRun");
  if (runBtn) {
    runBtn.addEventListener("click", () => {
      if (simInterval) {
        clearInterval(simInterval);
        simInterval = null;
        runBtn.textContent = "▶ Auto-Run";
      } else {
        runBtn.textContent = "⏸ Pause";
        simInterval = setInterval(() => {
          const spec = coreSpecs[simCore];
          if (simCycle < spec.maxCycles) {
            simCycle++;
          } else {
            simCycle = 0;
          }
          updateSimUI();
        }, simCore === "serv" ? 150 : 600);
      }
    });
  }

  // Copy LaTeX Table
  document.querySelectorAll(".copy-latex-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const targetId = btn.getAttribute("data-target");
      const box = document.getElementById(targetId || "");
      if (box) {
        const isShown = box.style.display === "block";
        box.style.display = isShown ? "none" : "block";
        if (!isShown) {
          const code = box.querySelector("code")?.textContent || "";
          navigator.clipboard.writeText(code).then(() => {
            const orig = btn.textContent;
            btn.textContent = "Copied to Clipboard!";
            setTimeout(() => { btn.textContent = orig; }, 2000);
          });
        }
      }
    });
  });

  document.querySelectorAll(".close-latex-btn").forEach((btn) => {
    btn.addEventListener("click", (e) => {
      const parent = (e.target as HTMLElement).closest(".latex-export-box") as HTMLElement;
      if (parent) parent.style.display = "none";
    });
  });

  // Master Leaderboard: Filter, Search, and Sort
  const lbTable = document.getElementById("masterLeaderboardTable");
  if (lbTable) {
    const lbTbody = lbTable.querySelector("tbody");
    const lbFilterPills = document.querySelectorAll(".lb-pill");
    const lbSearchInput = document.getElementById("lbSearchInput") as HTMLInputElement | null;
    const lbClearSearch = document.getElementById("lbClearSearch") as HTMLButtonElement | null;
    const lbSortSelect = document.getElementById("lbSortSelect") as HTMLSelectElement | null;
    const lbSortHeaders = lbTable.querySelectorAll("th[data-sort]");

    let activeFilter = "all";
    let activeQuery = "";
    let currentSortKey = "default";
    let currentSortDir: "asc" | "desc" = "desc";

    function filterLeaderboard() {
      if (!lbTbody) return;
      const rows = Array.from(lbTbody.querySelectorAll("tr")) as HTMLElement[];

      rows.forEach((row) => {
        const rowArch = row.getAttribute("data-archetype") || "";
        const rowSearch = row.getAttribute("data-search") || "";

        const matchesFilter = activeFilter === "all" || rowArch === activeFilter;
        const matchesSearch = activeQuery === "" || rowSearch.includes(activeQuery);

        if (matchesFilter && matchesSearch) {
          row.style.display = "";
        } else {
          row.style.display = "none";
        }
      });
    }

    // Archetype pill filter click
    lbFilterPills.forEach((pill) => {
      pill.addEventListener("click", () => {
        lbFilterPills.forEach((p) => p.classList.remove("active"));
        pill.classList.add("active");
        activeFilter = pill.getAttribute("data-filter") || "all";
        filterLeaderboard();
      });
    });

    // Real-time search input
    if (lbSearchInput) {
      lbSearchInput.addEventListener("input", () => {
        activeQuery = lbSearchInput.value.trim().toLowerCase();
        if (lbClearSearch) {
          lbClearSearch.style.display = activeQuery.length > 0 ? "block" : "none";
        }
        filterLeaderboard();
      });
    }

    // Clear search button
    if (lbClearSearch && lbSearchInput) {
      lbClearSearch.addEventListener("click", () => {
        lbSearchInput.value = "";
        activeQuery = "";
        lbClearSearch.style.display = "none";
        filterLeaderboard();
        lbSearchInput.focus();
      });
    }

    // Multi-key row sorting function
    function sortRows(key: string, dir: "asc" | "desc") {
      if (!lbTbody) return;
      const rows = Array.from(lbTbody.querySelectorAll("tr")) as HTMLElement[];

      rows.sort((a, b) => {
        if (key === "default") {
          const idxA = parseInt(a.getAttribute("data-original-idx") || "0", 10);
          const idxB = parseInt(b.getAttribute("data-original-idx") || "0", 10);
          return idxA - idxB;
        }

        const valA = a.getAttribute(`data-${key}`) || "";
        const valB = b.getAttribute(`data-${key}`) || "";

        const numA = parseFloat(valA);
        const numB = parseFloat(valB);
        if (!isNaN(numA) && !isNaN(numB)) {
          return dir === "asc" ? numA - numB : numB - numA;
        }

        return dir === "asc" ? valA.localeCompare(valB) : valB.localeCompare(valA);
      });

      rows.forEach((r) => lbTbody.appendChild(r));
    }

    // Sort select change listener
    if (lbSortSelect) {
      lbSortSelect.addEventListener("change", () => {
        const val = lbSortSelect.value;
        lbSortHeaders.forEach((h) => h.classList.remove("sort-active", "sort-asc", "sort-desc"));
        if (val === "default") {
          sortRows("default", "asc");
        } else if (val === "coremark-desc") {
          sortRows("coremark", "desc");
        } else if (val === "cpi-asc") {
          sortRows("cpi", "asc");
        } else if (val === "area-asc") {
          sortRows("area", "asc");
        } else if (val === "fmax-desc") {
          sortRows("fmax", "desc");
        }
      });
    }

    // Interactive column header sort
    lbSortHeaders.forEach((th) => {
      th.addEventListener("click", () => {
        const key = th.getAttribute("data-sort");
        if (!key) return;

        if (currentSortKey === key) {
          currentSortDir = currentSortDir === "asc" ? "desc" : "asc";
        } else {
          currentSortKey = key;
          currentSortDir = ["name", "isa", "archetype"].includes(key) ? "asc" : "desc";
        }

        lbSortHeaders.forEach((h) => {
          h.classList.remove("sort-active", "sort-asc", "sort-desc");
        });
        th.classList.add("sort-active", currentSortDir === "asc" ? "sort-asc" : "sort-desc");

        sortRows(key, currentSortDir);
      });
    });
  }
