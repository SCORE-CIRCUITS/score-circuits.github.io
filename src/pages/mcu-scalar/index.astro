    transition: all 0.1s ease;
  }

  .sim-toggle-btn:hover {
    background: var(--yellow-soft, #fff8e1);
  }

  .sim-toggle-btn.active {
    background: var(--yellow, #ffc83e);
    box-shadow: 2px 2px 0 var(--ink, #151b20);
  }

  .action-btn-row {
