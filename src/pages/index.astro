---
import BaseLayout from "../layouts/BaseLayout.astro";
import db from "../data/score_db.json";

const categories = db.categories;

const toolsBySlug = Object.fromEntries(db.tools.map(t => [t.slug, t]));

const categoryFeaturedTiers = [
  {
    catNum: 1,
    badge: "CATEGORY 01 • LEVEL 1",
    badgeClass: "badge-yellow",
    borderClass: "tier-border-yellow",
    title: "Microcontroller & Scalar Embedded Cores",
    scope: "Single-Threaded In-Order Embedded Pipelines",
    ctaText: "Explore Category 1 (12 Cores)",
    href: "/mcu-scalar/",
    connectorText: "Scale from Single-Issue Microcontrollers to Virtual Memory (Sv39/Sv48 MMU) & Multi-Level Caches",
    slugs: ["ibex", "hazard3", "serv"]
  },
  {
    catNum: 2,
    badge: "CATEGORY 02 • LEVEL 2",
    badgeClass: "badge-cyan",
    borderClass: "tier-border-cyan",
    title: "Application Cores",
    scope: "Linux-Capable In-Order & Out-of-Order Superscalar Cores",
    ctaText: "Explore Category 2 (3 Processors)",
    href: "/app-cores/",
    connectorText: "Scale from Memory-Bound Scalar Pipelines to Data-Parallel RVV 1.0 Vector Engines & Systolic Arrays",
    slugs: ["cva6", "rocket-chip", "black-parrot"]
  },
  {
    catNum: 3,
    badge: "CATEGORY 03 • LEVEL 3",
    badgeClass: "badge-coral",
    borderClass: "tier-border-coral",
    title: "Vector & Coprocessor Acceleration Engines",
    scope: "Data-Parallel SIMD / RVV 1.0 & Systolic Accelerators",
    ctaText: "Explore Category 3 (4 Engines)",
    href: "/vector-coprocessors/",
    connectorText: "Scale from Coprocessor Accelerators to Many-Core Clusters (up to 432 Cores), NoC Fabrics & DMA Engines",
    slugs: ["ara", "gemmini", "spatz"]
  },
  {
    catNum: 4,
    badge: "CATEGORY 04 • LEVEL 4",
    badgeClass: "badge-lime",
    borderClass: "tier-border-lime",
    title: "Full SoC Platforms & Multi-Core Clusters",
    scope: "Many-Core Compute Clusters & Complete Tapeout SoCs",
    ctaText: "Explore Category 4 (23 Systems)",
    href: "/soc-multicore/",
    slugs: ["snitch-cluster", "cheshire", "mempool"]
  }
];

const categoryLinks: Record<number, string> = {
  1: "/mcu-scalar/",
  2: "/app-cores/",
  3: "/vector-coprocessors/",
  4: "/soc-multicore/",
};

const categoryDetails: Record<number, {
  levelNum: string;
  levelBadge: string;
  scope: string;
  borderClass: string;
  badgeClass: string;
  colorVar: string;
  bottleneck: string;
  remedy: string;
  keyTools: string;
  ctaText: string;
  transitionText?: string;
}> = {
  1: {
    levelNum: "01",
    levelBadge: "LEVEL 1 • TIER 1 • SCALAR MICROBENCHMARKS",
    scope: "Single-Thread & In-Order Embedded Pipelines",
    borderClass: "ladder-border-yellow",
    badgeClass: "badge-yellow",
    colorVar: "var(--yellow)",
    bottleneck: "Branch misprediction penalty incurs 1–2 idle bubble cycles on tight loops. Load-use dependencies stall simple 2-stage cores (e.g. Ibex) unless forwarding paths are expanded.",
    remedy: "Dual-issue in-order execution with static branch hints and zero-overhead hardware loop controllers (e.g. VeeR EL2, CV32E40P).",
    keyTools: "SERV (1-bit serial), PicoRV32, DarkRISCV, Ibex (2-stage), Hazard3 (3-stage), SCR1, VexRiscv (5-stage), VeeR EL2 (dual-issue)",
    ctaText: "Explore Level 1 MCU / Scalar Cores",
    transitionText: "Scale from Single-Issue Microcontrollers to Virtual Memory (Sv39/Sv48 MMU) & Multi-Level Caches",
  },
  2: {
    levelNum: "02",
    levelBadge: "LEVEL 2 • TIER 2 • MEMORY & OS COMPLIANCE",
    scope: "Linux-Capable In-Order & Out-of-Order Processors",
    borderClass: "ladder-border-cyan",
    badgeClass: "badge-cyan",
    colorVar: "var(--cyan)",
    bottleneck: "Memory Wall latency (50–100 ns DRAM) on L1/L2 cache misses and serialized 3-level page table walk latency upon TLB misses.",
    remedy: "Non-blocking split L1/L2 caches with MSHRs, hardware stream prefetchers, and out-of-order superscalar execution (BOOM).",
    keyTools: "CVA6 (6-stage in-order RV64GC), Rocket Chip (TileLink-UH), BlackParrot (BedRock coherent), BOOM (7–10 stage OoO)",
    ctaText: "Explore Level 2 Application Cores",
    transitionText: "Scale from Memory-Bound Scalar Pipelines to Data-Parallel RVV 1.0 Vector Engines & Systolic Arrays",
  },
  3: {
    levelNum: "03",
    levelBadge: "LEVEL 3 • TIER 3 • DOMAIN VECTOR ACCELERATION",
    scope: "Data-Parallel SIMD / RVV 1.0 & Systolic Accelerators",
    borderClass: "ladder-border-coral",
    badgeClass: "badge-coral",
    colorVar: "var(--coral)",
    bottleneck: "Vector lane utilization collapses from 98.4% on GEMM down to 23.0% on strided/reduction kernels (FFT, Softmax) due to scalar issue serialization and VRF bank conflicts.",
    remedy: "Decoupled Access-Execute (DAE) vector coprocessors with multi-bank conflict-free VRFs and systolic weight-stationary matrix tiles (Ara, Gemmini).",
    keyTools: "Ara (scalable 4–16 lanes RVV 1.0), AraXL (AXI bus), Gemmini (systolic GEMM array), Spatz (compact float coprocessor)",
    ctaText: "Explore Level 3 Vector & Coprocessors",
    transitionText: "Scale from Coprocessor Accelerators to Many-Core Clusters (up to 432 Cores), NoC Fabrics & DMA Engines",
  },
  4: {
    levelNum: "04",
    levelBadge: "LEVEL 4 • TIER 4 • FULL SYSTEM SCALING",
    scope: "Many-Core Compute Clusters & Complete Tapeout SoCs",
    borderClass: "ladder-border-lime",
    badgeClass: "badge-lime",
    colorVar: "var(--lime)",
    bottleneck: "Software atomic spinlocks saturate shared crossbars past 64 cores, and autonomous DMA engines incur MMIO configuration setup penalties on small transfers (<128B).",
    remedy: "Hardware collective barrier synchronization networks (FractalSync) and single-cycle instruction-triggered streaming DMA engines.",
    keyTools: "Cheshire (64-bit Linux SoC), Snitch Cluster, MemPool (432-core shared-L1), PULPissimo (single-core MCU SoC), OpenPiton",
    ctaText: "Explore Level 4 SoC & Multi-Core",
  },
};

function getToolUrl(tool: any) {
  switch (tool.categoryNumber) {
    case 1: return `/mcu-scalar/#core-${tool.slug}`;
    case 2: return `/app-cores/#core-${tool.slug}`;
    case 3: return `/vector-coprocessors/#core-${tool.slug}`;
    case 4: return `/soc-multicore/#core-${tool.slug}`;
    default: return `/soc-multicore/#core-${tool.slug}`;
  }
}
---

<BaseLayout 
  title="Home" 
  description="Survey and empirical benchmarking platform across 51 open-source RISC-V tools, 4 architecture categories, and 4 verification levels."
>
  <!-- Hero Section -->
  <div class="noc-hero">
    <h1>Open-Source RISC-V Hardware: <span class="score-highlight">From Transistors to Clusters</span></h1>

    <div class="hero-action-group">
      <a href="/fundamentals/" class="noc-sim-btn" style="background: var(--yellow);">📖 Architecture Fundamentals →</a>
      <a href="/mcu-scalar/" class="noc-sim-btn secondary">Cat 1: MCU / Scalar Cores</a>
      <a href="/app-cores/" class="noc-sim-btn secondary">Cat 2: Application Cores</a>
      <a href="/vector-coprocessors/" class="noc-sim-btn secondary">Cat 3: Vector &amp; Coprocessors</a>
      <a href="/soc-multicore/" class="noc-sim-btn secondary">Cat 4: SoC &amp; Multi-Core</a>
    </div>
  </div>

  <!-- 4-Level Progressive Architecture Ladder -->
  <section class="score-section">
    <div class="section-header">
      <div class="noc-track-badge" style="background: var(--cyan); margin-bottom: 0.5rem;">EVALUATION METHODOLOGY</div>
      <h2 class="section-title">The 4-Level Architecture &amp; Verification Ladder</h2>
    </div>

    <div class="methodology-ladder">
      {categories.map((cat, idx) => {
        const detail = categoryDetails[cat.number];
        const isLast = idx === categories.length - 1;
        return (
          <div class="ladder-step-wrapper">
            <article class={`ladder-step ${detail.borderClass}`}>
              <div class="ladder-header">
                <div class={`ladder-num-badge ${detail.badgeClass}`}>
                  {detail.levelNum}
                </div>
                <div class="ladder-title-wrap">
                  <div class="ladder-eyebrow">{detail.levelBadge}</div>
                  <h3 class="ladder-title">{cat.title}</h3>
                  <div class="ladder-scope-pill">{detail.scope}</div>
                </div>
              </div>

              <div class="ladder-body">
                <p class="ladder-narrative">{cat.description}</p>

                <div class="ladder-specs-grid">
                  <div class="ladder-spec-card">
                    <span class="lsc-label">Evaluation Profile</span>
                    <span class="lsc-val"><code>{cat.profile}</code></span>
                  </div>
                  <div class="ladder-spec-card">
                    <span class="lsc-label">Standard Workloads</span>
                    <span class="lsc-val">{cat.workloads.join(", ")}</span>
                  </div>
                  <div class="ladder-spec-card">
                    <span class="lsc-label">Key Metrics</span>
                    <span class="lsc-val">{cat.metrics.join(", ")}</span>
                  </div>
                  <div class="ladder-spec-card">
                    <span class="lsc-label">Evaluated Hardware</span>
                    <span class="lsc-val">{detail.keyTools}</span>
                  </div>
                </div>

                <div class="ladder-insight-box">
                  <div class="lib-row">
                    <strong class="lib-tag bottleneck">Empirical Bottleneck:</strong>
                    <span>{detail.bottleneck}</span>
                  </div>
                  <div class="lib-row">
                    <strong class="lib-tag remedy">Next-Gen Remedy:</strong>
                    <span>{detail.remedy}</span>
                  </div>
                </div>
              </div>

              <div class="ladder-footer">
                <div class="ladder-tools-pill">
                  <span class="lt-icon">📦</span>
                  <span><strong>{cat.tools.length}</strong> Evaluated Tools</span>
                </div>
                <a href={categoryLinks[cat.number]} class="ladder-cta-btn">
                  <span>{detail.ctaText}</span>
                  <span class="btn-arrow">&rarr;</span>
                </a>
              </div>
            </article>

            {!isLast && detail.transitionText && (
              <div class="ladder-connector">
                <div class="connector-line"></div>
                <div class="connector-pill">
                  <span>&darr; {detail.transitionText}</span>
                </div>
                <div class="connector-line"></div>
              </div>
            )}
          </div>
        );
      })}
    </div>
  </section>

  <!-- Empirical Findings & Architectural Opportunities (Top-Down Progressive Flow) -->
  <section class="score-section">
    <div class="noc-book-banner" style="display: block; padding: 24px; box-shadow: 6px 6px 0px var(--coral); background: var(--cream, #fffaf0); border: 2px solid var(--ink, #151b20); border-radius: 14px;">
      <div class="insights-section-header">
        <span class="noc-track-badge" style="background: var(--coral); color: #ffffff; margin-bottom: 0;">EMPIRICAL BENCHMARK INSIGHTS</span>
        <h3 class="insights-main-title">Key Bottlenecks Driving Next-Generation Architectures</h3>
      </div>
      <p class="insights-intro-lead">
        Our cross-category cycle-accurate simulations reveal three critical architectural boundaries where traditional RISC-V hardware scaling breaks down. Each bottleneck is explored in depth within its respective subpage:
      </p>
      
      <div class="insights-topdown">
        <!-- Step 1: Vector Utilization Collapse -->
        <article class="insight-step-card insight-border-coral">
          <div class="insight-step-header">
            <div class="insight-step-badge badge-coral">01</div>
            <div class="insight-step-meta">
              <div class="insight-eyebrow">INSIGHT 01 &bull; VECTOR ARITHMETIC INTENSITY</div>
              <h4 class="insight-title">1. Vector Utilization Collapse: Scalar Issue Serialization &amp; VRF Bank Conflicts</h4>
            </div>
            <a href="/vector-coprocessors/" class="insight-cat-link cat-coral">
              <span>Cat 3: Vector &amp; Coprocessor Acceleration Engines</span>
              <span class="cat-link-arrow">&rarr;</span>
            </a>
          </div>

          <div class="insight-step-body">
            <p class="insight-narrative">
              On dense matrix multiplication (<code>fmatmul</code>), <strong>Ara (RVV 1.0)</strong> achieves up to <strong>98.4%</strong> vector execution utilization. However, on memory-strided and reduction kernels (<code>softmax</code>, <code>fft</code>), utilization collapses to <strong>23.0%</strong> due to scalar issue serialization, vector register file (VRF) bank conflicts, and lane starvation.
            </p>

            <div class="insight-metrics-grid">
              <div class="img-cell">
                <span class="img-label">Peak Workload</span>
                <span class="img-val highlight-green"><code>fmatmul: 98.4%</code></span>
              </div>
              <div class="img-cell">
                <span class="img-label">Strided Collapse</span>
                <span class="img-val highlight-coral"><code>softmax / fft: 23.0%</code></span>
              </div>
              <div class="img-cell">
                <span class="img-label">Evaluated Hardware</span>
                <span class="img-val">Ara (RVV 1.0, 4–16 Lanes), Spatz</span>
              </div>
              <div class="img-cell">
                <span class="img-label">Root Cause</span>
                <span class="img-val">Scalar Issue Serialization &amp; VRF Contention</span>
              </div>
            </div>

            <div class="insight-remedy-box">
              <span class="remedy-tag">&rarr; Next-Gen Remedy</span>
              <span class="remedy-text">Decoupled Access-Execute (DAE) vector coprocessors with multi-bank conflict-free VRFs and systolic weight-stationary matrix tiles.</span>
            </div>
          </div>
        </article>

        <!-- Connector 1 -> 2 -->
        <div class="ladder-connector">
          <div class="connector-line"></div>
          <div class="connector-pill">
            <span>&darr; Architectural Scale: From Vector Execution to Shared-Memory Multi-Core Clusters</span>
          </div>
          <div class="connector-line"></div>
        </div>

        <!-- Step 2: Manycore Spinlock Wall -->
        <article class="insight-step-card insight-border-lime">
          <div class="insight-step-header">
            <div class="insight-step-badge badge-lime">02</div>
            <div class="insight-step-meta">
              <div class="insight-eyebrow">INSIGHT 02 &bull; MULTI-CORE CLUSTER SYNCHRONIZATION</div>
              <h4 class="insight-title">2. Manycore Spinlock Wall: Interconnect Saturation Under Software Barriers</h4>
            </div>
            <a href="/soc-multicore/" class="insight-cat-link cat-lime">
              <span>Cat 4: Full SoC Platforms &amp; Multi-Core Clusters</span>
              <span class="cat-link-arrow">&rarr;</span>
            </a>
          </div>

          <div class="insight-step-body">
            <p class="insight-narrative">
              In shared-memory multi-core clusters (<strong>MemPool</strong> and <strong>Snitch</strong>), software barrier synchronization degrades exponentially past 64 cores. Software atomic memory operations (AMO) saturate the interconnect logarithmic crossbar, turning speedup negative on fine-grained parallel kernels.
            </p>

            <div class="insight-metrics-grid">
              <div class="img-cell">
                <span class="img-label">Linear Scaling</span>
                <span class="img-val highlight-green">Up to 64 Cores</span>
              </div>
              <div class="img-cell">
                <span class="img-label">Saturation Wall</span>
                <span class="img-val highlight-coral">256–432 Cores (AMO Saturation)</span>
              </div>
              <div class="img-cell">
                <span class="img-label">Evaluated Hardware</span>
                <span class="img-val">MemPool (256/432 Cores), Snitch Cluster</span>
              </div>
              <div class="img-cell">
                <span class="img-label">Root Cause</span>
                <span class="img-val">Interconnect Polling &amp; Crossbar Congestion</span>
              </div>
            </div>

            <div class="insight-remedy-box">
              <span class="remedy-tag">&rarr; Next-Gen Remedy</span>
              <span class="remedy-text">In-network hardware collective barriers (FractalSync) and dedicated hierarchical reduction trees.</span>
            </div>
          </div>
        </article>

        <!-- Connector 2 -> 3 -->
        <div class="ladder-connector">
          <div class="connector-line"></div>
          <div class="connector-pill">
            <span>&darr; Architectural Scale: From Cluster Synchronization Networks to Full-SoC Streaming DMA Engines</span>
          </div>
          <div class="connector-line"></div>
        </div>

        <!-- Step 3: DMA MMIO Setup Penalty -->
        <article class="insight-step-card insight-border-teal">
          <div class="insight-step-header">
            <div class="insight-step-badge badge-teal">03</div>
            <div class="insight-step-meta">
              <div class="insight-eyebrow">INSIGHT 03 &bull; FULL-SOC DATA MOVEMENT &amp; I/O</div>
              <h4 class="insight-title">3. DMA MMIO Setup Penalty: Configuration Latency on Fine-Grained Transfers</h4>
            </div>
            <a href="/soc-multicore/" class="insight-cat-link cat-teal">
              <span>Cat 4: Full SoC Platforms &amp; Multi-Core Clusters</span>
              <span class="cat-link-arrow">&rarr;</span>
            </a>
          </div>

          <div class="insight-step-body">
            <p class="insight-narrative">
              Full SoC benchmarks (<strong>Cheshire</strong> and <strong>PULPissimo</strong>) show that transferring payloads smaller than 128 bytes via an autonomous DMA engine incurs higher latency than scalar CPU memory copies due to multi-register MMIO configuration setup overhead.
            </p>

            <div class="insight-metrics-grid">
              <div class="img-cell">
                <span class="img-label">Break-Even Threshold</span>
                <span class="img-val highlight-coral">&lt; 128 Bytes (CPU Faster than DMA)</span>
              </div>
              <div class="img-cell">
                <span class="img-label">Optimal Payload</span>
                <span class="img-val highlight-green">&gt; 1 KB (DMA Throughput Dominates)</span>
              </div>
              <div class="img-cell">
                <span class="img-label">Evaluated Hardware</span>
                <span class="img-val">Cheshire (64-bit Linux SoC), PULPissimo</span>
              </div>
              <div class="img-cell">
                <span class="img-label">Root Cause</span>
                <span class="img-val">MMIO Register Handshake Latency</span>
              </div>
            </div>

            <div class="insight-remedy-box">
              <span class="remedy-tag">&rarr; Next-Gen Remedy</span>
              <span class="remedy-text">Single-cycle instruction-triggered streaming DMA engines and zero-overhead DMA descriptors.</span>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Featured Tools Directory Preview (Ordered Top-Down by Category 1 -> 4) -->
  <section class="score-section">
    <div class="section-header">
      <div class="noc-track-badge" style="background: var(--yellow); margin-bottom: 0.5rem;">TOOLS &amp; HARDWARE DOSSIERS</div>
      <h2 class="section-title">Featured Anchor Architectures</h2>
      <p class="section-subtitle">
        Representative open-source silicon-proven cores and clusters evaluated in our empirical study, ordered top-down across the 4 architecture categories. Every design is backed by synthesizable RTL and automated simulation scripts in this repository.
      </p>
    </div>

    <div class="category-tiers-topdown">
      {categoryFeaturedTiers.map((tier, tIdx) => {
        const isLastTier = tIdx === categoryFeaturedTiers.length - 1;
        return (
          <div class="tier-block-wrapper">
            <div class={`category-tier-block ${tier.borderClass}`}>
              <div class="tier-header">
                <div class="tier-title-group">
                  <span class={`tier-badge ${tier.badgeClass}`}>{tier.badge}</span>
                  <h3 class="tier-heading">{tier.title}</h3>
                  <span class="tier-scope">{tier.scope}</span>
                </div>
                <a href={tier.href} class="tier-explore-btn">
                  <span>{tier.ctaText}</span>
                  <span class="btn-arrow">&rarr;</span>
                </a>
              </div>

              <div class="tier-tools-grid">
                {tier.slugs.map((slug) => {
                  const tool = toolsBySlug[slug];
                  if (!tool) return null;
                  return (
                    <div class="tool-card">
                      <div class="tool-card-main">
                        <div class="tool-card-top">
                          <span class={`tool-badge ${tier.badgeClass}`}>Cat {tool.categoryNumber}: {tool.categoryName.split(':')[1]?.trim() || tool.categoryName}</span>
                          <span class="tool-lang">{tool.language}</span>
                        </div>
                        <h4 class="tool-name">
                          <a href={getToolUrl(tool)}>{tool.name}</a>
                        </h4>
                        <p class="tool-sub">{tool.subtitle}</p>
                      </div>
                      
                      <div class="tool-specs">
                        <div class="spec-row">
                          <span class="spec-label">ISA:</span>
                          <span class="spec-val"><code>{tool.isa}</code></span>
                        </div>
                        <div class="spec-row">
                          <span class="spec-label">Bus:</span>
                          <span class="spec-val">{tool.bus}</span>
                        </div>
                        <div class="spec-row">
                          <span class="spec-label">License:</span>
                          <span class="spec-val">{tool.license.split('(')[0]?.trim()}</span>
                        </div>
                      </div>

                      <div class="tool-actions">
                        {tool.benchmarks.length > 0 && (
                          <span class="bench-tag">&#10003; {tool.benchmarks.length} Traces</span>
                        )}
                        <a href={getToolUrl(tool)} class="noc-sim-btn secondary" style="font-size: 0.82rem; padding: 6px 14px; white-space: nowrap;">Architecture Deep Dive &rarr;</a>
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>

            {!isLastTier && tier.connectorText && (
              <div class="ladder-connector">
                <div class="connector-line"></div>
                <div class="connector-pill">
                  <span>&darr; {tier.connectorText}</span>
                </div>
                <div class="connector-line"></div>
              </div>
            )}
          </div>
        );
      })}
    </div>

    <div class="center-cta" style="margin-top: 2.5rem; display: flex; justify-content: center; gap: 0.75rem; flex-wrap: wrap;">
      <a href="/mcu-scalar/" class="noc-sim-btn secondary">Cat 1: MCU / Scalar Cores &rarr;</a>
      <a href="/app-cores/" class="noc-sim-btn secondary">Cat 2: Application Cores &rarr;</a>
      <a href="/vector-coprocessors/" class="noc-sim-btn secondary">Cat 3: Vector &amp; Coprocessors &rarr;</a>
      <a href="/soc-multicore/" class="noc-sim-btn secondary">Cat 4: SoC &amp; Multi-Core &rarr;</a>
    </div>
  </section>

</BaseLayout>

<style>
  .score-highlight {
    background: linear-gradient(180deg, transparent 65%, var(--yellow) 65%);
  }

  .score-section {
    margin-bottom: 3.5rem;
  }

  .section-header {
    margin-bottom: 1.75rem;
  }

  .section-title {
    font-size: 2rem;
    font-weight: 900;
    margin-top: 0.25rem;
    margin-bottom: 0.5rem;
    color: var(--ink);
    letter-spacing: -0.02em;
  }

  .section-subtitle {
    font-size: 1.05rem;
    color: var(--ink-light);
    max-width: 820px;
    line-height: 1.6;
  }

  .hero-action-group {
    display: flex;
    gap: 0.65rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }

  /* 4-Level Progressive Architecture Ladder (Top-Down Flow) */
  .methodology-ladder {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .ladder-step-wrapper {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .ladder-step {
    background: var(--cream, #fffaf0);
    border: 2px solid var(--ink, #151b20);
    border-radius: 14px;
    box-shadow: 5px 5px 0px var(--ink, #151b20);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .ladder-step:hover {
