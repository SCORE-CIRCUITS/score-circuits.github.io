---
import BaseLayout from "../layouts/BaseLayout.astro";
import db from "../data/score_db.json";

const counts = db.counts;
const categories = db.categories;
const featuredTools = db.tools.filter(t => 
  ["cva6", "ara", "snitch-cluster", "cheshire", "ibex", "gemmini", "mempool", "hazard3"].includes(t.slug)
);

const categoryLinks: Record<number, string> = {
  1: "/mcu-scalar/",
  2: "/app-cores/",
  3: "/vector-coprocessors/",
  4: "/soc-multicore/",
};

function getToolUrl(tool: any) {
  switch (tool.categoryNumber) {
    case 1: return `/mcu-scalar/#core-${tool.slug}`;
    case 2: return `/app-cores/#core-${tool.slug}`;
    case 3: return `/vector-coprocessors/#core-${tool.slug}`;
    case 4: return `/soc-multicore/#core-${tool.slug}`;
    default: return `/soc-multicore/#core-${tool.slug}`;
  }
}
---

<BaseLayout 
  title="Home" 
  description="Survey and empirical benchmarking platform across 51 open-source RISC-V tools, 4 architecture categories, and 4 verification levels."
>
  <!-- Hero Section -->
  <div class="noc-hero">
    <div class="noc-track-badge">✨ OPEN SILICON EVIDENCE &bull; 51 EVALUATED TOOLS</div>
    <h1>Open-Source RISC-V Hardware: <span class="score-highlight">From Transistors to Clusters</span></h1>
    <p class="subtitle">
      A systematic empirical survey and reproducible benchmarking suite spanning <strong>51 open hardware tools</strong> and architectures across <strong>4 categories</strong>—from sub-10 kGE microcontroller cores up to 432-core heterogeneous compute platforms.
    </p>

    <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 1.5rem;">
      <a href="/fundamentals/" class="noc-sim-btn" style="background: var(--yellow);">📖 Architecture Fundamentals →</a>
      <a href="/mcu-scalar/" class="noc-sim-btn secondary">01. MCU Cores</a>
      <a href="/app-cores/" class="noc-sim-btn secondary">02. 64-bit App Cores</a>
      <a href="/vector-coprocessors/" class="noc-sim-btn secondary">03. Vector Engines</a>
      <a href="/soc-multicore/" class="noc-sim-btn secondary">04. SoC &amp; Clusters</a>
    </div>
  </div>

  <!-- Key Metrics Grid -->
  <div class="noc-stats-grid">
    <div class="noc-stat-card">
      <span class="noc-stat-number">{counts.tools}</span>
      <span class="noc-stat-label">Evaluated Tools &amp; Cores</span>
    </div>
    <div class="noc-stat-card">
      <span class="noc-stat-number" style="color: #b45309;">4</span>
      <span class="noc-stat-label">Architecture Categories</span>
    </div>
    <div class="noc-stat-card">
      <span class="noc-stat-number" style="color: #e11d48;">{counts.measuredRuns}</span>
      <span class="noc-stat-label">Aggregated Benchmark Traces</span>
    </div>
    <div class="noc-stat-card">
      <span class="noc-stat-number" style="color: #0e7490;">100%</span>
      <span class="noc-stat-label">Open Silicon Evidence</span>
    </div>
    <div class="noc-stat-card">
      <span class="noc-stat-number" style="color: #059669;">4</span>
      <span class="noc-stat-label">Evaluation Levels</span>
    </div>
  </div>

  <!-- 4 Categories Architecture Framework -->
  <section class="score-section">
    <div class="section-header">
      <div class="noc-track-badge" style="background: var(--cyan); margin-bottom: 0.5rem;">EVALUATION METHODOLOGY</div>
      <h2 class="section-title">The 4 Architecture Categories</h2>
      <p class="section-subtitle">
        Unlike generic literature reviews, SCORE evaluates architectures within an aligned 4-tier benchmarking framework designed to isolate bottlenecks at each layer of abstraction.
      </p>
    </div>

    <div class="categories-grid">
      {categories.map((cat) => (
        <div class={`category-card cat-card-${cat.number}`}>
          <div class="cat-card-header">
            <span class="cat-num">0{cat.number}</span>
            <span class="cat-badge">{cat.badge}</span>
          </div>
          <h3 class="cat-title">{cat.title}</h3>
          <p class="cat-desc">{cat.description}</p>
          
          <div class="cat-meta-block">
            <div class="cat-meta-item">
              <strong>Evaluation Profile:</strong> <code>{cat.profile}</code>
            </div>
            <div class="cat-meta-item">
              <strong>Standard Workloads:</strong> {cat.workloads.join(", ")}
            </div>
            <div class="cat-meta-item">
              <strong>Key Metrics:</strong> {cat.metrics.join(", ")}
            </div>
          </div>

          <div class="cat-card-footer">
            <span class="cat-tools-count"><strong>{cat.tools.length}</strong> Tools Included</span>
            <a href={categoryLinks[cat.number]} class="cat-link">Explore Category &rarr;</a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Empirical Findings & Architectural Opportunities -->
  <section class="score-section">
    <div class="noc-book-banner" style="display: block; padding: 24px; box-shadow: 6px 6px 0px var(--coral);">
      <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 0.75rem;">
        <span class="noc-track-badge" style="background: var(--coral); color: #ffffff; margin-bottom: 0;">EMPIRICAL BENCHMARK INSIGHTS</span>
        <h3 style="margin: 0; font-size: 1.25rem; font-weight: 800; color: var(--ink);">Key Bottlenecks Driving Next-Generation Architectures</h3>
      </div>
      <p style="margin-bottom: 1.25rem; color: var(--ink-light); font-size: 0.95rem; line-height: 1.6;">
        Our cross-category cycle-accurate simulations reveal three critical architectural boundaries where traditional RISC-V hardware scaling breaks down:
      </p>
      
      <div class="insights-grid">
        <div class="insight-box">
          <h4>1. Vector Utilization Collapse</h4>
          <p>
            On dense matrix multiplication (<code>fmatmul</code>), <strong>Ara (RVV 1.0)</strong> achieves up to <strong>98.4%</strong> vector execution utilization. However, on memory-strided and reduction kernels (<code>softmax</code>, <code>fft</code>), utilization collapses to <strong>23.0%</strong> due to scalar issue serialization and VRF bank conflicts.
          </p>
          <div class="insight-solution">&rarr; Next-Gen Remedy: Decoupled Access-Execute (DAE) vector coprocessors.</div>
        </div>
        <div class="insight-box">
          <h4>2. Manycore Spinlock Wall</h4>
          <p>
            In shared-memory multi-core clusters (<strong>MemPool</strong> and <strong>Snitch</strong>), software barrier synchronization degrades exponentially past 64 cores. Software atomic operations (AMO) saturate the interconnect crossbar, negating speedup for fine-grained parallel kernels.
          </p>
          <div class="insight-solution">&rarr; Next-Gen Remedy: In-network hardware collective barriers (FractalSync).</div>
        </div>
        <div class="insight-box">
          <h4>3. DMA MMIO Setup Penalty</h4>
          <p>
            Full SoC benchmarks (<strong>Cheshire</strong> and <strong>PULPissimo</strong>) show that transferring payloads smaller than 128 bytes via an autonomous DMA engine incurs higher latency than scalar memory copies due to MMIO register configuration overhead.
          </p>
          <div class="insight-solution">&rarr; Next-Gen Remedy: Single-cycle instruction-triggered streaming DMA.</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Tools Directory Preview -->
  <section class="score-section">
    <div class="section-header">
      <div class="noc-track-badge" style="background: var(--yellow); margin-bottom: 0.5rem;">TOOLS &amp; HARDWARE DOSSIERS</div>
      <h2 class="section-title">Featured Anchor Architectures</h2>
      <p class="section-subtitle">
        Explore representative cores and platforms evaluated in our empirical study. Every tool is backed by synthesizable RTL and automated simulation scripts in this repository.
      </p>
    </div>

    <div class="tools-grid">
      {featuredTools.map((tool) => (
        <div class="tool-card">
          <div class="tool-card-top">
            <span class="tool-badge">Cat {tool.categoryNumber}: {tool.categoryName.split(':')[1]?.trim() || tool.categoryName}</span>
            <span class="tool-lang">{tool.language}</span>
          </div>
          <h3 class="tool-name">
            <a href={getToolUrl(tool)}>{tool.name}</a>
          </h3>
          <p class="tool-sub">{tool.subtitle}</p>
          
          <div class="tool-specs">
            <div class="spec-row">
              <span class="spec-label">ISA:</span>
              <span class="spec-val"><code>{tool.isa}</code></span>
            </div>
            <div class="spec-row">
              <span class="spec-label">Bus:</span>
              <span class="spec-val">{tool.bus}</span>
            </div>
            <div class="spec-row">
              <span class="spec-label">License:</span>
              <span class="spec-val">{tool.license.split('(')[0]?.trim()}</span>
            </div>
          </div>

          <div class="tool-actions">
            <a href={getToolUrl(tool)} class="noc-sim-btn secondary" style="font-size: 0.8rem; padding: 6px 12px;">Architecture Deep Dive &rarr;</a>
            {tool.benchmarks.length > 0 && (
              <span class="bench-tag">&#10003; {tool.benchmarks.length} Traces</span>
            )}
          </div>
        </div>
      ))}
    </div>

    <div class="center-cta" style="margin-top: 2rem; display: flex; justify-content: center; gap: 0.75rem; flex-wrap: wrap;">
      <a href="/mcu-scalar/" class="noc-sim-btn secondary">01. MCU Cores &rarr;</a>
      <a href="/app-cores/" class="noc-sim-btn secondary">02. 64-bit App Cores &rarr;</a>
      <a href="/vector-coprocessors/" class="noc-sim-btn secondary">03. Vector Engines &rarr;</a>
      <a href="/soc-multicore/" class="noc-sim-btn secondary">04. SoC &amp; Clusters &rarr;</a>
    </div>
  </section>

  <!-- Reproduction Instructions -->
  <section class="score-section">
    <div class="repro-box">
      <div class="repro-header">
        <h3 style="margin: 0; font-size: 1.2rem; font-weight: 800; color: var(--ink);">Quick Reproducibility Commands</h3>
        <span class="noc-track-badge" style="background: var(--lime); margin-bottom: 0;">ZERO-CONFIG VERILATOR SUITE</span>
      </div>
      <p style="margin: 0.75rem 0; font-size: 0.92rem; color: var(--ink-light);">Clone the repository and run the automated test harnesses directly on your host:</p>
      <pre class="code-block" style="background: var(--paper-deep); border: 1.5px solid var(--ink); border-radius: 8px; padding: 1rem; overflow-x: auto;"><code><span class="token-comment"># 1. Clone repository with submodules</span>
git clone https://github.com/SCORE-CIRCUITS/score.git &amp;&amp; cd score

<span class="token-comment"># 2. Run Category 1 MCU benchmark suite (CoreMark &amp; Dhrystone across 9 cores)</span>
./scripts/benchmark_core_suite.sh

<span class="token-comment"># 3. Simulate Category 3 Ara Vector Coprocessor (RVV 1.0 fmatmul kernel)</span>
./scripts/run_ara.sh

<span class="token-comment"># 4. Run Category 4 Full SoC simulation (Cheshire 64-bit Linux SoC)</span>
./scripts/run_cheshire.sh</code></pre>
    </div>
  </section>
</BaseLayout>

<style>
  .score-highlight {
    background: linear-gradient(180deg, transparent 65%, var(--yellow) 65%);
  }

  .score-section {
    margin-bottom: 3.5rem;
  }

  .section-header {
    margin-bottom: 1.75rem;
  }

  .section-title {
    font-size: 2rem;
    font-weight: 900;
    margin-top: 0.25rem;
    margin-bottom: 0.5rem;
    color: var(--ink);
    letter-spacing: -0.02em;
  }

  .section-subtitle {
    font-size: 1.05rem;
    color: var(--ink-light);
    max-width: 820px;
    line-height: 1.6;
  }

  .categories-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .category-card {
    background: var(--cream, #fffaf0);
    border: 2px solid var(--ink, #151b20);
    border-radius: 14px;
    box-shadow: 5px 5px 0px var(--ink, #151b20);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .category-card:hover {
    transform: translate(-2px, -2px);
    box-shadow: 7px 7px 0px var(--cyan);
  }

  .cat-card-1 { border-top: 6px solid var(--yellow); }
  .cat-card-2 { border-top: 6px solid var(--cyan); }
  .cat-card-3 { border-top: 6px solid var(--coral); }
  .cat-card-4 { border-top: 6px solid var(--lime); }

  .cat-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .cat-num {
    font-size: 1.5rem;
    font-weight: 900;
    color: rgba(21, 27, 32, 0.4);
    font-family: var(--md-code-font, monospace);
  }

  .cat-badge {
    background: var(--paper);
    border: 1.5px solid var(--ink);
    border-radius: 6px;
    padding: 0.2rem 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .cat-title {
    font-size: 1.25rem;
    font-weight: 800;
    margin-bottom: 0.75rem;
    line-height: 1.3;
    color: var(--ink);
  }

  .cat-desc {
    font-size: 0.9rem;
    color: var(--ink-light);
    line-height: 1.55;
    margin-bottom: 1.25rem;
    flex-grow: 1;
  }

  .cat-meta-block {
    background: var(--paper);
    border: 1.5px solid var(--line);
    border-radius: 8px;
    padding: 0.75rem 0.85rem;
    margin-bottom: 1.25rem;
    font-size: 0.8rem;
  }

  .cat-meta-item {
    margin-bottom: 0.35rem;
  }

  .cat-card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.85rem;
  }

  .cat-tools-count {
    color: var(--ink-light);
    font-size: 0.82rem;
  }

  .cat-link {
    font-weight: 800;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 2px solid var(--ink);
    padding-bottom: 1px;
    transition: all 0.15s ease;
  }

  .cat-link:hover {
    background: var(--yellow);
  }

  .insights-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
    margin-top: 1.25rem;
  }

  .insight-box {
    background: var(--cream);
    border: 2px solid var(--ink);
    border-radius: 12px;
    box-shadow: 4px 4px 0px var(--ink);
    padding: 1.25rem;
  }

  .insight-box h4 {
    font-size: 1.05rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
    color: var(--ink);
  }

  .insight-box p {
    font-size: 0.88rem;
    line-height: 1.55;
    margin-bottom: 0.75rem;
    color: var(--ink-light);
  }

  .insight-solution {
    font-size: 0.8rem;
    font-weight: 800;
    color: #065f46;
    background: var(--lime-soft);
    border: 1.5px solid var(--ink);
    border-radius: 6px;
    padding: 0.35rem 0.55rem;
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .tool-card {
    background: var(--cream, #fffaf0);
    border: 2px solid var(--ink, #151b20);
    border-radius: 14px;
    box-shadow: 5px 5px 0px var(--ink, #151b20);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .tool-card:hover {
    transform: translate(-2px, -2px);
    box-shadow: 7px 7px 0px var(--yellow);
  }

  .tool-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .tool-badge {
    background: var(--yellow-soft);
    border: 1.5px solid var(--ink);
    border-radius: 6px;
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--ink);
    padding: 0.2rem 0.45rem;
  }

  .tool-lang {
    font-size: 0.72rem;
    color: var(--ink-light);
    font-family: var(--md-code-font, monospace);
    font-weight: 600;
  }

  .tool-name {
    font-size: 1.35rem;
    font-weight: 900;
    margin-bottom: 0.25rem;
    letter-spacing: -0.01em;
  }

  .tool-name a {
    color: var(--ink);
    text-decoration: none;
  }

  .tool-name a:hover {
    color: #0284c7;
  }

  .tool-sub {
    font-size: 0.85rem;
    color: var(--ink-light);
    margin-bottom: 1.25rem;
    line-height: 1.4;
  }

  .tool-specs {
    background: var(--paper);
    border: 1.5px solid var(--line);
    border-radius: 8px;
    padding: 0.75rem;
    margin-bottom: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .spec-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.8rem;
  }

  .spec-label {
    font-weight: 700;
    color: rgba(21, 27, 32, 0.6);
  }

  .spec-val {
    font-family: var(--md-code-font, monospace);
    font-weight: 600;
    color: var(--ink);
  }

  .tool-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
  }

  .bench-tag {
    font-size: 0.75rem;
    font-weight: 800;
    color: #065f46;
    background: var(--lime-soft);
    border: 1.5px solid var(--ink);
    border-radius: 6px;
    padding: 0.25rem 0.5rem;
  }

  .repro-box {
    background: var(--cream, #fffaf0);
    border: 2px solid var(--ink, #151b20);
    border-radius: 14px;
    box-shadow: 5px 5px 0px var(--cyan);
    padding: 2rem;
  }

  .repro-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .repro-header h3 {
    font-size: 1.4rem;
    font-weight: 900;
    margin: 0;
  }

  .code-block {
    background: var(--ink, #151b20);
    color: #ffffff;
    border: 2px solid var(--ink);
    border-radius: 10px;
    padding: 1.25rem;
    overflow-x: auto;
    font-family: var(--md-code-font, monospace);
    font-size: 0.9rem;
    line-height: 1.6;
    margin-top: 1rem;
  }

  .token-comment {
    color: #888888;
  }

  .center-cta {
    text-align: center;
  }
</style>

