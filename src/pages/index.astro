---
import BaseLayout from "../layouts/BaseLayout.astro";
import db from "../data/score_db.json";

const categories = db.categories;
const featuredTools = db.tools.filter(t => 
  ["cva6", "ara", "snitch-cluster", "cheshire", "ibex", "gemmini", "mempool", "hazard3"].includes(t.slug)
);

const categoryLinks: Record<number, string> = {
  1: "/mcu-scalar/",
  2: "/app-cores/",
  3: "/vector-coprocessors/",
  4: "/soc-multicore/",
};

const categoryDetails: Record<number, {
  levelNum: string;
  levelBadge: string;
  scope: string;
  borderClass: string;
  badgeClass: string;
  colorVar: string;
  bottleneck: string;
  remedy: string;
  keyTools: string;
  ctaText: string;
  transitionText?: string;
}> = {
  1: {
    levelNum: "01",
    levelBadge: "LEVEL 1 • TIER 1 • SCALAR MICROBENCHMARKS",
    scope: "Single-Thread & In-Order Embedded Pipelines",
    borderClass: "ladder-border-yellow",
    badgeClass: "badge-yellow",
    colorVar: "var(--yellow)",
    bottleneck: "Branch misprediction penalty incurs 1–2 idle bubble cycles on tight loops. Load-use dependencies stall simple 2-stage cores (e.g. Ibex) unless forwarding paths are expanded.",
    remedy: "Dual-issue in-order execution with static branch hints and zero-overhead hardware loop controllers (e.g. VeeR EL2, CV32E40P).",
    keyTools: "SERV (1-bit serial), PicoRV32, DarkRISCV, Ibex (2-stage), Hazard3 (3-stage), SCR1, VexRiscv (5-stage), VeeR EL2 (dual-issue)",
    ctaText: "Explore Level 1 MCU / Scalar Cores",
    transitionText: "Scale from Single-Issue Microcontrollers to Virtual Memory (Sv39/Sv48 MMU) & Multi-Level Caches",
  },
  2: {
    levelNum: "02",
    levelBadge: "LEVEL 2 • TIER 2 • MEMORY & OS COMPLIANCE",
    scope: "Linux-Capable In-Order & Out-of-Order Processors",
    borderClass: "ladder-border-cyan",
    badgeClass: "badge-cyan",
    colorVar: "var(--cyan)",
    bottleneck: "Memory Wall latency (50–100 ns DRAM) on L1/L2 cache misses and serialized 3-level page table walk latency upon TLB misses.",
    remedy: "Non-blocking split L1/L2 caches with MSHRs, hardware stream prefetchers, and out-of-order superscalar execution (BOOM).",
    keyTools: "CVA6 (6-stage in-order RV64GC), Rocket Chip (TileLink-UH), BlackParrot (BedRock coherent), BOOM (7–10 stage OoO)",
    ctaText: "Explore Level 2 Application Cores",
    transitionText: "Scale from Memory-Bound Scalar Pipelines to Data-Parallel RVV 1.0 Vector Engines & Systolic Arrays",
  },
  3: {
    levelNum: "03",
    levelBadge: "LEVEL 3 • TIER 3 • DOMAIN VECTOR ACCELERATION",
    scope: "Data-Parallel SIMD / RVV 1.0 & Systolic Accelerators",
    borderClass: "ladder-border-coral",
    badgeClass: "badge-coral",
    colorVar: "var(--coral)",
    bottleneck: "Vector lane utilization collapses from 98.4% on GEMM down to 23.0% on strided/reduction kernels (FFT, Softmax) due to scalar issue serialization and VRF bank conflicts.",
    remedy: "Decoupled Access-Execute (DAE) vector coprocessors with multi-bank conflict-free VRFs and systolic weight-stationary matrix tiles (Ara, Gemmini).",
    keyTools: "Ara (scalable 4–16 lanes RVV 1.0), AraXL (AXI bus), Gemmini (systolic GEMM array), Spatz (compact float coprocessor)",
    ctaText: "Explore Level 3 Vector & Coprocessors",
    transitionText: "Scale from Coprocessor Accelerators to Many-Core Clusters (up to 432 Cores), NoC Fabrics & DMA Engines",
  },
  4: {
    levelNum: "04",
    levelBadge: "LEVEL 4 • TIER 4 • FULL SYSTEM SCALING",
    scope: "Many-Core Compute Clusters & Complete Tapeout SoCs",
    borderClass: "ladder-border-lime",
    badgeClass: "badge-lime",
    colorVar: "var(--lime)",
    bottleneck: "Software atomic spinlocks saturate shared crossbars past 64 cores, and autonomous DMA engines incur MMIO configuration setup penalties on small transfers (<128B).",
    remedy: "Hardware collective barrier synchronization networks (FractalSync) and single-cycle instruction-triggered streaming DMA engines.",
    keyTools: "Cheshire (64-bit Linux SoC), Snitch Cluster, MemPool (432-core shared-L1), PULPissimo (single-core MCU SoC), OpenPiton",
    ctaText: "Explore Level 4 SoC & Multi-Core",
  },
};

function getToolUrl(tool: any) {
  switch (tool.categoryNumber) {
    case 1: return `/mcu-scalar/#core-${tool.slug}`;
    case 2: return `/app-cores/#core-${tool.slug}`;
    case 3: return `/vector-coprocessors/#core-${tool.slug}`;
    case 4: return `/soc-multicore/#core-${tool.slug}`;
    default: return `/soc-multicore/#core-${tool.slug}`;
  }
}
---

<BaseLayout 
  title="Home" 
  description="Survey and empirical benchmarking platform across 51 open-source RISC-V tools, 4 architecture categories, and 4 verification levels."
>
  <!-- Hero Section -->
  <div class="noc-hero">
    <h1>Open-Source RISC-V Hardware: <span class="score-highlight">From Transistors to Clusters</span></h1>

    <div class="hero-action-group">
      <a href="/fundamentals/" class="noc-sim-btn" style="background: var(--yellow);">📖 Architecture Fundamentals →</a>
      <a href="/mcu-scalar/" class="noc-sim-btn secondary">MCU / Scalar Cores</a>
      <a href="/app-cores/" class="noc-sim-btn secondary">Application Cores</a>
      <a href="/vector-coprocessors/" class="noc-sim-btn secondary">Vector &amp; Coprocessors</a>
      <a href="/soc-multicore/" class="noc-sim-btn secondary">SoC &amp; Multi-Core</a>
    </div>
  </div>

  <!-- 4-Level Progressive Architecture Ladder -->
  <section class="score-section">
    <div class="section-header">
      <div class="noc-track-badge" style="background: var(--cyan); margin-bottom: 0.5rem;">EVALUATION METHODOLOGY</div>
      <h2 class="section-title">The 4-Level Architecture &amp; Verification Ladder</h2>
    </div>

    <div class="methodology-ladder">
      {categories.map((cat, idx) => {
        const detail = categoryDetails[cat.number];
        const isLast = idx === categories.length - 1;
        return (
          <div class="ladder-step-wrapper">
            <article class={`ladder-step ${detail.borderClass}`}>
              <div class="ladder-header">
                <div class={`ladder-num-badge ${detail.badgeClass}`}>
                  {detail.levelNum}
                </div>
                <div class="ladder-title-wrap">
                  <div class="ladder-eyebrow">{detail.levelBadge}</div>
                  <h3 class="ladder-title">{cat.title}</h3>
                  <div class="ladder-scope-pill">{detail.scope}</div>
                </div>
              </div>

              <div class="ladder-body">
                <p class="ladder-narrative">{cat.description}</p>

                <div class="ladder-specs-grid">
                  <div class="ladder-spec-card">
                    <span class="lsc-label">Evaluation Profile</span>
                    <span class="lsc-val"><code>{cat.profile}</code></span>
                  </div>
                  <div class="ladder-spec-card">
                    <span class="lsc-label">Standard Workloads</span>
                    <span class="lsc-val">{cat.workloads.join(", ")}</span>
                  </div>
                  <div class="ladder-spec-card">
                    <span class="lsc-label">Key Metrics</span>
                    <span class="lsc-val">{cat.metrics.join(", ")}</span>
                  </div>
                  <div class="ladder-spec-card">
                    <span class="lsc-label">Evaluated Hardware</span>
                    <span class="lsc-val">{detail.keyTools}</span>
                  </div>
                </div>

                <div class="ladder-insight-box">
                  <div class="lib-row">
                    <strong class="lib-tag bottleneck">Empirical Bottleneck:</strong>
                    <span>{detail.bottleneck}</span>
                  </div>
                  <div class="lib-row">
                    <strong class="lib-tag remedy">Next-Gen Remedy:</strong>
                    <span>{detail.remedy}</span>
                  </div>
                </div>
              </div>

              <div class="ladder-footer">
                <div class="ladder-tools-pill">
                  <span class="lt-icon">📦</span>
                  <span><strong>{cat.tools.length}</strong> Evaluated Tools</span>
                </div>
                <a href={categoryLinks[cat.number]} class="ladder-cta-btn">
                  <span>{detail.ctaText}</span>
                  <span class="btn-arrow">&rarr;</span>
                </a>
              </div>
            </article>

            {!isLast && detail.transitionText && (
              <div class="ladder-connector">
                <div class="connector-line"></div>
                <div class="connector-pill">
                  <span>&darr; {detail.transitionText}</span>
                </div>
                <div class="connector-line"></div>
              </div>
            )}
          </div>
        );
      })}
    </div>
  </section>

  <!-- Empirical Findings & Architectural Opportunities -->
  <section class="score-section">
    <div class="noc-book-banner" style="display: block; padding: 24px; box-shadow: 6px 6px 0px var(--coral);">
      <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 0.75rem;">
        <span class="noc-track-badge" style="background: var(--coral); color: #ffffff; margin-bottom: 0;">EMPIRICAL BENCHMARK INSIGHTS</span>
        <h3 style="margin: 0; font-size: 1.25rem; font-weight: 800; color: var(--ink);">Key Bottlenecks Driving Next-Generation Architectures</h3>
      </div>
      <p style="margin-bottom: 1.25rem; color: var(--ink-light); font-size: 0.95rem; line-height: 1.6;">
        Our cross-category cycle-accurate simulations reveal three critical architectural boundaries where traditional RISC-V hardware scaling breaks down:
      </p>
      
      <div class="insights-grid">
        <div class="insight-box">
          <h4>1. Vector Utilization Collapse</h4>
          <p>
            On dense matrix multiplication (<code>fmatmul</code>), <strong>Ara (RVV 1.0)</strong> achieves up to <strong>98.4%</strong> vector execution utilization. However, on memory-strided and reduction kernels (<code>softmax</code>, <code>fft</code>), utilization collapses to <strong>23.0%</strong> due to scalar issue serialization and VRF bank conflicts.
          </p>
          <div class="insight-solution">&rarr; Next-Gen Remedy: Decoupled Access-Execute (DAE) vector coprocessors.</div>
        </div>
        <div class="insight-box">
          <h4>2. Manycore Spinlock Wall</h4>
          <p>
            In shared-memory multi-core clusters (<strong>MemPool</strong> and <strong>Snitch</strong>), software barrier synchronization degrades exponentially past 64 cores. Software atomic operations (AMO) saturate the interconnect crossbar, negating speedup for fine-grained parallel kernels.
          </p>
          <div class="insight-solution">&rarr; Next-Gen Remedy: In-network hardware collective barriers (FractalSync).</div>
        </div>
        <div class="insight-box">
          <h4>3. DMA MMIO Setup Penalty</h4>
          <p>
            Full SoC benchmarks (<strong>Cheshire</strong> and <strong>PULPissimo</strong>) show that transferring payloads smaller than 128 bytes via an autonomous DMA engine incurs higher latency than scalar memory copies due to MMIO register configuration overhead.
          </p>
          <div class="insight-solution">&rarr; Next-Gen Remedy: Single-cycle instruction-triggered streaming DMA.</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Tools Directory Preview -->
  <section class="score-section">
    <div class="section-header">
      <div class="noc-track-badge" style="background: var(--yellow); margin-bottom: 0.5rem;">TOOLS &amp; HARDWARE DOSSIERS</div>
      <h2 class="section-title">Featured Anchor Architectures</h2>
      <p class="section-subtitle">
        Explore representative cores and platforms evaluated in our empirical study. Every tool is backed by synthesizable RTL and automated simulation scripts in this repository.
      </p>
    </div>

    <div class="tools-grid">
      {featuredTools.map((tool) => (
        <div class="tool-card">
          <div class="tool-card-top">
            <span class="tool-badge">Cat {tool.categoryNumber}: {tool.categoryName.split(':')[1]?.trim() || tool.categoryName}</span>
            <span class="tool-lang">{tool.language}</span>
          </div>
          <h3 class="tool-name">
            <a href={getToolUrl(tool)}>{tool.name}</a>
          </h3>
          <p class="tool-sub">{tool.subtitle}</p>
          
          <div class="tool-specs">
            <div class="spec-row">
              <span class="spec-label">ISA:</span>
              <span class="spec-val"><code>{tool.isa}</code></span>
            </div>
            <div class="spec-row">
              <span class="spec-label">Bus:</span>
              <span class="spec-val">{tool.bus}</span>
            </div>
            <div class="spec-row">
              <span class="spec-label">License:</span>
              <span class="spec-val">{tool.license.split('(')[0]?.trim()}</span>
            </div>
          </div>

          <div class="tool-actions">
            <a href={getToolUrl(tool)} class="noc-sim-btn secondary" style="font-size: 0.8rem; padding: 6px 12px;">Architecture Deep Dive &rarr;</a>
            {tool.benchmarks.length > 0 && (
              <span class="bench-tag">&#10003; {tool.benchmarks.length} Traces</span>
            )}
          </div>
        </div>
      ))}
    </div>

    <div class="center-cta" style="margin-top: 2rem; display: flex; justify-content: center; gap: 0.75rem; flex-wrap: wrap;">
      <a href="/mcu-scalar/" class="noc-sim-btn secondary">MCU / Scalar Cores &rarr;</a>
      <a href="/app-cores/" class="noc-sim-btn secondary">Application Cores &rarr;</a>
      <a href="/vector-coprocessors/" class="noc-sim-btn secondary">Vector &amp; Coprocessors &rarr;</a>
      <a href="/soc-multicore/" class="noc-sim-btn secondary">SoC &amp; Multi-Core &rarr;</a>
    </div>
  </section>

</BaseLayout>

<style>
  .score-highlight {
    background: linear-gradient(180deg, transparent 65%, var(--yellow) 65%);
  }

  .score-section {
    margin-bottom: 3.5rem;
  }

  .section-header {
    margin-bottom: 1.75rem;
  }

  .section-title {
    font-size: 2rem;
    font-weight: 900;
    margin-top: 0.25rem;
    margin-bottom: 0.5rem;
    color: var(--ink);
    letter-spacing: -0.02em;
  }

  .section-subtitle {
    font-size: 1.05rem;
    color: var(--ink-light);
    max-width: 820px;
    line-height: 1.6;
  }

  .hero-action-group {
    display: flex;
    gap: 0.65rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }

  /* 4-Level Progressive Architecture Ladder (Top-Down Flow) */
  .methodology-ladder {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .ladder-step-wrapper {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .ladder-step {
    background: var(--cream, #fffaf0);
    border: 2px solid var(--ink, #151b20);
    border-radius: 14px;
    box-shadow: 5px 5px 0px var(--ink, #151b20);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .ladder-step:hover {
    transform: translateY(-2px);
    box-shadow: 7px 7px 0px var(--ink, #151b20);
  }

  .ladder-border-yellow { border-left: 8px solid var(--yellow, #ffc83e) !important; }
  .ladder-border-cyan   { border-left: 8px solid var(--cyan, #22bfd7) !important; }
  .ladder-border-coral  { border-left: 8px solid var(--coral, #f38469) !important; }
  .ladder-border-lime   { border-left: 8px solid var(--lime, #b7df69) !important; }

  .badge-yellow { background: var(--yellow, #ffc83e) !important; color: var(--ink, #151b20) !important; }
  .badge-cyan   { background: var(--cyan, #22bfd7) !important; color: #ffffff !important; }
  .badge-coral  { background: var(--coral, #f38469) !important; color: #ffffff !important; }
  .badge-lime   { background: var(--lime, #b7df69) !important; color: var(--ink, #151b20) !important; }

  .ladder-header {
    display: flex;
    align-items: flex-start;
    gap: 1.15rem;
    margin-bottom: 1.25rem;
  }

  .ladder-num-badge {
    font-size: 1.35rem;
    font-weight: 900;
    font-family: var(--md-code-font, monospace);
    width: 50px;
    height: 50px;
    border-radius: 10px;
    border: 2px solid var(--ink, #151b20);
    box-shadow: 2.5px 2.5px 0px var(--ink, #151b20);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .ladder-title-wrap {
    flex: 1;
    min-width: 0;
  }

  .ladder-eyebrow {
    font-size: 0.72rem;
    font-weight: 900;
    font-family: var(--md-code-font, monospace);
    letter-spacing: 0.04em;
    color: var(--ink-light, #242c33);
    margin-bottom: 0.25rem;
    text-transform: uppercase;
  }

  .ladder-title {
    font-size: 1.35rem;
    font-weight: 900;
    color: var(--ink, #151b20);
    margin: 0 0 0.35rem 0;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .ladder-scope-pill {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--ink, #151b20);
    background: var(--paper, #fffaf0);
    border: 1.5px solid var(--line, #eee4c8);
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
  }

  .ladder-body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .ladder-narrative {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--ink-light, #242c33);
    margin: 0;
  }

  .ladder-specs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.75rem;
    background: var(--paper, #fffaf0);
    border: 1.5px solid var(--line, #eee4c8);
    border-radius: 10px;
    padding: 0.85rem 1rem;
  }

  .ladder-spec-card {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .lsc-label {
    font-size: 0.7rem;
    font-weight: 800;
    font-family: var(--md-code-font, monospace);
    color: rgba(21, 27, 32, 0.6);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .lsc-val {
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--ink, #151b20);
    line-height: 1.4;
  }

  .lsc-val code {
    background: var(--cream, #fffaf0);
    border: 1px solid var(--ink, #151b20);
    border-radius: 4px;
    padding: 0.1rem 0.35rem;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .ladder-insight-box {
    background: #ffffff;
    border: 1.5px solid var(--ink, #151b20);
    border-radius: 8px;
    padding: 0.75rem 1rem;
    box-shadow: 2px 2px 0px var(--ink, #151b20);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.86rem;
    line-height: 1.5;
  }

  .lib-row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .lib-tag {
    font-size: 0.72rem;
    font-weight: 900;
    font-family: var(--md-code-font, monospace);
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    border: 1px solid var(--ink, #151b20);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    flex-shrink: 0;
  }

  .lib-tag.bottleneck {
    background: #ffd8ce;
    color: #151b20;
  }

  .lib-tag.remedy {
    background: var(--lime-soft, #e7f4c8);
    color: #151b20;
  }

  .ladder-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1.5px solid var(--line, #eee4c8);
    gap: 1rem;
    flex-wrap: wrap;
  }

  .ladder-tools-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.82rem;
    color: var(--ink-light, #242c33);
    background: var(--paper, #fffaf0);
    border: 1.5px solid var(--line, #eee4c8);
    border-radius: 999px;
    padding: 0.3rem 0.75rem;
    font-weight: 600;
  }

  .ladder-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.88rem;
    font-weight: 800;
    color: var(--ink, #151b20);
    background: var(--yellow, #ffc83e);
    border: 2px solid var(--ink, #151b20);
    border-radius: 999px;
    padding: 0.45rem 1.15rem;
    text-decoration: none;
    box-shadow: 2.5px 2.5px 0px var(--ink, #151b20);
    transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
  }

  .ladder-cta-btn:hover {
    background: #fff0b9;
    transform: translate(-1px, -1px);
    box-shadow: 4px 4px 0px var(--ink, #151b20);
  }

  .ladder-cta-btn:active {
    transform: translate(1px, 1px);
    box-shadow: 1.5px 1.5px 0px var(--ink, #151b20);
  }

  .btn-arrow {
    transition: transform 0.15s ease;
  }

  .ladder-cta-btn:hover .btn-arrow {
    transform: translateX(3px);
  }

  /* Ladder Transition Connector */
  .ladder-connector {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0.9rem 0;
  }

  .connector-line {
    width: 0;
    height: 18px;
    border-left: 2px solid var(--ink, #151b20);
  }

  .connector-pill {
    background: var(--paper-deep, #eee4c8);
    border: 1.5px solid var(--ink, #151b20);
    border-radius: 999px;
    box-shadow: 2.5px 2.5px 0px var(--ink, #151b20);
    padding: 0.4rem 1.15rem;
    font-size: 0.78rem;
    font-weight: 800;
    color: var(--ink, #151b20);
    text-align: center;
    max-width: 92%;
    line-height: 1.4;
  }

  .insights-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
    margin-top: 1.25rem;
  }

  .insight-box {
    background: var(--cream);
    border: 2px solid var(--ink);
    border-radius: 12px;
    box-shadow: 4px 4px 0px var(--ink);
    padding: 1.25rem;
  }

  .insight-box h4 {
    font-size: 1.05rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
    color: var(--ink);
  }

  .insight-box p {
    font-size: 0.88rem;
    line-height: 1.55;
    margin-bottom: 0.75rem;
    color: var(--ink-light);
  }

  .insight-solution {
    font-size: 0.8rem;
    font-weight: 800;
    color: #151b20;
    background: var(--lime-soft);
    border: 1.5px solid var(--ink);
    border-radius: 6px;
    padding: 0.35rem 0.55rem;
  }

  .tools-grid {
    display: grid;
