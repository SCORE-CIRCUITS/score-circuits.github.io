---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "SCORE: Survey & Benchmark Dataset of Open-Source Chip Repositories for EDA & Computer Architecture Research." } = Astro.props;
const base = import.meta.env.BASE_URL;
const pathname = Astro.url.pathname;
const pageTitle = title === "SCORE" || title === "Home" ? "SCORE — Benchmark-Driven Open Architecture Platform" : `${title} · SCORE`;

function isActive(href: string) {
  const norm = href.endsWith("/") ? href : `${href}/`;
  const baseNorm = base.endsWith("/") ? base : `${base}/`;
  if (norm === "/" || norm === baseNorm) {
    return pathname === "/" || pathname === base || pathname === baseNorm || pathname === "";
  }
  return pathname.startsWith(norm);
}
---

<!doctype html>
<html lang="en" data-md-color-scheme="default">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" />
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js" onload="if (window.renderMathInElement) renderMathInElement(document.body, {delimiters: [{left: '$$', right: '$$', display: true}, {left: '$', right: '$', display: false}], throwOnError: false});"></script>
    <link rel="stylesheet" href={`${base}stylesheets/palette.css`} />
    <link rel="stylesheet" href={`${base}stylesheets/main.css`} />
    <link rel="stylesheet" href={`${base}stylesheets/extra.css`} />
    <title>{pageTitle}</title>
    <style>
      /* Layout Refinements aligned with EDA Floorplanning / Dataset Fundamentals */
      .score-header-bar {
        background-color: rgba(246, 240, 220, 0.92) !important;
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-bottom: 2px solid var(--ink, #151b20) !important;
        position: sticky;
        top: 0;
        z-index: 1000;
      }
      .score-header-inner {
        max-width: 1220px;
        margin: 0 auto;
        padding: 0.65rem 1.25rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      }
      .score-brand-group {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        text-decoration: none;
        color: var(--ink, #151b20);
      }
      .score-brand-badge {
        background: var(--yellow, #ffc83e);
        color: var(--ink, #151b20);
        font-family: var(--md-code-font, monospace);
        font-weight: 900;
        font-size: 1.1rem;
        padding: 0.2rem 0.55rem;
        border-radius: 6px;
        border: 2px solid var(--ink, #151b20);
        box-shadow: 2px 2px 0px var(--ink, #151b20);
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
      }
      .score-brand-badge svg {
        width: 18px;
        height: 18px;
        fill: currentColor;
      }
      .score-brand-meta {
        display: flex;
        flex-direction: column;
      }
      .score-brand-name {
        font-weight: 800;
        font-size: 1.05rem;
        letter-spacing: -0.02em;
        line-height: 1.2;
        color: var(--ink, #151b20);
      }
      .score-brand-sub {
        font-size: 0.75rem;
        color: var(--ink-light, #242c33);
        font-weight: 500;
      }
      .score-header-right {
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }

      .score-star-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        background: var(--yellow, #ffc83e);
        color: var(--ink, #151b20) !important;
        border: 2px solid var(--ink, #151b20);
        border-radius: 999px;
        padding: 0.3rem 0.8rem;
        font-size: 0.82rem;
        font-weight: 800;
        text-decoration: none !important;
        box-shadow: 2.5px 2.5px 0px var(--ink, #151b20);
        transition: transform 0.12s ease, box-shadow 0.12s ease, background-color 0.12s ease;
      }
      .score-star-btn:hover {
        background: #ffe066;
        transform: translate(-1px, -1px);
        box-shadow: 3.5px 3.5px 0px var(--ink, #151b20);
      }
      .score-star-btn:active {
        transform: translate(1px, 1px);
        box-shadow: 1.5px 1.5px 0px var(--ink, #151b20);
      }
      .star-icon {
        font-size: 0.95rem;
        line-height: 1;
      }
      .star-text {
        font-weight: 800;
        letter-spacing: -0.01em;
      }
      .star-count {
        background: var(--cream, #fffaf0);
        color: var(--ink, #151b20);
        border: 1.5px solid var(--ink, #151b20);
        border-radius: 999px;
        padding: 0.05rem 0.45rem;
        font-size: 0.75rem;
        font-weight: 800;
        font-family: var(--md-code-font, monospace);
        min-width: 18px;
        text-align: center;
      }

      /* 2-tier Horizontal Navigation Tabs Bar */
      .score-tabs-bar {
        background: var(--cream, #fffaf0);
        border-bottom: 2px solid var(--ink, #151b20);
        overflow-x: auto;
        white-space: nowrap;
        -webkit-overflow-scrolling: touch;
      }
      .score-tabs-inner {
        max-width: 1220px;
        margin: 0 auto;
        padding: 0.55rem 1.25rem;
        display: flex;
        align-items: center;
        gap: 0.6rem;
      }
      .score-tab-item {
        font-family: var(--md-text-font, sans-serif);
        font-weight: 700;
        font-size: 0.98rem;
        color: rgba(21, 27, 32, 0.78);
        text-decoration: none;
        padding: 8px 20px;
        border-radius: 999px;
        transition: all 0.15s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        border: 2px solid transparent;
      }
      .score-tab-item:hover {
        color: var(--ink, #151b20);
        background: rgba(21, 27, 32, 0.08);
      }
      .score-tab-item.active {
        color: var(--ink, #151b20) !important;
        background-color: var(--yellow, #ffc83e) !important;
        border: 2px solid var(--ink, #151b20) !important;
        border-radius: 999px !important;
        font-weight: 800 !important;
        box-shadow: 2px 2px 0px var(--ink, #151b20) !important;
      }

      /* Content Area Container */
      .md-container {
        max-width: 1220px;
        margin: 0 auto;
        padding: 2rem 1.25rem 4rem 1.25rem;
        min-height: 80vh;
      }

      /* Footer */
      .score-footer {
        background: var(--paper-deep, #eee4c8);
        border-top: 2px solid var(--ink, #151b20);
        padding: 2.25rem 1.25rem;
        margin-top: 4rem;
      }
      .score-footer-inner {
        max-width: 1220px;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1.25rem;
        font-size: 0.88rem;
      }

      /* Mobile Responsiveness */
      @media (max-width: 768px) {
        .score-header-inner {
          padding: 0.5rem 0.85rem;
          gap: 0.5rem;
        }
        .score-brand-sub {
          display: none;
        }
        .score-brand-name {
          font-size: 0.95rem;
        }
        .score-brand-badge {
          font-size: 0.95rem;
          padding: 0.15rem 0.45rem;
        }
        .score-star-btn {
          padding: 0.25rem 0.65rem;
          font-size: 0.78rem;
        }
        .score-tabs-inner {
          padding: 0.4rem 0.85rem;
          gap: 0.4rem;
        }
        .score-tab-item {
          padding: 6px 14px;
          font-size: 0.88rem;
        }
        .md-container {
          padding: 1.25rem 0.85rem 3rem 0.85rem;
        }
        .score-footer {
          padding: 1.5rem 0.85rem;
          margin-top: 2.5rem;
        }
        .score-footer-inner {
          flex-direction: column;
          align-items: flex-start;
          gap: 1rem;
        }
      }

      @media (max-width: 480px) {
        .score-header-inner {
          padding: 0.45rem 0.65rem;
        }
        .score-brand-badge svg {
          width: 15px;
          height: 15px;
        }
        .score-brand-name {
          font-size: 0.88rem;
        }
        .star-text {
          display: none;
        }
        .score-star-btn {
          padding: 0.25rem 0.5rem;
          gap: 0.3rem;
        }
        .score-tabs-inner {
          padding: 0.35rem 0.65rem;
        }
        .score-tab-item {
          padding: 5px 11px;
          font-size: 0.82rem;
        }
        .md-container {
          padding: 1rem 0.5rem 2.5rem 0.5rem;
        }
      }
    </style>
  </head>
  <body class="md-typeset">
    <!-- Header Tier 1: Frosted Top Bar -->
    <header class="score-header-bar">
      <div class="score-header-inner">
        <a class="score-brand-group" href={base}>
          <div class="score-brand-badge">
            <svg viewBox="0 0 24 24"><path d="M6 2v2H4a2 2 0 0 0-2 2v2h2v2H2v2h2v2H2v2h2a2 2 0 0 0 2 2v2h2v-2h2v2h2v-2h2v2h2v-2h2a2 2 0 0 0 2-2v-2h2v-2h-2v-2h2v-2h-2V6a2 2 0 0 0-2-2h-2V2h-2v2h-2V2h-2v2H8V2H6m2 4h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2m1 2v8h6V8H9z"/></svg>
            <span>SCORE</span>
          </div>
          <div class="score-brand-meta">
            <span class="score-brand-name">Open Chip Repositories</span>
            <span class="score-brand-sub">Benchmark-Driven SoC Dataset &amp; Survey</span>
          </div>
        </a>

        <div class="score-header-right">
          <a
            href="https://github.com/SCORE-CIRCUITS/score"
            target="_blank"
            rel="noopener noreferrer"
            class="score-star-btn"
            title="Star SCORE on GitHub"
            aria-label="Star SCORE on GitHub"
          >
            <span class="star-icon">⭐</span>
            <span class="star-text">Star</span>
            <span class="star-count" id="github-star-count">2</span>
          </a>
        </div>
      </div>
    </header>

    <!-- Header Tier 2: Horizontal Navigation Tabs Bar -->
    <nav class="score-tabs-bar" aria-label="Primary Navigation">
      <div class="score-tabs-inner">
        <a class={`score-tab-item ${isActive(base) ? 'active' : ''}`} href={base}>Overview</a>
        <a class={`score-tab-item ${isActive(`${base}fundamentals`) ? 'active' : ''}`} href={`${base}fundamentals/`}>Fundamentals</a>
        <a class={`score-tab-item ${isActive(`${base}mcu-scalar`) ? 'active' : ''}`} href={`${base}mcu-scalar/`}>MCU / Scalar Cores</a>
        <a class={`score-tab-item ${isActive(`${base}app-cores`) ? 'active' : ''}`} href={`${base}app-cores/`}>Application Cores</a>
        <a class={`score-tab-item ${isActive(`${base}vector-coprocessors`) ? 'active' : ''}`} href={`${base}vector-coprocessors/`}>Vector &amp; Coprocessors</a>
        <a class={`score-tab-item ${isActive(`${base}soc-multicore`) ? 'active' : ''}`} href={`${base}soc-multicore/`}>SoC &amp; Multi-Core</a>
      </div>
    </nav>

    <!-- Content Shell -->
    <div class="md-container">
      <main class="md-main">
        <div class="md-main__inner md-grid">
          <div class="md-content">
            <article class="md-content__inner md-typeset">
              <slot />
            </article>
          </div>
        </div>
      </main>
    </div>

    <footer class="score-footer">
      <div class="score-footer-inner">
        <div>
          <strong>SCORE (Survey of Open-Source Chip Repositories)</strong> — An open community dataset for reproducible EDA and architecture research.
        </div>
        <div style="display: flex; gap: 1rem; align-items: center;">
          <a href="https://github.com/SCORE-CIRCUITS/score" target="_blank" rel="noopener" style="font-weight: 700; color: var(--ink);">GitHub Repository</a>
          <span>&middot;</span>
          <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener" style="color: var(--ink);">CC BY 4.0 License</a>
        </div>
      </div>
    </footer>

    <script>
      (function fetchStars() {
        const countEl = document.getElementById("github-star-count");
        if (!countEl) return;
        fetch("https://api.github.com/repos/SCORE-CIRCUITS/score")
          .then((res) => (res.ok ? res.json() : null))
          .then((data) => {
            if (data && typeof data.stargazers_count === "number") {
              countEl.textContent = String(data.stargazers_count);
            }
          })
          .catch(() => {});
      })();
    </script>
  </body>
</html>

